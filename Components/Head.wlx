hexColor = (IntegerDigits[
  ToExpression@StringReplace[#, "#" -> "16^^"], 256, If[StringLength[#] > 7, 4, 3]]) &;




Component[Children__, OptionsPattern[]] := With[{
    AccentColor = OptionValue["AccentColor"], 
    theme = Lookup[OptionValue["Settings"], "Theme", Null],
    Title = OptionValue["Title"], Merged = ToStringRiffle[{Children}],
    EditorTintColor = With[{h = hexColor[ OptionValue["AccentColor"] ]}, 
        StringTemplate["rgb(`` `` `` / 5%)"][h[[1]], h[[2]], h[[3]]]
    ],
    AccentColor25 = With[{h = hexColor[ OptionValue["AccentColor"] ]}, 
        StringTemplate["rgb(`` `` `` / 25%)"][h[[1]], h[[2]], h[[3]]]
    ]
},
    With[{
        ThemeScript = If[System`$Env["ElectronCode"] =!= 1, Switch[theme, 
            "Light",
                <script>(()=>{let m="light",x="dark";if(matchMedia(`(prefers-color-scheme:${m})`).matches)return;let d=document.documentElement;d.classList.remove(x);d.classList.add(m);let r=/\(\s*prefers-color-scheme\s*:\s*(dark|light)\s*\)/i;function p(s){let a=[],q=s.cssRules;for(let i=q.length-1;i>=0;i--){let n=q[i];if(n instanceof CSSMediaRule&&r.test(n.conditionText)){let c=n.conditionText.match(r)[1].toLowerCase();if(c===x)s.deleteRule(i);else if(c===m){a.unshift(...[...n.cssRules].map(v=>v.cssText));s.deleteRule(i)}}else"cssRules"in n&&"deleteRule"in n&&p(n)}for(let v of a)try{s.insertRule(v,s.cssRules.length)}catch{}}for(let s of document.styleSheets)try{p(s)}catch{}})();</script>,
            "Dark",
                <script>(()=>{let m="dark",x="light";if(matchMedia(`(prefers-color-scheme:${m})`).matches)return;let d=document.documentElement;d.classList.remove(x);d.classList.add(m);let r=/\(\s*prefers-color-scheme\s*:\s*(dark|light)\s*\)/i;function p(s){let a=[],q=s.cssRules;for(let i=q.length-1;i>=0;i--){let n=q[i];if(n instanceof CSSMediaRule&&r.test(n.conditionText)){let c=n.conditionText.match(r)[1].toLowerCase();if(c===x)s.deleteRule(i);else if(c===m){a.unshift(...[...n.cssRules].map(v=>v.cssText));s.deleteRule(i)}}else"cssRules"in n&&"deleteRule"in n&&p(n)}for(let v of a)try{s.insertRule(v,s.cssRules.length)}catch{}}for(let s of document.styleSheets)try{p(s)}catch{}})();</script>,
            _, ""
        ], ""]        
    },
        <head>
                <title><Title/></title>
                <style>
                    :root{--system-accent-color: <AccentColor/>; --system-accent-color-25:  <AccentColor25/>;  accent-color: <AccentColor/>; --editor-selected-tint:     <EditorTintColor/>;}
                </style>
                <link rel="stylesheet" href="/Styles/Custom.css"/>
                <link rel="stylesheet" href="/Styles/Optimized.css"/> 
                <ThemeScript/>
                <Merged/>
        </head>
    ]
];

Options[Component] = {"Title"->"", "AccentColor" -> "#f67070", "Settings"-><||>};

Component