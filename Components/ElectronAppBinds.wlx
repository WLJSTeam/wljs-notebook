Component[OptionsPattern[]] := With[{Controls = OptionValue["Controls"]},

<script type="module">
    const api = window.electronAPI || window.iframeAPI;
    if (api) {
        api.listener('extension', (ev, pattern) => {
            server.io.fire('<Controls/>', true, pattern);
        });
        api.listener('context', (ev, pattern) => {
            server.io.fire('<Controls/>', true, pattern);
        });     
        api.listener('settings', (ev, pattern) => {
            open('/settings', '_blank');
        });    
        api.listener('newnotebook', () => {
            console.log('note');
            server.io.fire('<Controls/>', true, '_NewNotebook');
        });

        api.listener('print', () => {
            console.log('note');
            server.io.fire('<Controls/>', true, 'PrintPDF');
        });

        api.listener('acknowledgments', () => {
            open('/acknowledgments', '_blank');
        });

        api.listener('checkupdates', (ev) => {
            server.io.fire('<Controls/>', true, 'CheckUpdates');
        });
        

        api.listener('newshortnote', () => {
            server.io.fire('<Controls/>', true, '_NewQuickNotebook');
        });     
    }
</script>
];

Options[Component] = {"Controls"->""};

Component