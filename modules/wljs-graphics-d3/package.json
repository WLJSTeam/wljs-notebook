{
  "name": "wljs-graphics-d3",
  "version": "1.5.7",
  "description": "D3 implementation of Mathematica's Graphics",
  "scripts": {
    "build": "npx rollup --config rollup.config.mjs",
    "watch": "node --max-old-space-size=8192 ./node_modules/.bin/rollup --config rollup.config.mjs -w",
    "restore": "mkdir _temp && cd _temp && git clone --branch base https://github.com/JerryI/wljs-graphics-d3 && mv wljs-graphics-d3/.git ../.git && cd .. && rm -rf _temp"
  },
  "defaultPackage": true,
  "wljs-meta": {
    "js": "dist/kernel.js",
    "minjs": "dist/kernel.min.js",
    "styles": "src/styles.css",
    "kernel": "src/Kernel.wl",
    "deferred": "packages/Canvas2D.wl",
    "category": "Plotting & Graphics",
    "priority": 10,
    "exportable": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JerryI/wljs-graphics-d3"
  },
  "author": "Kirill Vasin",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/JerryI/wljs-graphics-d3/issues"
  },
  "homepage": "https://github.com/JerryI/wljs-graphics-d3#readme",
  "dependencies": {
    "@fantasy-color/lab-to-rgb": "^2.1.0",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "15.0.1",
    "dat.gui": "^0.7.9",
    "earcut": "^3.0.1",
    "rollup": "^3.20.6",
    "rollup-plugin-combine": "^2.1.1",
    "serve-static": "^1.14.1",
    "systemjs": "^6.14.1",
    "twgl-base.js": "^5.5.3"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4"
  }
}
