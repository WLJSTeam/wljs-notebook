%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
.wlx

Component[current_, parent_] := With[{
  UId = CreateUUID[],
  Channel = CreateUUID[]
},

EventHandler[Channel, Function[data,
  With[{audio = ImportString[data, "Base64"]},
    NotebookDelete[current];
    NotebookWrite[NotebookLocationSpecifier[parent, "After"], ExpressionCell[audio, "Output"]];
  ]
]];

<span class="frontend-view sm-controls cursor-default rounded-md 0 py-1 px-2 bg-gray-50 text-left text-gray-500 wljs-card text-xs">
  <button id="{UId}-btn" style="background: #ffb6b6;outline: #ffb6b6;outline-offset: 2px;outline-width: 1px;outline-style: solid;margin: auto;margin-right: 0.2rem;" class="w-3 h-3 mr-1 rounded-full"></button>
  <svg id="{UId}-icon" class="hidden w-4 h-4 inline-block mt-auto mb-auto ml-1 mr-1" viewBox="0 4 24 24" fill="none">
     <style>
    .g-stripe {
      transform-origin: bottom center;
      animation: growShrink 1s infinite;
    }
    /* Stagger the animation for each stripe */
    .g-stripe:nth-child(1) {
      animation-delay: 0s;
    }
    .g-stripe:nth-child(2) {
      animation-delay: 0.2s;
    }
    .g-stripe:nth-child(3) {
      animation-delay: 0.4s;
    }
    .g-stripe:nth-child(4) {
      animation-delay: 0.6s;
    }
    .g-stripe:nth-child(5) {
      animation-delay: 0.8s;
    }
    .g-stripe:nth-child(6) {
      animation-delay: 1s;
    }
    .g-stripe:nth-child(7) {
      animation-delay: 1.2s;
    }
    @keyframes growShrink {
      0%, 100% {
        transform: scaleY(1);
      }
      50% {
        transform: scaleY(0);
      }
    }
  </style>

  <!-- First stripe -->
  <path class="g-stripe" d="M3 11 V13" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Second stripe -->
  <path class="g-stripe" d="M6 10 V14" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Third stripe -->
  <path class="g-stripe" d="M9 11 V13" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Fourth stripe -->
  <path class="g-stripe" d="M12 9 V15" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Fifth stripe -->
  <path class="g-stripe" d="M15 6 V18" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Sixth stripe -->
  <path class="g-stripe" d="M18 10 V14" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Seventh stripe -->
  <path class="g-stripe" d="M21 11 V13" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"/>
     </svg><span id="{UId}-text" class="leading-normal pl-1">Click to record</span>

  <script type="module">
    const btn = document.getElementById('<UId/>-btn');
    const text = document.getElementById('<UId/>-text');
    const icon = document.getElementById('<UId/>-icon');

    const channel = "<Channel/>";

    let recording = false;
    let interval = false;
    let mediaRecorder;

    btn.addEventListener('click', () => {
      if (recording) {
        clearInterval(interval);
        btn.remove();
        icon.remove();
        mediaRecorder.stop();
        return;
      }
      
      recording = true;
      
navigator.mediaDevices.getUserMedia({ audio: true })
  .then(stream => {
    mediaRecorder = new MediaRecorder(stream);
    let chunks = [];

    mediaRecorder.ondataavailable = event => {
      chunks.push(event.data);
    };

    mediaRecorder.onstop = () => {
      const audioBlob = new Blob(chunks, { 'type' : 'audio/ogg; codecs=opus' });
      const reader = new FileReader();
      

      reader.onloadend = () => {
        console.log(interval);
        text.innerText = "Piping data...";
        
        const base64data = reader.result.split(',')[1];
        server.kernel.emitt(channel, '"'+base64data+'"');
      };

      reader.readAsDataURL(audioBlob);
    };

    mediaRecorder.start();
    btn.classList.remove('rounded-full');
    text.innerText = "0 sec";
    icon.classList.remove('hidden');
    
    let time = 0.0;

    interval = setInterval(() => {
      time += 0.1;
      text.innerText = time.toFixed(1) + " sec";
    }, 100);
  })
  .catch(error => {
    console.error('Error accessing microphone:', error);
    alert('Error accessing microphone (Are you using a secured connection?)');
    btn.remove();
    icon.remove();
    text.innerText = "Error accessing microphone";
    clearInterval(interval);
  });
      
    });
  </script>

</span>

];

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{cell, f = NotebookFocusedCell[]},
  cell = NotebookWrite[NotebookLocationSpecifier[f, "After"], Cell[Component[cell, f], "Output", "WLX"]];
];

