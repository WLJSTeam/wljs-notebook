%-------------------------------%Notebook%--------------------------------%
HaveToSaveAs: false
ObjectFields:
  - Objects
  - Symbols
  - Storage
  - ExcalidrawImages
  - RuntimeCache
  - ZIPArchive
%-------------------------------------------------------------------------%


%---------------------------------%Cells%---------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
# Cells batch operations
Performs batch operations after the focused cell:
- add N cells
- remove N cells

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
# Cells batch operations
Performs batch operations after the focused cell:
- add N cells
- remove N cells

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
__Source code__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
__Source code__

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
focused = NotebookFocusedCell[]; (*sync operation *)
nb = EvaluationNotebook[];
cells = Cells[]; (*sync operation *)

AsyncFunction[Null, Module[{dialog, count},
  dialog = ChoiceDialogAsync["Starting after the focused cell", {"Insert"->"Insert","Delete"->"Delete","Cancel"->Null}, "Notebook"->nb] // Await;

  If[dialog === Null, ClearAll[dialog, count]; Return[Null]];

  count = InputAsync["How many?", 1] // Await;

  If[!TrueQ[count > 0 && count < 99999], ClearAll[dialog, count]; Return[Null]];

 Switch[dialog,
  "Insert",
    NotebookWrite[
      NotebookLocationSpecifier[focused, "After"], 
      CellGroup@Table[Cell["", "Input"], {i, count}]
    ],
  
  "Delete",
    NotebookDelete /@ Reverse[Drop[First@SequenceCases[cells, {focused, Repeated[_, {0,count}]}], 1]],
  
  _,
    Null;
 ]//Quiet;

 ClearAll[dialog, count];
  
]][]~Then~Beep;

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
__icon__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
__icon__

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
icon.wlx
Component[OptionsPattern[]] := With[{Title = OptionValue["Title"], Kbd = OptionValue["Shortcut"], UTag = OptionValue["Tag"], Btn = OptionValue["Button"]},
    <li tabindex="-1" tag="{UTag}" class="nooline rounded-sm group flex cursor-default select-none items-center rounded-md px-2 py-1 focus:bg-sys-25">
              <svg class="h-5 w-5 flex-none text-gray-900  dark:text-gray-400 text-opacity-40" fill="currentColor" viewBox="0 0 1024 1024"><path d="M160 128h704c35.3 0 64 28.7 64 64v640c0 35.3-28.7 64-64 64H160c-35.3 0-64-28.7-64-64V192c0-35.3 28.7-64 64-64zm0 72v128h704V200H160zm0 200v168h208V400H160zm280 0v168h144V400H440zm216 0v168h208V400H656zM160 640v192h208V640H160zm280 0v192h144V640H440zm216 0v192h208V640H656z" fill="currentColor"></path></svg> 
              <span class="ml-3 flex-auto truncate"><Title/></span><span class="ml-3 flex-none text-xs font-semibold text-gray-500">
                <kbd class="font-sans"><Kbd/></kbd>
                <button class="p-0.5 rounded hover:bg-gray-100 dark:hover:bg-gray-200" btag="{Btn}">
                       <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2.75C6.89137 2.75 2.75 6.89137 2.75 12C2.75 17.1086 6.89137 21.25 12 21.25C17.1086 21.25 21.25 17.1086 21.25 12C21.25 6.89137 17.1086 2.75 12 2.75ZM1.25 12C1.25 6.06294 6.06294 1.25 12 1.25C17.9371 1.25 22.75 6.06294 22.75 12C22.75 17.9371 17.9371 22.75 12 22.75C6.06294 22.75 1.25 17.9371 1.25 12ZM12 7.75C11.3787 7.75 10.875 8.25368 10.875 8.875C10.875 9.28921 10.5392 9.625 10.125 9.625C9.71079 9.625 9.375 9.28921 9.375 8.875C9.375 7.42525 10.5503 6.25 12 6.25C13.4497 6.25 14.625 7.42525 14.625 8.875C14.625 9.83834 14.1056 10.6796 13.3353 11.1354C13.1385 11.2518 12.9761 11.3789 12.8703 11.5036C12.7675 11.6246 12.75 11.7036 12.75 11.75V13C12.75 13.4142 12.4142 13.75 12 13.75C11.5858 13.75 11.25 13.4142 11.25 13V11.75C11.25 11.2441 11.4715 10.8336 11.7266 10.533C11.9786 10.236 12.2929 10.0092 12.5715 9.84439C12.9044 9.64739 13.125 9.28655 13.125 8.875C13.125 8.25368 12.6213 7.75 12 7.75ZM12 17C12.5523 17 13 16.5523 13 16C13 15.4477 12.5523 15 12 15C11.4477 15 11 15.4477 11 16C11 16.5523 11.4477 17 12 17Z" fill="currentColor"/>
                  </svg>         
                </button>
              </span>
    </li>    
];

Options[Component] = {"Title"->"Example", "Shortcut"->"", "Tag"->"generic", "Button"->Null};

Component

