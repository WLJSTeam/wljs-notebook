              <svg class="h-5 w-5 flex-none text-gray-900  dark:text-gray-400 text-opacity-40" fill="currentColor" viewBox="0 0 1024 1024"><path d="M 786 112 V 235 M 709 171 H 861 Z" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" fill="none"></path><path d="M 899.1 869.6 l -53 -305.6 H 864 c 14.4 0 26 -11.6 26 -26 V 346 c 0 -14.4 -11.6 -26 -26 -26 H 618 V 138 c 0 -14.4 -11.6 -26 -26 -26 H 432 c -14.4 0 -26 11.6 -26 26 v 182 H 160 c -14.4 0 -26 11.6 -26 26 v 192 c 0 14.4 11.6 26 26 26 h 17.9 l -53 305.6 c -0.3 1.5 -0.4 3 -0.4 4.4 c 0 14.4 11.6 26 26 26 h 723 c 1.5 0 3 -0.1 4.4 -0.4 c 14.2 -2.4 23.7 -15.9 21.2 -30 z M 204 390 h 272 V 182 h 72 v 208 h 272 v 104 H 204 V 390 z m 468 440 V 674 c 0 -4.4 -3.6 -8 -8 -8 h -48 c -4.4 0 -8 3.6 -8 8 v 156 H 416 V 674 c 0 -4.4 -3.6 -8 -8 -8 h -48 c -4.4 0 -8 3.6 -8 8 v 156 H 202.8 l 45.1 -260 H 776 l 45.1 260 H 672 Z M 786 112 V 235 M 709 171 H 861" fill="currentColor"></path></svg> 
              <span class="ml-3 flex-auto truncate"><Title/></span><span class="ml-3 flex-none text-xs font-semibold text-gray-500">
