__Source code__

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
Needs["CodeFormatter`"];
Needs["CodeParser`"];
Needs["CoffeeLiqueur`Extensions`CommandPalette`VFX`"->"vfx`", "VFX.wl"]

CodeParser`SplitAllExpression[astr_] := With[{str = StringReplace[astr, {"$Pi$"->"\[Pi]"}]},
  Select[Select[(StringTake[str, Partition[Join[{1}, #, {StringLength[str]}], 2]] &@
   Flatten[{#1 - 1, #2 + 1} & @@@ 
     Sort@
      Cases[
       CodeParser`CodeConcreteParse[str, 
         CodeParser`SourceConvention -> "SourceCharacterIndex"][[2]], 
       LeafNode[Token`Newline, _, a_] :> Lookup[a, Source, Nothing]]]), StringQ], (StringLength[#]>0) &]
];

CodeFormatter`$DefaultLineWidth = 120;
SetOptions[CodeFormatter`CodeFormatCST, CodeFormatter`Airiness -> -0.75, CodeFormatter`BreakLinesMethod -> "LineBreakerV2"];

CodeFormatter`balancedBracesQ[str_String] := StringCount[str, "[*)"] === StringCount[str, "(*]"]

CodeFormatter`testQuestionMarks[s_String] := StringMatchQ[StringTrim[s], StartOfString~~("?" | "??")~~__]
CodeFormatter`testQuestionMarks[_] := False

CodeFormatter`CheckAllSyntax[_?CodeFormatter`testQuestionMarks] := True

CodeFormatter`CheckAllSyntax[str_String] := 
    Module[{syntaxErrors = Cases[CodeParser`CodeParse[str],(ErrorNode|AbstractSyntaxErrorNode|UnterminatedGroupNode|UnterminatedCallNode)[___],Infinity]},
        If[Length[syntaxErrors]=!=0 ,
            

            Return[StringRiffle[
                TemplateApply["Syntax error `` at line `` column ``",
                    {ToString[#1],Sequence@@#3[CodeParser`Source][[1]]}
                ]&@@@syntaxErrors

            , "\n"], Module];
        ];
        Return[True, Module];
    ];

CodeFormatter`beaufity[expr_] := StringReplace[ToString[HoldForm[expr] /. {
  Graphics -> CodeFormatter`escape`Graphics,
  Graphics3D -> CodeFormatter`escape`Graphics3D,
  Image -> CodeFormatter`escape`Image,
  Image3D -> CodeFormatter`escape`Image3D
  Dataset -> CodeFormatter`escape`Dataset,
  Sound -> CodeFormatter`escape`Sound,
  Audio -> CodeFormatter`escape`Audio,
  Video -> CodeFormatter`escape`Video
}, StandardForm], {
  "CodeFormatter`escape`Graphics" -> "Graphics",
  "CodeFormatter`escape`Graphics3D" -> "Graphics3D",
  "CodeFormatter`escape`Image" -> "Image",
  "CodeFormatter`escape`Image3D" -> "Image3D"
  "CodeFormatter`escape`Dataset" -> "Dataset",
  "CodeFormatter`escape`Audio" -> "Audio",
  "CodeFormatter`escape`Sound" -> "Sound",
  "CodeFormatter`escape`Video" -> "Video"
}];

SetAttributes[CodeFormatter`beaufity, Listable]
SetAttributes[CodeFormatter`beaufity, HoldAll]
SetAttributes[CodeFormatter`beaufity, HoldAllComplete]

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%


%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%


%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%


%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{string, inline, rules},
  If[FrontFetch[FrontEditorSelected["Type"]] =!= "mathematica", 
    EchoLabel["Warning"]["Only formatting of Wolfram Language is supported"];
    Return[Null, Module];
  ];
  
  inline = !MatchQ[FrontFetch[FrontEditorSelected["Cursor"]], {a_, a_}];
  
  string = If[inline,
    FrontFetch[FrontEditorSelected["Get"]]
  ,
    FrontFetch[FrontEditorSelected["GetDoc"]]
  ];

  If[!TrueQ[CodeFormatter`CheckAllSyntax[string]],
    EchoLabel["Warning"]["Syntax error! Cannot parse"];
    Return[Null, Module];
  ];

  string = Check[StringRiffle[With[{res = ToExpression[#, InputForm, CodeFormatter`beaufity]}, 
    If[res === "Null",
      #
    ,
      res
    ]
  
  ] &/@ Flatten[{CodeParser`SplitAllExpression[string]}], "\n"], $Failed];

  If[FailureQ[string],
    EchoLabel["Warning"]["Could not parse. Please use Format Snippet"];
    Return[Null, Module];  
  ];
  
  {string, rules} = Module[{index = 0}, With[{r = StringCases[
    string
    , 
    d:Shortest[
        "(*" ~~ (c: WordCharacter..) ~~ "[*)" ~~ (arg1__ /; CodeFormatter`balancedBracesQ[arg1]) ~~ "(*]" ~~ (c: WordCharacter..) ~~ "*)"
    ] :> (d -> (index++; StringTemplate["$UC[``]"][index]))
]},
  {StringReplace[string, r], r}
]] // Quiet;

string = CodeFormat[string];

string = StringReplace[string, Map[(Rule[#[[2]], #[[1]]])&, rules]];

  
  If[inline,
    FrontSubmit[FrontEditorSelected["Set", string]]
  ,
    FrontSubmit[FrontEditorSelected["SetDoc", string]]
  ];

  FrontSubmit[vfx`MagicWand["body"]];
]

