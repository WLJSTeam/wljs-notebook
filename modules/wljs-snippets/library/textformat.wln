.wlx

FormattingToolbar`Button[Child_, OptionsPattern[]] := With[{
  UId = CreateUUID[],
  Event = OptionValue["Event"],
  Pattern = OptionValue["Pattern"]
},
  {
    <button id="{UId}" class="hover:bg-gray-100 p-1 rounded">
      <Child/>
    </button>
  ,
    <script type="module">
      const uid = '<UId/>';
      document.getElementById(uid).addEventListener('click', () => {
        server.kernel.emitt('<Event/>', 'True', '<Pattern/>');
      })
    </script>
  }
]

Options[FormattingToolbar`Button] = {"Event"->"", "Pattern"->""};

FormattingToolbar`ColorSelector[Child_, OptionsPattern[]] := With[{
  UId = CreateUUID[],
  Event = OptionValue["Event"],
  Pattern = OptionValue["Pattern"]
},
  {
<div class="relative">
    <button id="{UId}" class="hover:bg-gray-100 p-1 rounded">
      <Child/>
    </button>
  <div id="{UId}-picker" class="absolute left-0 z-10 mt-2 origin-top-right backdrop-blur rounded-md ring-1 ring-black ring-opacity-5 focus:outline-none hidden" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1">
    <div class="flex gap-x-2 gap-2 p-2" role="none">
      <button class="w-5 h-5 rounded" style="background: #FA8072"></button>
      <button class="w-5 h-5 rounded" style="background: #FFE787"></button>
      <button class="w-5 h-5 rounded" style="background: #6CCFF6"></button>
      <button class="w-5 h-5 rounded" style="background: #6ffc8e"></button>
      <button class="w-5 h-5 rounded" style="background: #ffe4fb"></button>
    </div>
  </div>
 </div> 
  ,
    <script type="module">
      const uid = '<UId/>';
      const picker = document.getElementById(uid + '-picker');
      let state = false;

      function RGBToHex(rgb) {
  // Choose correct separator
  let sep = rgb.indexOf(",") > -1 ? "," : " ";
  // Turn "rgb(r,g,b)" into [r,g,b]
  rgb = rgb.substr(4).split(")")[0].split(sep);

  let r = (+rgb[0]).toString(16),
      g = (+rgb[1]).toString(16),
      b = (+rgb[2]).toString(16);

  if (r.length == 1)
    r = "0" + r;
  if (g.length == 1)
    g = "0" + g;
  if (b.length == 1)
    b = "0" + b;

  return "#" + r + g + b;
}

      let close;
      
      close = () => {
        if (!state) return;
        state = false;
        picker.classList.add('hidden');
        window.removeEventListener('click', close);
      }
      
      const list = picker.getElementsByTagName('button');
      for (let i=0; i<list.length; ++i) {
        const el = list[i];
        const color = el.style.background;
        el.addEventListener('click', () => {
          server.kernel.emitt('<Event/>', '"' + RGBToHex(color) + '"', '<Pattern/>');
          close();
        })
      }
      
      document.getElementById(uid).addEventListener('click', () => {
        console.log('clicked');
        
        picker.classList.remove('hidden');
        console.log(picker.classList);
        state = true; 
        setTimeout(() => window.addEventListener('click', close), 30);
      })
    </script>
  }
]

Options[FormattingToolbar`ColorSelector] = {"Event"->"", "Pattern"->""};

FormattingToolbar`makeFormattedString[x_String, style__] := StringJoin[{"(*BB[*)(", x, ")(*,*)(*", ToString[Compress[ProvidedOptions[Hold[StringBox[style] ], "String"->True ] ], InputForm], "*)(*]BB*)"}];
FormattingToolbar`makeFormattedWL[x_String, style__] := StringJoin[{"(*BB[*)(", x, ")(*,*)(*", ToString[Compress[Hold[StyleBox[style]]], InputForm], "*)(*]BB*)"}];

FormattingToolbar`format["Wolfram", style_, _, piece_String, win_] := With[{
  s = StringTrim[piece]
},
  With[{result = If[StringTake[s, 1] === "\"",
    FormattingToolbar`makeFormattedString[s, ToExpression[style]]
  ,
    FormattingToolbar`makeFormattedWL[s, ToExpression[style]]
  ]},
    FrontSubmit[FrontEditorSelected["Set", result], "Window"->win]
  ]
]

FormattingToolbar`format["Wolfram", "H1", _, piece_String, win_] := With[{
  s = StringTrim[piece]
},
  With[{result = If[StringTake[s, 1] === "\"",
    FormattingToolbar`makeFormattedString[s, 24, Bold]
  ,
    FormattingToolbar`makeFormattedWL[s, 24, Bold]
  ]},
    FrontSubmit[FrontEditorSelected["Set", result], "Window"->win]
  ]
]

FormattingToolbar`format["Wolfram", "H2", _, piece_String, win_] := With[{
  s = StringTrim[piece]
},
  With[{result = If[StringTake[s, 1] === "\"",
    FormattingToolbar`makeFormattedString[s, 18, Bold]
  ,
    FormattingToolbar`makeFormattedWL[s, 18, Bold]
  ]},
    FrontSubmit[FrontEditorSelected["Set", result], "Window"->win]
  ]
]

FormattingToolbar`format["Wolfram", "H3", _, piece_String, win_] := With[{
  s = StringTrim[piece]
},
  With[{result = If[StringTake[s, 1] === "\"",
    FormattingToolbar`makeFormattedString[s, 16]
  ,
    FormattingToolbar`makeFormattedWL[s, 16]
  ]},
    FrontSubmit[FrontEditorSelected["Set", result], "Window"->win]
  ]
]

FormattingToolbar`hexToRGB = RGBColor @@ (IntegerDigits[# ~StringDrop~ 1 ~FromDigits~ 16, 256, 3]/255.) &;

FormattingToolbar`format["Wolfram", "Color", color_, piece_String, win_] := With[{
  s = StringTrim[piece]
},
  With[{result = If[StringTake[s, 1] === "\"",
    FormattingToolbar`makeFormattedString[s, FormattingToolbar`hexToRGB[StringTrim[color]]]
  ,
    FormattingToolbar`makeFormattedWL[s, FormattingToolbar`hexToRGB[StringTrim[color]]]
  ]},
  
    FrontSubmit[FrontEditorSelected["Set", result], "Window"->win]
  ]
]

FormattingToolbar`format["Wolfram", "Bg", color_, piece_String, win_] := With[{
  s = StringTrim[piece]
},
  With[{result = If[StringTake[s, 1] === "\"",
    FormattingToolbar`makeFormattedString[s, Background->FormattingToolbar`hexToRGB[StringTrim[color]]]
  ,
    FormattingToolbar`makeFormattedWL[s, Background->FormattingToolbar`hexToRGB[StringTrim[color]]]
  ]},
    FrontSubmit[FrontEditorSelected["Set", result], "Window"->win]
  ]
]

FormattingToolbar`dummy := <div></div>

