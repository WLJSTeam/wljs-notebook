%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
outputQ[c_] := c[[2]] === "Output";

lastAfterFocused = With[{
  focused = NotebookFocusedCell[]
},
{
  rawCells = SequenceCases[Cells[], {focused, Repeated[_, 4]}][[1]]
},
{
  cells = NotebookRead[rawCells]}, 
  rawCells[[Position[cells, SequenceCases[cells, {cells[[1]], ___?outputQ}][[1]][[-1]]][[1,1]]]]
] // Quiet;

If[Head[lastAfterFocused] =!= RemoteCellObj, 
  lastAfterFocused = Cells[] // Last;
];

Module[{self, f = lastAfterFocused},
  self = NotebookWrite[NotebookLocationSpecifier[f, "After"], Cell[" ", "Input", CellOpen->False]];
  NotebookWrite[NotebookLocationSpecifier[self, "After"], Cell[widget[self], "Output", "WLX"]];
];

