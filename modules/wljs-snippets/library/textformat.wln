%-------------------------------------------------------------------------%
FormattingToolbar`format["Markdown", "Bold", _, piece_String, win_] := With[{
  s = StringJoin["__", piece, "__"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["Markdown", "Italic", _, piece_String, win_] := With[{
  s = StringJoin["*", piece, "*"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
] 

FormattingToolbar`format["Markdown", "H1", _, piece_String, win_] := With[{
  s = StringJoin["# ", piece, ""]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["Markdown", "H2", _, piece_String, win_] := With[{
  s = StringJoin["## ", piece, ""]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["Markdown", "H3", _, piece_String, win_] := With[{
  s = StringJoin["### ", piece, ""]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["Markdown", "Color", color_String, piece_String, win_] := With[{
  s = StringJoin["<span style=\"color:", color, "\">", piece, "</span>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["Markdown", "Bg", color_String, piece_String, win_] := With[{
  s = StringJoin["<span style=\"background:", color, "\">", piece, "</span>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]







FormattingToolbar`format["HTML", "Bold", _, piece_String, win_] := With[{
  s = StringJoin["<b>", piece, "</b>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]


FormattingToolbar`format["HTML", "Italic", _, piece_String, win_] := With[{
  s = StringJoin["<i>", piece, "</i>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
] 

FormattingToolbar`format["HTML", "H1", _, piece_String, win_] := With[{
  s = StringJoin["<h1 class=\"text-3xl font-bold\">", piece, "</h1>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["HTML", "H2", _, piece_String, win_] := With[{
  s = StringJoin["<h2 class=\"text-2xl font-semibold\">", piece, "</h2>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["HTML", "H3", _, piece_String, win_] := With[{
  s = StringJoin["<h3 class=\"text-1xl font-medium\">", piece, "</h3>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]


FormattingToolbar`format["HTML", "Color", color_String, piece_String, win_] := With[{
  s = StringJoin["<div style=\"color:", color, "\">", piece, "</div>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]

FormattingToolbar`format["HTML", "Bg", color_String, piece_String, win_] := With[{
  s = StringJoin["<div style=\"background:", color, "\">", piece, "</div>"]
},
  FrontSubmit[FrontEditorSelected["Set", s], "Window"->win]
]



FormattingToolbar`apply[style_, data_, window_] := Then[FrontFetchAsync[{FrontEditorSelected["GetDoc"], FrontEditorSelected["Cursor"]}, "Window" -> window], Function[result,
  With[{
    text   = result[[1]],
    cursor = result[[2]]
  },
    If[cursor[[1]] === cursor[[2]], Notify["Nothing is selected", "Topic"->"Warning"]; Return[]];
    Which[
      StringMatchQ[text, ".md"~~"
"~~___],
      FormattingToolbar`format["Markdown", style, data, StringTake[text, cursor + {1,0}], window],
      
      StringMatchQ[text, ".html"~~"
"~~___],
      FormattingToolbar`format["HTML", style, data, StringTake[text, cursor + {1,0}], window],
      
      StringMatchQ[text, ".wlx"~~"
"~~___],
      FormattingToolbar`format["HTML", style, data, StringTake[text, cursor + {1,0}], window],
      
      StringMatchQ[text, ".slide"~~"
"~~___],
      FormattingToolbar`format["Markdown", style, data, StringTake[text, cursor + {1,0}], window],
      
      StringMatchQ[text, ".slides"~~"
"~~___],
      FormattingToolbar`format["Markdown", style, data, StringTake[text, cursor + {1,0}], window],

      StringMatchQ[text, ".wl"~~"
"~~___],
      FormattingToolbar`format["Wolfram", style, data, StringTake[text, cursor + {1,0}], window],

      StringMatchQ[text, "."~~WordCharacter..~~"
"~~___],
      Notify["Unknown cell type", "Topic"->"Warning"],

      True,
      FormattingToolbar`format["Wolfram", style, data, StringTake[text, cursor + {1,0}], window]
    ];
  ]
]]

