.wlx

widget[self_] := With[{
  FormattingToolbarButton = FormattingToolbar`Button, 
  FormattingToolbarColorSelector = FormattingToolbar`ColorSelector,
  act = CreateUUID[],
  parent = self,
  win = CurrentWindow[]
},

EventHandler[win, {"Closed" -> Function[Null,
  Delete[parent];
]}];

EventHandler[act, {
  "Close" -> Function[Null,
    Delete[parent]
  ],

  s_String :> Function[data, FormattingToolbar`apply[s, data, win]]
}];

