Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
.wlx
createCanvas[self_, parent_] := With[{CanvasUId = CreateUUID[], win = CurrentWindow[]},

EventHandler[win, {"Closed" -> Function[Null,
  FrontSubmit[jswebcam`cam["Stop", CanvasUId], "Window" -> win];
  NotebookDelete[self];
]}];

EventHandler[CanvasUId, {
  "Capture" -> Function[Null,
    Then[FrontFetchAsync[jswebcam`cam["Capture", CanvasUId], "Format"->"JSON", "Window" -> win],
      Function[raw,
        With[{img = Partition[Take[#, 3]&/@ Partition[raw, 4], 320] // NumericArray // Image},
          NotebookWrite[NotebookLocationSpecifier[parent, "After"], ExpressionCell[img, "Input"]];
          FrontSubmit[jswebcam`cam["Stop", CanvasUId], "Window" -> win];
          NotebookDelete[self];
        ]
      ]
    ]
  ],

  "Cancel" -> Function[Null,
    FrontSubmit[jswebcam`cam["Stop", CanvasUId], "Window" -> win];
    NotebookDelete[self];
  ]
}];

<div class="flex flex-1 flex-row p-2" style="width: fit-content">
      <canvas id="{CanvasUId}" style="display: inline-block" class="rounded"></canvas>
      <dl class="ml-4 flex flex-grow flex-col justify-between">
        <dd class="flex flex-col gap-y-2">
          <button id="{CanvasUId}-capture" class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Capture</button>
          <button id="{CanvasUId}-cancel" class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">Cancel</button>          
        </dd>
      </dl>
<script type="module">
/* =========================
   Constants & DOM references
   ========================= */
const uid = '<CanvasUId/>';
const canvas = document.getElementById(uid);
const ctx = canvas.getContext('2d');

const video = document.createElement('video');
video.playsInline = true;   // iOS safety
video.muted = true;

/* =========================
   State
   ========================= */
const webcam = {
  stream: null,
  video,
  ctx,
  rafId: null
};

canvas.width = 320;
canvas.height = 240;

/* =========================
   Camera setup
   ========================= */
async function startCamera() {
  if (!navigator.mediaDevices?.getUserMedia) {
    alert('getUserMedia is not supported in this browser.');
    return;
  }

  try {
    webcam.stream = await navigator.mediaDevices.getUserMedia({ video: true });
    video.srcObject = webcam.stream;
    await video.play();
    drawLoop();
  } catch (err) {
    console.error(err);
    alert('Error accessing webcam (HTTPS required).');
  }
}

function drawLoop() {
  webcam.rafId = requestAnimationFrame(drawLoop);
  ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
}

/* =========================
   Cleanup
   ========================= */
function stopCamera() {
  if (webcam.rafId) {
    cancelAnimationFrame(webcam.rafId);
    webcam.rafId = null;
  }

  if (webcam.stream) {
    webcam.stream.getTracks().forEach(t => t.stop());
    webcam.stream = null;
  }

  video.srcObject = null;
}

/* =========================
   UI events
   ========================= */
document.getElementById(`${uid}-capture`)
  .addEventListener('click', () =>
    server.kernel.emitt(uid, 'True', 'Capture')
  );

document.getElementById(`${uid}-cancel`)
  .addEventListener('click', () =>
    server.kernel.emitt(uid, 'True', 'Cancel')
  );

/* =========================
   Kernel bridge
   ========================= */
core['jswebcam`cam'] ??= async (args, env) => {
  const op = await interpretate(args[0], env);
  return core['jswebcam`cam'][op](args.slice(1), env);
};

core['jswebcam`cam'].cached ??= {};
core['jswebcam`cam'].cached[uid] = webcam;

core['jswebcam`cam'].Stop = async (args, env) => {
  stopCamera();
};

core['jswebcam`cam'].Capture = async () => {
  return Array.from(
    ctx.getImageData(0, 0, canvas.width, canvas.height).data
  );
};

/* =========================
   Init
   ========================= */
startCamera();
</script>

    </div>
]

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
With[{cell = Unique[], parent = Unique[]}, 
  parent = NotebookFocusedCell[];
  
  cell = NotebookWrite[NotebookLocationSpecifier[parent, "After"], Cell[createCanvas[cell, parent], "Output", "WLX"]];
];

