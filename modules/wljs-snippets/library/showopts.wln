%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
.wlx
OptionsHelper`Component[name_, o_List,  promise_] := Module[{array = {}, garbage = {}}, With[{
  ListUID = CreateUUID[], ButtonSubmit = CreateUUID[], ButtonCancel = CreateUUID[],
  Usage   = Information[name, "Usage"],
  Title = name,
  ListOpts = Table[ With[{e = CreateUUID[], item = o[[i]], j=i, type = Head[o[[i]]] === Rule},

    AppendTo[array, StringJoin[ToString[item[[1]], InputForm], If[type, "->", ":>"], ToString[Extract[item, 2, HoldForm], StandardForm]]];
    EventHandler[e, Function[data, array[[j]] = StringJoin[ToString[item[[1]], InputForm], If[type, "->", ":>"], data] ]];

    AppendTo[garbage, e];

    With[{
        Label = item[[1]],
        Field = EditorView[ToString[Extract[item, 2, HoldForm], StandardForm], "Event"->e] // CreateFrontEndObject
    },
                  <div class="py-2 px-2 my-1 columns-2 rounded-md">
                    <dt class="text-sm font-medium leading-6 text-gray-900"><Label/></dt>
                    <dd class="mt-1 text-sm leading-6 text-gray-700 col-span-2 sm:mt-0"><Field/></dd>
                  </div>    
    ]
   ], {i, Length[o]}] 
},

 EventHandler[ListUID, {
  "Cancel" -> Function[Null,
    EventFire[promise, Reject, False];
    Print["Cancelled"];
    EventRemove /@ garbage;
    EventRemove[ListUID];
  ],

  "Submit" -> Function[data,
    EventFire[promise, Resolve, StringRiffle[Select[Transpose[{data, array}], First][[All,2]], ", "]];
    EventRemove /@ garbage;
    EventRemove[ListUID];
  ]
 }];

 <div>
  <div class="px-2">
    <div class="flex flex-row">
      <h3 class="text-base font-semibold leading-7 text-gray-900"><Title/></h3>
      <button id="{ButtonSubmit}" type="button" class="ml-auto relative rounded-md text-green-500 hover:text-green-300  focus:outline-none focus:ring-2 focus:ring-white"><svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><svg fill="currentColor" stroke-width="1.5" class="w-5 h-5" viewBox="0 0 24 24"><path d="M12,21h0a9,9,0,0,1-9-9H3a9,9,0,0,1,9-9h0a9,9,0,0,1,9,9h0A9,9,0,0,1,12,21ZM8,11.5l3,3,5-5" fill="none" stroke="currentColor"></path></svg></svg></button>
      <button id="{ButtonCancel}" type="button" class="ml-4 relative rounded-md text-red-500 hover:text-red-300 focus:outline-none focus:ring-2 focus:ring-white">
              <span class="absolute -inset-2.5"></span>
              <span class="sr-only">Close panel</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
      </button>
    </div>
    <p class="mt-1 text-sm leading-6 text-gray-500"><Usage/></p>
  </div>
  <div class="mt-2 border-t border-gray-100">
    <dl class="divide-y divide-gray-100" id="{ListUID}">
      <ListOpts/>
    </dl>
  </div>
  <script type="module">
    const list = document.getElementById('<ListUID/>');
    const selected = [];
    for (let i=0; i<list.children.length; ++i) {
      const child = list.children[i];
      selected.push(false);
      child.addEventListener('click', (e) => {
        if (e.target.nodeName !== 'DIV') {
          child.classList.toggle('bg-teal-500/15');
          selected[i] = !selected[i];
        } else {
          child.classList.add('bg-teal-500/15');
          selected[i] = true;
        }
      });
    };

    const submit = document.getElementById('<ButtonSubmit/>');
    const cancel = document.getElementById('<ButtonCancel/>');
    submit.addEventListener('click', () => {
      server.kernel.emitt('<ListUID/>', '{'+selected.map((e)=>{
        if (e) return 'True'; else return 'False';
      }).join(',')+'}', 'Submit');
    });
    cancel.addEventListener('click', () => {
      server.kernel.emitt('<ListUID/>', 'False', 'Cancel');
    });
  </script>
 </div>
]];

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
.wlx
makeWidget[self_] := Module[{piece, cursor, editor, cell = self, win = CurrentWindow[], destroy, promise},
  destroy := SetTimeout[Delete[cell], 300];
  
  If[FrontFetch[FrontEditorSelected["Type"]] =!= "mathematica", Notify["Only Wolfram Language is supported", "Topic"->"Warning"]; destroy; Return[Null, Module]];
  
  {cursor, editor} = FrontFetch[{FrontEditorSelected["Cursor"], FrontEditorSelected["Editor"]}];
  
  piece = FrontFetch[FrontEditorSelected["GetDoc"]];

  piece = StringTake[piece, cursor//First] // StringReverse;

  (* remove all string expressions *)
  piece =  StringReplace[piece, "\""~~Except["\""]..~~"\"" -> ""];

  (* collapce matching brackets *)
  While[piece =!= (piece = StringReplace[piece, "]"~~(Except["]"|"["]..| "")~~"[" -> ""]),
    Null;
  ];

  piece = StringCases[piece, (Except["]"|"["]..| "")~~"["~~name:WordCharacter.. :> name, 1];
  If[Length[piece] == 0, Notify["No valid symbol found", "Topic"->"Warning"]; destroy; Return[Null, Module]];
  piece = piece // First // StringReverse;
  
  With[{ opts = ToExpression[piece, InputForm, Options]},
    If[Length[opts] == 0, Notify[StringJoin["No options defined for ", piece], "Topic"->"Warning"]; destroy; Return[Null, Module]];
    
    promise = Promise[];
    Then[promise, Function[data,
      FrontSubmit[ FrontEditorSelected["Set", data, "Editor"->editor], "Window"->win];
      destroy
    ], (destroy)&];
    
    With[{Layout = OptionsHelper`Component[piece, opts, promise]},
      <Identity><Layout/></Identity>
    ]
  ]  
  
]

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{f = NotebookFocusedCell[], v},
  v = NotebookWrite[NotebookLocationSpecifier[f, "After"], Cell[makeWidget[v], "Output", "WLX"]];
];

