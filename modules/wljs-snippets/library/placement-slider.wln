%-------------------------------------------------------------------------%
.wlx
gizmo`SliderComponent;
gizmo`SliderComponent /: MakeBoxes[gizmo`SliderComponent[sym_, object_, EventButton_, viewBoxEvent_], StandardForm] := With[{UId = CreateUUID[]}, Module[{},

  With[{Template = 
<span style="top: -0.25rem" class="sm-controls flex relative cursor-default rounded-md 0 pl-3 py-2 pr-2 text-left text-gray-500  focus:outline-none focus:ring-2 focus:ring-teal-600 sm:text-xs sm:leading-6 bg-gray-100 border-1 border-gray-800">
    <div class="relative flex flex-grow items-stretch" id="{UId}">

    </div>
    <button id="{UId}-button" type="button" class="relative -ml-px inline-flex items-center px-2 text-sm hover:bg-gray-50">
      <svg class="h-5 w-5 text-gray-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <svg fill="currentColor" stroke-width="1.5" class="w-5 h-5" viewBox="0 0 24 24"><path d="M12,21h0a9,9,0,0,1-9-9H3a9,9,0,0,1,9-9h0a9,9,0,0,1,9,9h0A9,9,0,0,1,12,21ZM8,11.5l3,3,5-5" fill="none" stroke="currentColor"></path></svg>
      </svg>
    </button>

    <script type="module">
      const b = document.getElementById('<UId/>-button');

      b.addEventListener('click', () => {
        server.kernel.io.fire('<EventButton/>', true);
      });
    </script>
  </span>
  },
    With[{w = HTMLView[Template, Epilog->{AttachDOM[UId], object}]},
      ViewBox[Offload[sym], w // CreateFrontEndObject, "Event"->viewBoxEvent]
    ]
  ]
] ]

SetAttributes[gizmo`SliderComponent, HoldFirst];

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Logic of a widget

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Logic of a widget

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{init = 1.0, input = FrontFetch[FrontEditorSelected["Get"]], result},
  If[StringLength[input] === 0, Null,
    init = ToExpression[input, InputForm];
    If[!NumericQ[init], EchoLabel["Warning"]["Selected expression must be a number"]; Return[$Failed]];
  ];

  With[{eventButton = CreateUUID[], viewBoxEvent = CreateUUID[], min = 0.4 init, max = 1.6 init},
	LeakyModule[{System`variable = init},

      EventHandler[viewBoxEvent, {"Mounted" -> Function[assoc,
        EventHandler[eventButton, Function[Null,
          FrontSubmit[ViewBox`OuterExpression[ToString[System`variable, InputForm]], FrontInstanceReference[assoc["Instance"]]];
          Notify["Done!", "Topic"->"Gizmo"];
        ]];        
      ]}];
      
        With[{slider = InputRange[min, max, (max-min)/60.0, init]},
          EventHandler[slider, Function[value, System`variable = value]];
          
          With[{wrapper = gizmo`SliderComponent[System`variable, slider[[1]]["View"], eventButton, viewBoxEvent]},
            FrontSubmit[FrontEditorSelected["Set", ToString[wrapper, StandardForm]]];
          ]
        ]
	]
  ];
    
 
];

