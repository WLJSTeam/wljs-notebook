%---------------------------------%Cells%---------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
# Crop Image
Select an image and run this snippet

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
# Crop Image
Select an image and run this snippet

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
__source code__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
__source code__

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{
  img = FrontFetch[FrontEditorSelected["Get"]],
  up, move, down, cursor = {0.5,0.5}, ImageCrop`p2 = {{0,0}, {1,1}},
  selecting = False, crop,
  focused = NotebookFocusedCell[],
  ecell
},

  img = ToExpression[img, InputForm];
  
  If[!MatchQ[img, _Image],
    EchoLabel["Warning"]["Selected is not Image"];
    Return[$Failed, Module];
  ];

  ImageCrop`p2 = {{0,0}, ImageDimensions[img]};

  move = Function[xy,
    cursor = xy;
    If[selecting, ImageCrop`p2 = {ImageCrop`p2[[1]], xy}];
  ];

  down = Function[xy,
    ImageCrop`p2[[1]] = xy;
    selecting = True;
  ];

  up = Function[xy,
    selecting = False;
  ];

  crop = Function[Null,
    With[{},
      NotebookWrite[NotebookLocationSpecifier[ecell, "After"], ExpressionCell[ImageTrim[img, Rectangle @@ ImageCrop`p2], "Input"]];
      SetTimeout[NotebookDelete[ecell], 250];
    ];
    ClearAll[selecting, img, up, down, move, crop];
  ];

  ecell = NotebookWrite[NotebookLocationSpecifier[focused, "After"], Labeled[Graphics[
    {
      Inset[img, ImageDimensions[img]/2.0],
      {
        EdgeForm[Black], LightGreen, Opacity[0.3], Rectangle[Offload[ImageCrop`p2[[1]]], Offload[ImageCrop`p2[[2]]]]
      },

      EventHandler[Null, {
        "mousemove" -> move,
        "mousedown" -> down,
        "mouseup" -> up
      }]
    }, 
    PlotRange->((1.15(# - ImageDimensions[img]/2.0) + ImageDimensions[img]/2.0) &/@ Transpose[{{0,0}, ImageDimensions[img]}]),
    ImageSizeRaw->(1.15 ImageDimensions[img]),
    "Controls"->False, "GUI"->False
  ] 
, EventHandler[InputButton["Crop"], crop]] // Panel];

]

%-------------------------------------------------------------------------%
Props:
