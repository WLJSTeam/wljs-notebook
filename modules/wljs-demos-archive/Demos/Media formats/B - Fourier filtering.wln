%-------------------------------------------------------------------------%
.md
Take masked amplitude and recombine it with phase to get back a normal image

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Take masked amplitude and recombine it with phase to get back a normal image

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
ifourier2d @@ {With[{max = Max[amp]},
  ImageData[masked, "Real32"][[All,All,1]] max 
], phase};

Grid[{
  {preview[donald, Magnification->2], preview[%, Magnification->2]},
  {"Original", "Filtered"}
}]

