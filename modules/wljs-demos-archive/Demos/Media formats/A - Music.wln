%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Construct chords by sampling every third pitch in the list:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Construct chords by sampling every third pitch in the list:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
pitches = MusicScale[(*VB[*) <|"Name" -> "Lydian Augmented"|> (*,*)(*"1:"*)(*]VB*)]["PitchList"];
pitches = 
  Join[pitches, 
   MusicTransform[{"Transpose", 12}] /@ Rest@pitches];

Table[MusicChord@pitches[[{i, i + 2, i + 4, i + 6}]], {i, 4}]//TableForm

