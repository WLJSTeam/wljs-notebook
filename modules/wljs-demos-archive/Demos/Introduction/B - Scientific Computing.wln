  D[u[t, x], t] == D[u[t, x], {x, 2}],
  u[0, x] == Exp[-(*SpB[*)Power[x(*|*),(*|*)2](*]SpB*)],
  u[t, -5] == 0, u[t, 5] == 0
}, u, {t, 0, 1}, {x, -5, 5}];

