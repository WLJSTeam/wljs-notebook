TimeSeries[(*VB[*) TimeEventSeries`TimestampData[<|"UniformlySpacedQ" -> False, "Timestamps" -> TabularColumn[<|"Data" -> {{1, 2, 5, 10, 12, 15}, {}, None}, "ElementType" -> "Integer64"|>], "Caller" -> TimeSeries|>], TabularColumn[<|"Data" -> {{2, 1, 6, 5, 7, 4}, {}, None}, "ElementType" -> "Integer64"|>], <||> (*,*)(*"1:"*)(*]VB*)]

