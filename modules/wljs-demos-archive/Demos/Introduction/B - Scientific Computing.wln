%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
{((*FB[*)((1)(*,*)/(*,*)(2))(*]FB*)) (a+d-(*SqB[*)Sqrt[(*SpB[*)Power[a(*|*),(*|*)2](*]SpB*)+4 b c-2 a d+(*SpB[*)Power[d(*|*),(*|*)2](*]SpB*)](*]SqB*)),((*FB[*)((1)(*,*)/(*,*)(2))(*]FB*)) (a+d+(*SqB[*)Sqrt[(*SpB[*)Power[a(*|*),(*|*)2](*]SpB*)+4 b c-2 a d+(*SpB[*)Power[d(*|*),(*|*)2](*]SpB*)](*]SqB*))}

%-------------------------------------------------------------------------%
