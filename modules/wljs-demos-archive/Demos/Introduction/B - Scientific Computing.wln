## Differential Equations
Solve differential equations symbolically:

> Harmonic Oscillator

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Differential Equations
Solve differential equations symbolically:

> Harmonic Oscillator

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
DSolve[y''[t] + (*SpB[*)Power[\[Omega](*|*),(*|*)2](*]SpB*)*y[t] == 0, y[t], t]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
{{y[t]->(*SbB[*)Subscript[C(*|*),(*|*)1](*]SbB*) Cos[t \[Omega]]+(*SbB[*)Subscript[C(*|*),(*|*)2](*]SbB*) Sin[t \[Omega]]}}

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Numerical solution:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Numerical solution:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Clear["Global`*"];

sol = NDSolve[{
  y''[t] + 0.5*y'[t] + 2*y[t] == 0,
  y[0] == 1, y'[0] == 0
}, y, {t, 0, 20}];

Plot[Evaluate[y[t] /. sol], {t, 0, 20}, PlotLabel -> "Damped Oscillation"]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F91454bf2-c8ce-461c-96f8-a6143ef5e61a"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJWxqamJokpRnpJlskp+qamBkm61qapVnoJpoZmhinppmmmhkmAgCYeRX1"*)(*]VB*)

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
System of ODEs - Lotka-Volterra:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
System of ODEs - Lotka-Volterra:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
lotka = NDSolve[{
  x'[t] == x[t] - x[t]*y[t],
  y'[t] == -y[t] + x[t]*y[t],
  x[0] == 1, y[0] == 0.5
}, {x, y}, {t, 0, 20}];

ParametricPlot[Evaluate[{x[t], y[t]} /. lotka], {t, 0, 20},
AxesLabel -> {"Prey", "Predator"}]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F948a9c6c-2734-4c56-be16-37f4ab96f5a3"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJW5pYJFommyXrGpkbm+iaJJua6SalGprpGpunmSQmWZqlmSYaAwCUyxXK"*)(*]VB*)

