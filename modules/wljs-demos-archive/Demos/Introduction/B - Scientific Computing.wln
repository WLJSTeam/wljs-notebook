%-------------------------------------------------------------------------%
# Scientific Computing
## Data Visualization and Plotting
Create publication-quality plots with minimal effort:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Plot[
  {Sin[x], Cos[x], Sin[x]*Cos[x]}, 
  {x, 0, 2Pi}, 
  PlotLegends -> "Expressions",
  PlotStyle -> {Red, Blue, Green}
]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(Legended[ToExpression[FrontEndRef["F357e5702-c3a2-4ef3-b936-383012edbcd1"], InputForm], Placed[LineLegend[{Directive[Opacity[1.], AbsoluteThickness[2], RGBColor[1, 0, 0]], Directive[Opacity[1.], AbsoluteThickness[2], RGBColor[0, 0, 1]], Directive[Opacity[1.], AbsoluteThickness[2], RGBColor[0, 1, 0]]}, {HoldForm[Sin[HoldForm[x]]], HoldForm[Cos[HoldForm[x]]], HoldForm[Sin[HoldForm[x]]*Cos[HoldForm[x]]]}, LegendMarkers -> None, LabelStyle -> {}, LegendLayout -> "Column"], After, Identity]])(*,*)(*"1:"*)(*]VB*)

