Type: Input
%-------------------------------------------------------------------------%
.md
# 1D Ising model
`8000` spins coupled via superexchange interaction

Evaluate __initialization cells first__!

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
# 1D Ising model
`8000` spins coupled via superexchange interaction

Evaluate __initialization cells first__!

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Energy function and local updates

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Energy function and local updates

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
energy[i_, h_, e_] := {1,-1} h + e {1,-1} (
  If[i < Length[spins], spins[[i+1]], 0] + If[i > 1, spins[[i-1]], 0]
)

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
localUpdate[T_, params__] := With[{i = RandomInteger[{1, Length[spins]}]},
  spins[[i]] = First@RandomChoice[Exp[-energy[i, params]/T] -> {1,-1}, 1];
] 

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
UI elements

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
UI elements

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
running = InputCheckbox[False, "Label"->"Run"];
reset = InputButton["Reset"];
params = InputGroup[<|
  "T"->InputRange[0.1, 2, 0.1, 0.1, "Label"->"Temperature"],
  "H"->InputRange[-0.5,0.5,0.01,0, "Label"->"Field"],
  "J"->InputRange[-1,1,0.5,-1, "Label"->"J"]
|>];

EventHandler[reset, Function[Null,
  mag = {0};
  spins = RandomChoice[{-1,1}, 20 20 20] // N;
  exposed = Take[spins, 20 20];  
]];

reset // EventFire;

EventHandler[params, Function[data,
  defaults = data;
]]; 

params // EventFire;

EventHandler[running, Function[state,
  If[state,
    EventHandler["isingRun", Function[Null,
      Do[localUpdate@@defaults, {i, 10000}];
      exposed = Take[spins, 20 20];
      mag = Append[mag, Mean[spins]];  
    ]];
    EventFire["isingRun", Null];
  ,
    EventRemove["isingRun"];
  ]
]];


%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
