%-------------------------------------------------------------------------%
test = NotebookRead @ NotebookStore["troubling-fd8"];

{
  ListLinePlot[test, PlotRange->Full, PlotLabel->"Time domain"], 
  ListLinePlot[Take[Fourier[test[[All,2]]], 500] // Abs, PlotLabel->"Frequency domain" ]
} // Row 

