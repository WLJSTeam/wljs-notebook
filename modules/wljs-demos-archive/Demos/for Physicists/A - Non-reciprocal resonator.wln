1 - ((*SbB[*)Subscript[r(*|*),(*|*)2](*]SbB*)) ((*SbB[*)Subscript[p(*|*),(*|*)"-"](*]SbB*)) ((*SbB[*)Subscript[r(*|*),(*|*)2](*]SbB*)) ((*SbB[*)Subscript[p(*|*),(*|*)"+"](*]SbB*)) == 0;

