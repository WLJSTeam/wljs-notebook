%---------------------------------%Cells%---------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
# Logitudinal solution to Maxwell's Equations
Considering two interfaces with no free current and charges

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
># Logitudinal solution to Maxwell's Equations
Considering two interfaces with no free current and charges

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
{ex, 0, ez} Exp[I (kx x + kz z) - I ω t]

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
Graphics[{(* Draw two materials *)
  Blue//Lighter//Lighter//Lighter, Rectangle[{-1, 0}, {1, 1}], (* Top material *)
  Green//Lighter//Lighter//Lighter, Rectangle[{-1, -1}, {1, 0}], (* Bottom material *)
  (* Draw electric field vectors *)
  Red, Arrow[{{0, 0}, {0, 0.5}}], (* E_z *)
  Red, Arrow[{{0, 0}, {0.5, 0}}], (* E_x *)
  Text[Style["Ez", FontSize->14, Bold], {0.1, 0.25}],
  Text[Style["Ex", FontSize->14, Bold], {0.25, -0.15}], Black,
  Text[Style["(d)", FontSize->16, Bold], {-0.7, 0.154464}],
  Text[Style["(m)", FontSize->16, Bold], {-0.7, -0.23125}]
  },
 PlotRange -> {{-1, 1}, {-1, 1}},
 Axes -> True,
 AxesStyle -> Directive[FontSize->14],
 AxesLabel -> {"x", "z"}, AspectRatio->1/1.5, Controls->False
 ]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["be29971a-3db0-49a5-b6a9-215d906a043a"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgEKJ6UaWVqaGybqGqckGeiaWCaa6iaZJVrqGhmaplgamCUamBgnAgCEIxVp"*)(*]VB*)

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
ClearAll[k, ϵ, EM, sample, rgbConvert, c, a, ω];

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Propagation vectors

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Propagation vectors

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
k["z", ω_, c_, a_] :=  (*FB[*)((ω)(*,*)/(*,*)(c))(*]FB*) (*SqB[*)Sqrt[((*FB[*)(((*SpB[*)Power[ϵ[a](*|*),(*|*)2](*]SpB*))(*,*)/(*,*)(ϵ["d"]+ϵ["m"]))(*]FB*))](*]SqB*)
k["x", ω_, c_,  _] :=  (*FB[*)((ω)(*,*)/(*,*)(c))(*]FB*) (*SqB[*)Sqrt[((*FB[*)((ϵ["d"] ϵ["m"])(*,*)/(*,*)(ϵ["d"]+ϵ["m"]))(*]FB*))](*]SqB*)

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Construct EM wave 

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Construct EM wave 

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
ϵ["d"] = 1.0; ϵ["m"] = 1.00001;

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
EM[ω_, c_, x_, z_, t_] := (*TB[*)Piecewise[{{(*|*){1,0,1} Exp[I k["z", ω, c, "d"] z + I k["x", ω, c, "d"] x - I ω t] (*|*),(*|*)z > 0(*|*)},{(*|*){1,0, (*FB[*)((ϵ["d"])(*,*)/(*,*)(ϵ["m"]))(*]FB*)} Exp[I k["z", ω, c, "m"] z + I k["x", ω, c, "m"] x - I ω t] (*|*),(*|*)True(*|*)}}](*|*)(*1:eJxTTMoPSmNkYGAo5gESAZmpyanlmcWpTvkVmUxAAQBzVQdd*)(*]TB*)

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Sampling

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Sampling

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
rgbConvert[val_] := 255.0 ({0.5,0,0.5} + 0.5 val)
sample[t_] := NumericArray[
  Table[rgbConvert @ Re[EM[1.0, 1.0, x, -z, t]], {z, -1.0,1.0, 0.1}, {x, 0.0, 10.0, 0.3}]
, "Byte", "ClipAndRound"]

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Animation and controls

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Animation and controls

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
controls = InputGroup[<|
  "ed"  -> InputRange[-10.0, 10.0, 0.1, 1.0, "Label"->"&epsilon; (d)"],
  "rem" -> InputRange[-10.0, 10.0, 0.1, 1.0, "Label"->"Re[&epsilon;] (m)"],
  "iem" -> InputRange[-10.0, 0.0 , 0.1, 0  , "Label"->"Im[&epsilon;] (m)"]
|>];

EventHandler[controls, Function[assoc,
  ϵ["d"] = assoc["ed"];
  ϵ["m"] = assoc["rem"] + I assoc["iem"];
]];

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Animate

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Animate

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{
  array, t = 0., task
},
  EventHandler[ResultCell[], {"Destroy" -> Function[Null, TaskRemove[task]]}];

  EventHandler[CurrentWindow[], {"Closed" -> Function[Null,
  TaskRemove[task]]}];

  array = sample[t];
  task  = SetInterval[array = sample[t]; t = t + 0.1, 25];

  Row[{
    Image[array // Offload, "Byte", Magnification->20], 
    controls
  }]
]

%------------------------------%EndOfCells%-------------------------------%



