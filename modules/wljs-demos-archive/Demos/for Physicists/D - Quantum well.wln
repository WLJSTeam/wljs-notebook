%-------------------------------%Notebook%--------------------------------%
ObjectFields:
  - Objects
  - Symbols
  - Storage
  - ExcalidrawImages
  - RuntimeCache
  - ZIPArchive
%-------------------------------------------------------------------------%


%---------------------------------%Cells%---------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
# Quantum well
Solving Schrodinger equation in real-time

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
># Quantum well
Solving Schrodinger equation in real-time

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Initial parameters

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Initial parameters

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
ClearAll[v0, hb, d, m, V, op, u, V, x];

v0 = 8.;
hb = 1.;
d  = 1.;
m  = 1.;

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Operator

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Operator

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
V = (*TB[*)Piecewise[{{(*|*)0(*|*),(*|*)-d<=#<d(*|*)},{(*|*)v0(*|*),(*|*)True(*|*)}}](*|*)(*1:eJxTTMoPSmNkYGAo5gESAZmpyanlmcWpTvkVmUxAAQBzVQdd*)(*]TB*) &;
op[u_[x_]] := - hb^2/(2 m) u''[x] + V[x] u[x];

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Controls

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Controls

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: false
Type: Input
%-------------------------------------------------------------------------%
controls = EventHandler[InputGroup[<|
  "m" -> InputRange[0.1, 5, 0.1, 1.0, "Label"->"Mass"],
  "V" -> InputRange[0.1, 10, 0.1, 8.0, "Label"->"V0"],
  "d" -> InputRange[0.1, 2, 0.1, 1.0, "Label"->"d"]
|>], Function[values,
      v0 = values["V"];
      m = values["m"];
      d = values["d"];
  
      vplot = Table[{x,V[x]}, {x,-2,2,0.05}];
      
      {ev, ef} = 
        NDEigensystem[{op[u[x]], DirichletCondition[u[x] == 0, True]}, u[x], {x, -2, 2}, 6];
      
      xaxis = Table[i, {i,-2,2,0.025}];
      yaxis = Table[Evaluate[ef + ev], {x, xaxis}] // Transpose;
]];

controls // EventFire;

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Graphical output

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Graphical output

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Row[
    {
        Graphics[
            {
                Table[
                    With[{i = i, color = ColorData[97][i]},
                        {color, Line[{xaxis, yaxis[[i]]} // Transpose
                            ] // Offload}
                    ]
                    ,
                    {i, Length[yaxis]}
                ]
                ,
                AbsoluteThickness[2]
                ,
                Line[vplot // Offload]
            }
            ,
            Axes -> True
            ,
            PlotRange -> {{-2, 2}, {0, 16}}
            ,
            ImageSize -> {350, 350}
        ]
        ,
        controls
    }
]

