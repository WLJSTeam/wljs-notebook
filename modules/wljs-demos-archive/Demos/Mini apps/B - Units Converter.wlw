Display: markdown
Type: Output
%-------------------------------------------------------------------------%
# Units converter
An app for fast convertion different optical units.

<br />

## Source code

Define a custom input component

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
.wlx

CustomInput[Label__, opts:OptionsPattern[]] := CustomInput[ToStringRiffle[{Label}], opts];
CustomInput[Label_, OptionsPattern[]] := Module[{
  sym = OptionValue["Symbol"],
  Ev = OptionValue["Event"],
  Pattern = OptionValue["Pattern"],
  Handler
},
  With[{},
  With[{Template = 
    <div class="mt-2 flex">
      <div style="width: 7rem" class="flex shrink-0 items-center rounded bg-white px-3 text-base text-gray-500 outline outline-1 -outline-offset-1 outline-gray-300 sm:text-sm/6 mr-2"><Label/></div>
      <input type="number" step="1" class="-ml-px block w-full grow rounded bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" placeholder="0.0"/>
    <script type="module">
      core['<Handler/>'] = async (args, env) => {
        const input = env.element.getElementsByTagName('input')[0];


        const data = await interpretate(args[0], env);
        input.value = +data['<Pattern/>'].toFixed(4);
        env.local.input = input;

        input.addEventListener('change', () => {
          
          console.warn(input.value);
          env.local.skip = true;
          server.kernel.io.fire('<Ev/>', Number(input.value), '<Pattern/>');
        });        
      }

      core['<Handler/>'].update = async (args, env) => {
        if (env.local.skip) {
          env.local.skip = false;
          return;
        }
        console.log('Update');
        env.local.input.value = +(await interpretate(args[0], env))['<Pattern/>'].toFixed(4);
      }

      core['<Handler/>'].destroy = () => {
        delete core['<Handler/>'];
      }

      core['<Handler/>'].virtual = true;
    </script>
  </div>
  },
    HTMLView[Template, Epilog->(Handler[sym])]
  ]]
]

Options[CustomInput] = {"Symbol"->Null, "Event"->"", "Pattern"->"Default"};

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
App logic

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
App logic

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
.wlx
Module[{
  ev = CreateUUID[],
  rules,
  assoc,
  recalc
},
  

rules = {
  "Centimeters" -> "Centimeters",
  "eV" -> "Centimeters" / 8065.6,
  "meV" -> 1000 "Centimeters" / 8065.6,
  "Micrometers" -> 10000 / "Centimeters",
  "Nanometers" -> (*SpB[*)Power[10(*|*),(*|*)7](*]SpB*) / "Centimeters",
  "Angstrem" -> (*SpB[*)Power[10(*|*),(*|*)8](*]SpB*) / "Centimeters",
  "MHz" -> (*SpB[*)Power[10(*|*),(*|*)4](*]SpB*) 2.9979 "Centimeters",
  "GHz" -> (*SpB[*)Power[10(*|*),(*|*)4](*]SpB*) 2.9979 "Centimeters" 0.001,
  "THz" -> (*SpB[*)Power[10(*|*),(*|*)4](*]SpB*) 2.9979 "Centimeters" 0.001 0.001,
  "K" -> 1.428 "Centimeters",

  "ps" -> 0.004136 / ("Centimeters" / 8065.6),

  
  "T" -> 4.26602  "Centimeters",
  "Oe" -> 10000 4.26602  "Centimeters",
  
  "kJ/Mol" -> 0.0120 "Centimeters",
  "Hartree" ->   "Centimeters" / (27.2114 8065.6)
};

assoc = Association[rules];

rack = Map[Function[v, 0.0], assoc];

Module[{var},
recalc[units_, val_] := With[{cm = NSolve[val == (assoc[units] /. "Centimeters" -> var), var][[1,1,2]] // N},
  Map[Function[key,
    rack[key] = Round[(assoc[key] /. "Centimeters" -> cm), 0.0001]
  ], Keys[rack]];

  rack = rack;
];
]

EventHandler[ev, {
  units_ :> (recalc[units, #]&)
}];

<div class="flex flex-col bg-white p-4 w-full bg-white h-full gap-y-1 overflow-y-scroll">
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"Centimeters"}>cm<sup>-1</sup></CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"eV"}>eV</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"meV"}>meV</CustomInput>

  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"Micrometers"}>&micro;m</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"Nanometers"}>nm</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"Angstrem"}>A</CustomInput>

  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"MHz"}>MHz</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"GHz"}>GHz</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"THz"}>THz</CustomInput>

  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"ps"}>ps</CustomInput>

  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"Oe"}>Oe (1/2)</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"T"}>T (1/2)</CustomInput>

  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"K"}>K</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"kJ/Mol"}>kJ/Mol</CustomInput>
  <CustomInput Symbol={rack//Offload} Event={ev}  Pattern={"Hartree"}>Hartree</CustomInput>
</div>
]

