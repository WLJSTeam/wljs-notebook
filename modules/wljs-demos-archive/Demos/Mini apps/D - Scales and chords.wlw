## Windows
### Main window with search
Helper functions

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
scaleSearchScore[scaleName_, words_] := Total @ Map[Function[word,
  Count[
    StringMatchQ[#, ___~~word~~___, IgnoreCase->True]& /@ StringSplit[scaleName, " "],
    True
  ]
], DeleteCases[words, ""]]

searchScale[text_] := With[{
  scales = DownValues[scale][[All,1,1,1]]
},
  With[{words = StringTrim /@ StringSplit[text, " "]},
    With[{key = SelectFirst[words, StringLength[#] <= 2 && NumberQ[semitone[normalizeNoteName[#]]]&]},
      If[MissingQ[key],
        <|"Key"->Missing[], "Scales"->Table[{scale, scaleSearchScore[scale, words]}, {scale, scales}]|>
      ,
        With[{rest = words /. {key -> Nothing}},
          <|"Key"->normalizeNoteName[key], "Scales"->Table[{scale, scaleSearchScore[scale, rest]}, {scale, scales}]|>
        ]
      ]
    ]
  ]
]

pickScales[data_, n_:10] := With[{scales = Take[SortBy[data["Scales"], -#[[2]]&], Min[n, Length[data["Scales"]]]][[All,1]]},
  If[MissingQ[data["Key"]],
    Table[k -> {"C", k}, {k, scales}] // Association
  ,
    Table[StringTemplate["`` ``"][data["Key"], k] -> {data["Key"], k}, {k, scales}] // Association
  ]
]

