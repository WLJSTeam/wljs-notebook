.md
## Internal framework
Allows to work with notes easier

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Internal framework
Allows to work with notes easier

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
ClearAll[semitone, scale, mood, tuning];
normalizeNoteName[s_String] := With[{trim = StringTrim[s]},
  If[StringLength[trim] == 0, trim, ToUpperCase[StringTake[trim, 1]] <> StringReplace[StringDrop[trim, 1], {"#"->"#", "b"->"b", "B"->"b"}]]
]

convertToSemitones[s_String] := With[{c = StringCases[s, {a__~~b:DigitCharacter :> {a,ToExpression[b]}, a__ :> {a,4}}]//First},
  semitone[normalizeNoteName[c[[1]]]] + (c[[2]] - 4) 12
]
convertToSemitones[s_] := s;

convertToSemitones[l_List] := convertToSemitones /@ l

semitone[0] = "C";
semitone[1] = "C#";
semitone[2] = "D";
semitone[3] = "Eb";
semitone[4] = "E";
semitone[5] = "F";
semitone[6] = "F#";
semitone[7] = "G";
semitone[8] = "G#";
semitone[9] = "A";
semitone[10] = "Bb";
semitone[11] = "B";

semitone[n_Integer] := semitone[Mod[n, 12]] /; n < 0 || n > 11

semitone["C"] = 0;
semitone["B#"] = 0;
semitone["C#"] = 1;
semitone["Db"] = 1;
semitone["D"] = 2;
semitone["D#"] = 3;
semitone["Eb"] = 3;
semitone["E"] = 4;
semitone["Fb"] = 4;
semitone["E#"] = 5;
semitone["F"] = 5;
semitone["F#"] = 6;
semitone["Gb"] = 6;
semitone["G"] = 7;
semitone["G#"] = 8;
semitone["Ab"] = 8;
semitone["A"] = 9;
semitone["A#"] = 10;
semitone["Bb"] = 10;
semitone["B"] = 11;
semitone["Cb"] = 11;

scale["Major"] = {2, 2, 1, 2, 2, 2, 1};
mood["Major"] = "Bright and upbeat feeling";
scale["Natural Minor"] = {2, 1, 2, 2, 1, 2, 2};
mood["Natural Minor"] = "Sad and reflective feeling";
scale["Minor"] = scale["Natural Minor"];
mood["Minor"] = mood["Natural Minor"];
scale["Harmonic Minor"] = {2, 1, 2, 2, 1, 3, 1};
mood["Harmonic Minor"] = "Dark and dramatic feeling";
scale["Melodic Minor"] = {2, 1, 2, 2, 2, 2, 1};
mood["Melodic Minor"] = "Minor with a lifted, modern color";
scale["Major Pentatonic"] = {2, 2, 3, 2, 3};
mood["Major Pentatonic"] = "Joyful and open feeling";
scale["Minor Pentatonic"] = {3, 2, 2, 3, 2};
mood["Minor Pentatonic"] = "Bluesy and soulful feeling";
scale["Blues"] = {3, 2, 1, 1, 3, 2};
mood["Blues"] = "Gritty and expressive feeling";
scale["Dorian"] = {2, 1, 2, 2, 2, 1, 2};
mood["Dorian"] = "Mellow and jazzy feeling";
scale["Phrygian"] = {1, 2, 2, 2, 1, 2, 2};
mood["Phrygian"] = "Exotic and tense feeling";
scale["Lydian"] = {2, 2, 2, 1, 2, 2, 1};
mood["Lydian"] = "Dreamy and mystical feeling";
scale["Mixolydian"] = {2, 2, 1, 2, 2, 1, 2};
mood["Mixolydian"] = "Bluesy and relaxed feeling";
scale["Locrian"] = {1, 2, 2, 1, 2, 2, 2};
mood["Locrian"] = "Unstable and diminished feeling";
scale["Phrygian Dominant"] = {1, 3, 1, 2, 1, 2, 2};
mood["Phrygian Dominant"] = "Spanish and tense feeling";
scale["Whole Tone"] = {2, 2, 2, 2, 2, 2};
mood["Whole Tone"] = "Floating and symmetrical feeling";
scale["Chromatic"] = ConstantArray[1, 12];
mood["Chromatic"] = "All semitones";
scale["Diminished Whole Half"] = {2, 1, 2, 1, 2, 1, 2, 1};
mood["Diminished Whole Half"] = "Symmetrical diminished color";
scale["Diminished Half Whole"] = {1, 2, 1, 2, 1, 2, 1, 2};
mood["Diminished Half Whole"] = "Dominant diminished color";

scaleDegreeCount[steps_List] := Length[steps] + 1
scaleNotes[root_, steps_List] := With[{scaleMaker = makeScale[root, steps]},
  scaleMaker /@ Range[scaleDegreeCount[steps]]
]
scaleNotes[root_, scalename_String] := scaleNotes[root, scale[scalename]]

tuning["Standard"] = {"E6", "B5", "G5", "D5", "A4", "E4"};
tuning["Drop D"] = {"E6", "B5", "G5", "D5", "A4", "D4"};
tuning["Half Step Down"] = {"Eb6", "Bb5", "Gb5", "Db5", "Ab4", "Eb4"};
tuning["Whole Step Down"] = {"D6", "A5", "F5", "C5", "G4", "D4"};
tuning["D Standard"] = tuning["Whole Step Down"];
tuning["C# Standard"] = {"C#6", "G#5", "E5", "B4", "F#4", "C#4"};
tuning["C Standard"] = {"C6", "G5", "Eb5", "Bb4", "F4", "C4"};
tuning["B Standard"] = {"B5", "F#5", "D5", "A4", "E4", "B3"};
tuning["Drop C#"] = {"Eb6", "Bb5", "Gb5", "Db5", "Ab4", "Db4"};
tuning["Drop Db"] = tuning["Drop C#"];
tuning["Drop C"] = {"D6", "A5", "F5", "C5", "G4", "C4"};
tuning["Drop B"] = {"C#6", "G#5", "E5", "B4", "F#4", "B3"};
tuning["Drop Bb"] = {"C6", "G5", "Eb5", "Bb4", "F4", "Bb3"};
tuning["Drop A"] = {"B5", "F#5", "D5", "A4", "E4", "A3"};
tuning["Drop Ab"] = {"Bb5", "F5", "Db5", "Ab4", "Eb4", "Ab3"};
tuning["DADGAD"] = {"D6", "A5", "G5", "D5", "A4", "D4"};
tuning["Open D"] = {"D6", "A5", "F#5", "D5", "A4", "D4"};
tuning["Open G"] = {"D6", "B5", "G5", "D5", "G4", "D4"};

majorQ[SoundNote[n_List]] := With[{notes = Sort[convertToSemitones @ n]},
  notes[[2]] - notes[[1]] > 3
]

makeScale[root_Integer, steps_List] := With[{base = Accumulate[Join[{root}, steps]]},
  (base[[Mod[#-1, Length[base]-1] + 1]] + 12 Floor[# / Length[base]]) &
]

makeScale[root_String, steps_List] := makeScale[convertToSemitones[root], steps]

makeChord[root_, scalename_String, ext_Integer:3] := With[{s = makeScale[root, scale[scalename]]},
  chordObject[s, ext]
]

NoteTranspose[SoundNote[l_List], i_Integer] := With[{c = convertToSemitones[l]}, 
  SoundNote[Map[(# + i)&, c]]
]

NoteTranspose[SoundNote[l_Integer], i_Integer] := With[{c = convertToSemitones[l]}, 
  SoundNote[c + i]
]

NoteMerge[s:(SoundNote[_List]..)] := SoundNote[DeleteDuplicates[convertToSemitones[Join @@ ({s}[[All,1]])]]]

makeChord[root_, scalename_String, ext_String];
makeChord[root_, scalename_String, ext_Integer, mod_Rule];
makeChord[root_, scalename_String, ext_Integer, mod:{__Rule}];

chordObject[s_, ext_][offset_String] := chordObject[s, ext][FromRomanNumeral[offset]-1]

chordObject[s_, ext_][offset_Integer] := SoundNote @ Table[s[i + offset], {i, 1, 2 ext, 2}]

NoteNormalize[SoundNote[l_List], {min_, max_}] := With[{notes = convertToSemitones @ l},
  SoundNote[DeleteDuplicates[Map[Function[n, Module[{c = n},
    While[c < min, c += 12];
    While[c > max, c -= 12];
    c
  ]], notes]]]
]

