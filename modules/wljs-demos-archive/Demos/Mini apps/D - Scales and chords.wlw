Type: Input
%-------------------------------------------------------------------------%
.wlx

mainWindow[callback_] := Module[{pick = Null}, With[{
  InputField = InputAutocomplete[Function[{text, cbk},
    pick = pickScales[searchScale[text]];
    pick//Keys//cbk;
  ], "ClearOnSubmit"->True]
},

  EventHandler[InputField, Function[selected,
    If[MissingQ[pick[selected]] || pick === Null,
      Notify["Key / Scale does not exist", "Type"->"Warning"];
      Return[];
    ];

    callback @ (pick[selected]) 
  ]];

  <div>
    <InputField/>
  </div>

]
]

