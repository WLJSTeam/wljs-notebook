internalHandler["Chord", {CurrentKey_, CurrentScale_}, "Keys", OptionsPattern[]] := CreateWindow[Cell[With[{m = makeChord[CurrentKey, CurrentScale, 3]},
  With[{TableList = Table[With[{
    Widget = PianoView[m[r], ImageSize->{270,100}], 
    Roman = r
  },
    <div class="flex flex-row gap-x-2 items-center">
      <Widget/>
      <h3><Roman/></h3>
    </div>
  ], {r, {"I", "II", "III", "IV", "V", "VI"}}]},

    <div class="flex flex-col gap-y-2 p-4 bg-white">
      <p class="mt-1 max-w-2xl text-sm/6 text-gray-500"><CurrentKey/><span> </span><CurrentScale/></p>
      <TableList/>
    </div>
  ]
], "Output", "wlx"], "Notebook"->OptionValue["Notebook"]]

internalHandler["Chord", {CurrentKey_, CurrentScale_}, "Strings", OptionsPattern[]] := CreateWindow[Cell[With[{m = makeChord[CurrentKey, CurrentScale, 3]},
  With[{TableList = Table[With[{
    Widget = GuitarView[NoteMerge[m[r], NoteTranspose[m[r], 12], NoteTranspose[m[r], 24]], ImageSize->( {500,100}), "Tuning"->OptionValue["Tuning"]], 
    Roman = r
  },
    <div class="flex flex-row gap-x-2 items-center">
      <Widget/>
      <h3><Roman/></h3>
    </div>
  ], {r, {"I", "II", "III", "IV", "V", "VI"}}]},

    <div class="flex flex-col gap-y-2 p-4 bg-white">
      <p class="mt-1 max-w-2xl text-sm/6 text-gray-500"><CurrentKey/><span> </span><CurrentScale/></p>
      <TableList/>
    </div>
  ]
], "Output", "wlx"], "Notebook"->OptionValue["Notebook"]]

