.wlx

Options[TuningComponent] = {"Event"->""}
TuningComponent[OptionsPattern[]] := Module[{
  Event = OptionValue["Event"],
  UId = CreateUUID[],
  tunings = DownValues[tuning][[All,1,1,1]],
  currentTune = StringRiffle[tuning["Standard"], " "],
  buffer
},

With[{
  TuningField = InputAutocomplete[Function[{input, cbk}, 
    buffer = SortBy[Table[{tuning, Total @ Map[Function[word, Count[
              Map[Function[tuningWord, StringMatchQ[tuningWord, ___~~word~~___, IgnoreCase->True] ], StringSplit[tuning, " "]]
            , True]], StringSplit[input, " "]]}, {tuning, tunings}], Function[l, -l[[2]]]];
    cbk[buffer[[All,1]]];

  ], "Standard", "Label"->"Tuning", "ClearOnSubmit"->False],

  TuningFieldCurrent = CreateFrontEndObject[TextView[currentTune // Offload]]
},

EventHandler[TuningField, {

  "Selected" -> Function[key,
    currentTune = StringRiffle[tuning[key], " "];
    Beep[];
    EventFire[Event, "Tuning", convertToSemitones @ tuning[key]];
  ],

  "Entered" -> Function[input,
    currentTune = input;
    Echo[input];
    With[{semitones = convertToSemitones @ StringSplit[input, " "]},
      If[!TrueQ[AllTrue[semitones, NumberQ]], 
        Notify["Tuning must be like E5 D5 ... form", "Type"->"Warning"];
        Return[];
      ];

      EventFire[Event, "Tuning", semitones];
    ]
  ]
}];

<div class="py-1">
  <fieldset class="text-sm mb-2 rounded">
    <button id="keys-button-{UId}" class="px-2 py-1 rounded ring-1 ring-inset ring-gray-200 bg-white">Keys</button>
    <button id="strings-button-{UId}" class="px-2 py-1 rounded">Strings</button>
  </fieldset>
  <div id="strings-{UId}" class="hidden text-sm px-2 flex flex-col">
    <TuningField/>
    <TuningFieldCurrent/>
  </div>
  <script type="module">
    const keysButton = document.getElementById('keys-button-<UId/>');
    const stringButton = document.getElementById('strings-button-<UId/>');
    const container = document.getElementById('strings-<UId/>');

    keysButton.addEventListener('click', () => {
      keysButton.classList.add(...('ring-1 ring-inset ring-gray-200 bg-white'.split(' ')));
      stringButton.classList.remove(...('ring-1 ring-inset ring-gray-200 bg-white'.split(' ')));
      container.classList.add('hidden');
      server.kernel.emitt('<Event/>', '"Keys"', 'Instrument');
    });

    stringButton.addEventListener('click', () => {
      stringButton.classList.add(...('ring-1 ring-inset ring-gray-200 bg-white'.split(' ')));
      keysButton.classList.remove(...('ring-1 ring-inset ring-gray-200 bg-white'.split(' ')));
      container.classList.remove('hidden');
      server.kernel.emitt('<Event/>', '"Strings"', 'Instrument');
    })
  </script>
</div>
]]

