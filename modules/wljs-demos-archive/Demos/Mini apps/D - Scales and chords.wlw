Options[LandingWindow] = {"Key"->"C", "Scale"->"Major"}
LandingWindow[callback_, OptionsPattern[]] := Module[{
  stringTuning = tuning["Standard"],
  localControls = CreateUUID[],
  instrument = "Keys"
},

With[{
  CircleFifth = circleFifth[OptionValue["Key"], OptionValue["Scale"]],
  TuningComponent = TuningComponent["Event"->localControls],
  ChordChart = InputButton["Chord charts", "Style"->"box-shadow: rgb(255, 255, 255) 0px 0px 0px 0px inset, rgb(229, 231, 235) 0px 0px 0px 1px inset, rgba(0, 0, 0, 0) 0px 0px 0px 0px; font-weight:normal; font-size:14px"],
  ScaleChart = InputButton["Scale charts", "Style"->"box-shadow: rgb(255, 255, 255) 0px 0px 0px 0px inset, rgb(229, 231, 235) 0px 0px 0px 1px inset, rgba(0, 0, 0, 0) 0px 0px 0px 0px; font-weight:normal; font-size:14px"],
  Title = StringJoin[OptionValue["Key"], " ", OptionValue["Scale"]],
  Mood = mood[OptionValue["Scale"]],
  currentScale = OptionValue["Scale"],
  currentKey = OptionValue["Key"]
},

EventHandler[localControls, {"Instrument" -> Function[i, instrument = i], "Tuning" -> Function[t, stringTuning = t]}];

EventHandler[ChordChart, Function[Null,
  callback["Chord", {currentKey, currentScale}, instrument, "Tuning"->stringTuning];
]];

EventHandler[ScaleChart, Function[Null,
  callback["Scale", {currentKey, currentScale}, instrument, "Tuning"->stringTuning];
]];

<div class="p-4 bg-white h-full w-full">
  <div class="px-4 sm:px-0">
    <h3 class="text-base/7 font-semibold text-gray-900"><Title/></h3>
    <p class="mt-1 max-w-2xl text-sm/6 text-gray-500"><Mood/></p>
  </div>
  <div class="mt-6 border-t border-gray-100 flex flex-row gap-x-5">
    <dl class="divide-y divide-gray-100 gap-y-3 flex flex-col">
      <CircleFifth/>
    </dl>    
    <dl class="divide-y divide-gray-100 gap-y-3 flex flex-col">
      <div class="flex flex-row gap-x-3">
        <ChordChart/>
        <ScaleChart/>
      </div>
      <p class="mt-1 max-w-2xl text-sm/6 text-gray-500">Select the instrument</p>
      <TuningComponent/>
    </dl>
  </div>
</div>
] ]

