.wlx

internalMiddleware[notebook_][rest__] := internalHandler[rest, "Notebook"->notebook];

internalHandler["Scale", {currentKey_, currentScale_}, "Keys", OptionsPattern[]] := CreateWindow[Cell[With[{
  Widget = PianoView[
    scaleNotes[currentKey, currentScale] // SoundNote
  , "Mode"->"Scale"],
  Title = StringTemplate["`` ``"][currentKey, currentScale],
  Mood = mood[currentScale]
},
<div class="p-4 bg-white h-full w-full">
  <div class="pb-2">
    <h3 class="text-base/7 font-semibold text-gray-900"><Title/></h3>
  </div>
  <Widget/>
</div>
], "Output", "wlx"], "Notebook"->OptionValue["Notebook"]]


internalHandler["Scale", {currentKey_, currentScale_}, "Strings", OptionsPattern[]] := CreateWindow[Cell[With[{
  Widget = GuitarView[
    With[{notes = scaleNotes[currentKey, currentScale] // SoundNote},
      NoteMerge[notes, NoteTranspose[notes, 12], NoteTranspose[notes, 24]]
    ],
    "Mode"->"Scale", "Tuning"->(OptionValue["Tuning"])
  ],
  Mood = mood[currentScale]
},
<div class="p-4 bg-white h-full w-full">
  <div class="pb-2">
    <h3 class="text-base/7 font-semibold text-gray-900"><Title/></h3>
  </div>
  <Widget/>
</div>
], "Output", "wlx"], "Notebook"->OptionValue["Notebook"]]

Options[internalHandler] = {"Notebook"->"", "Tuning"->""};

