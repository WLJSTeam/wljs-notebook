%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
# Spray Text Example
Some test of low-level interactivity

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
text = "Hello World";

Column[{
  EventHandler[InputText[text], (text=#)&],
  Graphics[Table[{
      RandomColor[],
      Rotate[
        Text[text // Offload, RandomReal[{-1, 1}, 2]],
        RandomReal[{0, 3.14}]
      ]
  }, {40}]]
}, Spacings->1] // Deploy

%------------------------------%EndOfCells%-------------------------------%



