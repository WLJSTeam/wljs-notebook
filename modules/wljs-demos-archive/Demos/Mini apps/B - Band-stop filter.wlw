.md
Compile band envelope Gaussian functions

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Compile band envelope Gaussian functions

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
compiledFbandsEval = Compile[
  {{xlist, _Real, 1}, {data, _Real, 2}},
  Module[{x, i, j, tmp, res = ConstantArray[1., Length[xlist]]},
    For[i = 1, i <= Length[xlist], i++,
      x = xlist[[i]];
      tmp = 1.;
      For[j = 1, j <= Length[data], j++,
        tmp *= Clip[1. - data[[j, 1]] * Exp[-(x - data[[j, 2]])^2 * data[[j, 3]]], {0., 100.}]
      ];
      res[[i]] = tmp;
    ];
    res
  ]
];

EvaluateFbandsProjection[fbands_, newFourierAxis_] := Module[
  {processedFbands},



  (* Sanitize sigma: prevent divide-by-zero *)
  processedFbands = Map[{#[[1]], #[[2]], 1/(2 Max[#[[3]], 10^-10]^2)}&, fbands];

  compiledFbandsEval[newFourierAxis//N, processedFbands//N]
];

