%-------------------------------------------------------------------------%
importToDataset[path_, type_, lines_, router_] := With[{i = Import[path, type, HeaderLines->lines]},
  If[FailureQ[i],
    Dataset[{$Failed}]
  ,
    With[{
      rowLength = Length[i[[1]]]
    },
      Join[{Table[InputCheckbox[router, u<=2, "Topic"->ToString[u]], {u,1,rowLength}]}, i] // Dataset
    ]
  ]
]

updatePreview[group_, ref_, dataset_] := With[{}, If[group =!= Null, Delete[group]];
      group = FrontInstanceGroup[];
      FrontSubmit[group[dataset], ref];
];

SetAttributes[updatePreview, HoldFirst]

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
.wlx

Module[{
 DatasetObject,
 group = Null,
 path = Null,
 header = 1,
 hashMap = <|"1"->True, "2"->True|>,
 type = "CSV"
}, With[{
  FileInput = InputButton["Open file"],
  Process = InputButton["Process"],
  UIGroup = InputGroup[<|
    "Type" -> InputSelect[{"CSV", "TSV", "XLS", "XLSX"}, type],
    "Header" -> InputRange[0,4,1,header, "Label"->"Header lines"]
  |>],
  router = EventObject[],
  ref = FrontInstanceReference[],
  nb = EvaluationNotebook[]
},

  group = FrontInstanceGroup[];
  DatasetObject = CreateFrontEndObject[{ref, group[Dataset[{"No data"}]]}];

  EventHandler[FileInput, Function[Null, Then[SystemDialogInputAsync["OpenList", {Null, {"Formats" -> {"*.csv", "*.tsv", "*.xls", "*.txt", "*.dat"}}}


], Function[p,
    path = Flatten[{p}]//First;
    dataset = importToDataset[path, type, header, router];
    updatePreview[group, ref, dataset];
  ]]]];

  EventHandler[router, {q_String :> Function[state, hashMap[q] = state]}];

  EventHandler[UIGroup, Function[assoc,
    type = assoc["Type"]; header = assoc["Header"];
    dataset = importToDataset[path, type, header, router];
    updatePreview[group, ref, dataset];
  ]];

  EventHandler[Process, Function[Null,
    With[{normalized = Drop[dataset, 1][[All, Take[ToExpression/@Keys[Select[KeySortBy[hashMap, ToExpression], #&]], 2] ]]},
      If[FailureQ[normalized], 
        MessageDialog["Wrong input data!", "Notebook"->nb];
        Return[];
      ];
      With[{filtered = Select[normalized // Normal, Function[item, NumericQ[item[[1]]] && NumericQ[item[[2]]]]]},
          If[Length[filtered] == 0,
            MessageDialog["Wrong input data!", "Notebook"->nb];
            Return[];
          ,
            Beep[];
            CreateWindow[
              Cell[OperatingWindow["Data"->filtered], "Output", "wlx"], 
              "Notebook"->nb, WindowSize->{1600, 500}
            ]
          ];
      ]
    ]
  ]];


  <div class="flex flex-row justify-between py-1 px-2">
    <div class="relative block" style="max-width:80vw; max-height:600px;">
      <DatasetObject/>
    </div>
    <div class="flex flex-col gap-y-2">
      <div class="flex flex-row gap-x-2">
        <FileInput/>
        <Process/>
      </div>
      <UIGroup/>
    </div>
    <script type="module">resizeTo(800,800)</script>
  </div>
] ]

