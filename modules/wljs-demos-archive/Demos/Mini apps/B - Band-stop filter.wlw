Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
__Main filtering function__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
__Main filtering function__

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
filter[{tbands_, fbands_}, trace_] := With[{timeAxis = trace[[All,1]]}, 




Module[{}, With[{
    mod = EvaluateFbandsProjection[tbands, timeAxis]
  },
    

    
    With[{ newTrace = {timeAxis, trace[[All,2]] mod} // Transpose},

      With[{newFourier = fourier2d[newTrace]},

 

          With[{newFourierAxis = newFourier[[All,1]]},
          
            With[{
              modF = EvaluateFbandsProjection[fbands, newFourierAxis]
              
            }, 

         

              With[{postFourier = {newFourierAxis, modF newFourier[[All,2]]} // Transpose}, 



                  <|
                    "Trace"->backSample[inverseFourier2d[postFourier], trace], 
                    "Image"->postFourier, "TraceEnvelope"->mod, "ImageEnvelope"->modF
                  |>

              ]
              
          
            ]
          ]
      ]
      
    ]
  ]

    
  
  ] ]

