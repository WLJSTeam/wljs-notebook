OperatingWindow[opts__] :=
With[{W = Widget[opts]},

  <div class="w-full h-full px-2 py-2 overflow-hidden">

    <div class="flex flex-row gap-x-2">
      <W>UI1</W>
      <W>UI2</W>
      <W>UI3</W>
    </div>
    <div class="flex flex-row w-full justify-between">
      <W>Trace</W>
      <W>Image</W>
    </div>
    
  </div>

]

