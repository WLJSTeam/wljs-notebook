## 3 Band-stop App
Interactive widget for importing ASCII data and filtering in real or Fourier domain.

### Source code
A helper function to resample a list of data

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
resample[data_List] := With[{
  int = Interpolation[data]
}, With[{
  range = int["Domain"]//First,
  step = Min[Abs[data[[All,1]] // Differences]]/2.0
},
  Table[{x, int[x]}, {x, range[[1]], range[[2]], step}]
] ]

resample[data_List, target_List] := With[{
  int = Interpolation[data]
}, With[{},
  Map[{#, int[#]}&, target[[All,1]]]
] ]

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Tools for Fourier-transform

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Tools for Fourier-transform

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
dropHalf[list_List] := Drop[list, -Round[Length[list]/2]]

skip10[list_List] := Drop[list, Round[Length[list]/9]]

keepMiddle[list_List] := Drop[Drop[list, -Round[Length[list]/4]], Round[Length[list]/5]]

fourier2d[sample_List] := fourier2d[sample, (Differences[sample[[All,1]]] //Abs// Min)/2.0]
fourier2d[sample_List, step_] := With[{int = Interpolation[sample] },

With[{resampled = Fourier[Table[int[i], {i, sample[[1,1]], sample[[-1,1]], step}]]},

With[{resampledLength = Length[resampled] },
  Transpose[{
    Table[33.356 i, {i, 0, (*FB[*)((1)(*,*)/(*,*)(step))(*]FB*) - (*FB[*)((1)(*,*)/(*,*)(step resampledLength))(*]FB*), (*FB[*)((1)(*,*)/(*,*)(step resampledLength))(*]FB*)}],

    resampled
    
  }] // dropHalf
]] ]

fourier2d[sample_List, {min_, max_, step_}] := With[{int = Interpolation[sample]},

With[{resampled = Fourier[Table[int[i], {i, min, max, step}]]}, 
With[{resampledLength = Length[resampled]},
  Transpose[{
    Table[33.356 ( (*FB[*)((1)(*,*)/(*,*)(step resampledLength step))(*]FB*) (i - min)),  {i, min, max, step}],
    resampled
  }] // dropHalf
] ] ]


inverseFourier2d[sample_NumericArray] := inverseFourier2d[sample // Normal]
inverseFourier2d[image_List] := With[
  {
    step = Differences[image[[All, 1]]] // Abs // Min,
    min = image[[All,1]] // Min,
    max = image[[All,1]] // Max,
    int = Interpolation[image, InterpolationOrder->1]
  },
    inverseFourier2d[Table[{x,  int[x]}, {x, min, max, step}], {min, max, step}]
]

inverseFourier2d[image_List, {min_, max_, step_}] := Module[
  {
    freqs, fourierData, fullFourier, reconstructed, timeDomain
  },
  
  {freqs, fourierData} = Transpose[image];
  
  fullFourier = Join[fourierData,   {0.}, Drop[Conjugate[Reverse[fourierData]], -1]];
  reconstructed = InverseFourier[fullFourier];

  timeDomain = Transpose@{
    Table[33.356 i, {i, 0, (*FB[*)((1)(*,*)/(*,*)(step))(*]FB*) - (*FB[*)((1)(*,*)/(*,*)(step Length[reconstructed]))(*]FB*), (*FB[*)((1)(*,*)/(*,*)(step Length[reconstructed]))(*]FB*)}],
    Re[reconstructed]
  };
  
  timeDomain
]

backSample[list_, target_] := With[{
  starting = target[[1,1]],
  int = Interpolation[list]
},
  Map[{#, int[# - starting]}&, target[[All,1]]]
]

padSeries[list_, length_Integer] := Module[
  {diff = Length[list] - length, lastDiff, lastTime, lastY},
  If[diff >= 0,
    Drop[list, -diff],
    lastDiff = list[[-1, 1]] - list[[-2, 1]]; (* Difference in time *)
    lastTime = list[[-1, 1]];
    lastY = list[[-1, 2]];
    Join[list, Table[{lastTime + i*lastDiff, lastY/(2^i)}, {i, 1, Abs[diff]}]]
  ]
]

