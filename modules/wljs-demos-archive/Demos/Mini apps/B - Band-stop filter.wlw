Widget[OptionsPattern[]] := Module[{
  update, tbands, fbands, envelope, envelopeF,
  modifedTrace, modifedFourier
}, With[{
  originalData = OptionValue["Data"],
  trace = OptionValue["Data"][[;;;;2]],
  fourier = fourier2d[OptionValue["Data"][[;;;;2]]] // Abs // dropHalf // dropHalf
}, With[{
  minMaxTimeY = MinMax[trace[[All,2]]],
  minMaxTimeX = MinMax[trace[[All,1]]],
  minMaxFreqY = MinMax[fourier[[All,2]]],
  minMaxFreqX = MinMax[fourier[[All,1]]],
  upperTimeBond = Total[MinMax[trace[[All,2]]] {0.1,0.9}],
  lowerTimeBond = Total[MinMax[trace[[All,2]]] {0.9,0.1}],
  upperFreqBond = Total[MinMax[fourier[[All,2]]] {0.1,0.6}],
  lowerFreqBond = Total[MinMax[fourier[[All,2]]] {0.9,0.1}],
  timeAxis = trace[[All,1]],
  fourierAxis = fourier[[All,1]],
  timeYAxis = trace[[All,2]],

  widthTime = With[{o = MinMax[trace[[All,1]]]}, 0.02 (o[[2]] - o[[1]])],
  widthFreq = With[{o = MinMax[fourier[[All,1]] // dropHalf]}, 0.02 (o[[2]] - o[[1]])]
},

  modifedTrace = trace;
  modifedFourier = fourier;

  envelope = {{0,1}, {1,1}};
  envelopeF = envelope;

  SetAttributes[update, HoldFirst];

  update[] := With[{result = filter[{tbands, fbands}, trace]},
    envelope = {timeAxis, (# upperTimeBond) &/@ result["TraceEnvelope"]} // Transpose;
    envelopeF = {result["Image"][[All,1]], (# upperFreqBond) &/@ result["ImageEnvelope"]} // Transpose;
    modifedFourier = result["Image"] // Abs // dropHalf ;
    modifedTrace = result["Trace"];
  ];

  update[tbands, "drag", i_, xy_] := (
    tbands[[i]] = With[{old = tbands[[i]]}, 
      {(1 - (xy[[2]] - 0)/(upperTimeBond - 0)), xy[[1]], old[[3]]}
    ];
    update[];
  );

  update[fbands, "drag", i_, xy_] := (
    fbands[[i]] = With[{old = fbands[[i]]}, 
      {If[# < 0, - 10 #^2, #] &@ (1 - (xy[[2]] - 0)/(upperFreqBond - 0)), xy[[1]], old[[3]]}
    ];
    update[];
  );

  update[tbands, "zoom", i_, k_] := (
    tbands[[i]] = With[{old = tbands[[i]]}, 
      {old[[1]], old[[2]], k widthTime}
    ];
    update[];
  );

  update[fbands, "zoom", i_, k_] := (
    fbands[[i]] = With[{old = fbands[[i]]}, 
      {old[[1]], old[[2]], k widthTime}
    ];
    update[];
  );
  

  tbands = {List[0,1,widthTime], List[0,1,widthTime], List[0,1,widthTime]};
  fbands = {List[0,1,widthFreq], List[0,1,widthFreq], List[0,1,widthFreq]};  

  <|
    "UI1" -> 
      Button["Reset", 
        tbands[[All,1]] = 0 tbands[[All,1]];
        fbands[[All,1]] = 0 fbands[[All,1]];
        update[];
        
      ],

      "UI3" -> Button["Export Image",
        With[{result = filter[{tbands, fbands}, originalData]},
          Then[SystemDialogInputAsync["FileSave", {Null, {"Tabular Formats" -> {"*.csv", "*.tsv"}, "ASCII Data" -> {"*.dat"}}}],
            Function[path,
              Export[path, Map[Function[point, {point[[1]], Abs[point[[2]]], Arg[point[[2]]]}], result["Image"]]];
            ]
          ]
        ]
      ],

      "UI2" -> Button["Export Real",
        With[{result = filter[{tbands, fbands}, originalData]},
          Then[SystemDialogInputAsync["FileSave", {Null, {"Tabular Formats" -> {"*.csv", "*.tsv"}, "ASCII Data" -> {"*.dat"}}}],
            Function[path,
              Export[path, result["Trace"]];
            ]
          ]
        ]
      ]      
     ,
    
    "Trace" -> ListLinePlot[trace, 
      PlotRange->Full, Frame->True, 
      PlotStyle->Directive[(*VB[*)(RGBColor[0.24, 0.6, 0.8])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8q2iHX+jpwxzn7ImMweGxfNGsmCLy0BwBgKxmG"*)(*]VB*), Opacity[0.3]], 
      Epilog->{
      {Lighter[(*VB[*)(RGBColor[0.24, 0.6, 0.8])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8q2iHX+jpwxzn7ImMweGxfNGsmCLy0BwBgKxmG"*)(*]VB*)], Line[envelope // Offload]},
         (*VB[*)(RGBColor[0.24, 0.6, 0.8])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8q2iHX+jpwxzn7ImMweGxfNGsmCLy0BwBgKxmG"*)(*]VB*), PointSize[2 0.04], Table[With[{i=i}, EventHandler[Point[{(Mean@minMaxTimeX) + ((minMaxTimeX[[2]]-minMaxTimeX[[1]]) 0.4 ((i-2)/2.0)), upperTimeBond}], {
           "drag" -> (update[tbands, "drag", i, #]&),
           "zoom" -> (update[tbands, "zoom", i, #]&)
         }]], {i, 1,3}],

         
         (*VB[*)(RGBColor[0.578, 0.51, 0.85])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8qenpB6fbPukf2RUE75FpfBz6wLzIGg9f2AIG6GcU="*)(*]VB*), Line[modifedTrace // Offload]
      }
    , ImageSize->Large, PlotLabel->"Real space", FrameLabel->{"real domain", "values"}, Background->White],
    "Image" -> ListLinePlot[fourier, 
      PlotRange->Full, Frame->True, 
      PlotStyle->Directive[(*VB[*)(RGBColor[0.95, 0.627, 0.1425])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8qSgODd/ZFqz5e8k0SeGJfZMt1fXGB7SF7AGW1GWY="*)(*]VB*), Opacity[0.3]],
      Epilog->{
      {Lighter[(*VB[*)(RGBColor[0.95, 0.627, 0.1425])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8qSgODd/ZFqz5e8k0SeGJfZMt1fXGB7SF7AGW1GWY="*)(*]VB*)], Line[envelopeF // Offload]},
         (*VB[*)(RGBColor[0.95, 0.627, 0.1425])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8qSgODd/ZFqz5e8k0SeGJfZMt1fXGB7SF7AGW1GWY="*)(*]VB*), PointSize[2 0.04], Table[With[{i=i}, EventHandler[Point[{(Mean@minMaxFreqX) + ((minMaxFreqX[[2]]-minMaxFreqX[[1]]) 0.4 ((i-2)/2.0)), upperFreqBond}], {
           "drag" -> (update[fbands, "drag", i, #]&),
           "zoom" -> (update[fbands, "zoom", i, #]&)
         }]], {i, 1,3}],

          

         (*VB[*)(RGBColor[0.922526, 0.385626, 0.209179])(*,*)(*"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3cs7PyS8qurL1m11o61v7ojv689dIrLthX6Thzrgo4dgpewB9bxpO"*)(*]VB*), Line[modifedFourier // Offload]
      }
    , ImageSize->Large, PlotLabel->"Fourier space", FrameLabel->{"frequency", "amplitude"}, Background->White]
  
  |> 
] ] ]

Options[Widget] = {"Data"->{}}

