%-------------------------------------------------------------------------%
.md
## Main interactive widget
Calculate and display the spectrogram with real-time controls for:
- **Vertical offset**: Navigate through frequency range
- **Window size**: Adjust time-frequency resolution trade-off
- **Window sharpness**: Control Hann window parameter
- **Band-pass Q**: Tune filter selectivity

The widget includes memoization to cache results and avoid redundant calculations.

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Main interactive widget
Calculate and display the spectrogram with real-time controls for:
- **Vertical offset**: Navigate through frequency range
- **Window size**: Adjust time-frequency resolution trade-off
- **Window sharpness**: Control Hann window parameter
- **Band-pass Q**: Tune filter selectivity

The widget includes memoization to cache results and avoid redundant calculations.

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
(* Memoization helper: caches last evaluated expression *)
ClearAll[checkIfSame]
SetAttributes[checkIfSame, HoldFirst]
checkIfSame[expr_] := If[Hold[expr] === checkIfSame$last,
  checkIfSame$result
,
  checkIfSame$last = Hold[expr];
  checkIfSame$result = expr
]

(* Shared constants *)
nPoints    = 2000;
baseFreq   = 0.132159090909090909;
freqStep   = 0.002522727272727272;

ClearAll[estimate]
estimate[vc_, q_, offset_:0, samples_:2500, fwindow_:100, window_:(3*250), hann_:1.0] :=
  Module[{specFull},
    yScale   = ToString[NumberForm[#, {2, 2}]]& /@ makeYScale[offset, fwindow, samples];
    specFull = checkIfSame[
      Abs @ Transpose @ SpectrogramArray[
        trace[[All, 2]] // filter[baseFreq + freqStep * offset, q],
        window, 1, HannWindow[#, hann]&, samples
      ]
    ];
    raster = specFull[[offset + 1 ;; offset + 1 + fwindow, ;; nPoints]]
             // Rescale // cfo // NumericArray;
    oTrace = {#[[1]] - 0.05 * window / 2.0, #[[2]] / 10.0 + 0.2}& /@ trace[[;; nPoints]];
  ]

estimate[0.1, 0.1, 102]

Widget = Row[{
  Graphics[
    {
      Raster[raster // Offload, {{trace[[1, 1]], 0}, {trace[[nPoints, 1]], 1}}],
      {Cyan, Line[oTrace // Offload]},
      White,
      Translate[
        Table[With[{i = i},
          {
            {Opacity[0.2], Dashed, Line[{{-300, (i-1)/10.0}, {trace[[nPoints, 1]], (i-1)/10.0}}]},
            Rectangle[{1, (i-1)/10.0 - 0.02}, {11, (i-1)/10.0 + 0.02}],
            Black,
            Text[yScale[[i]] // Offload, {5, (i-1)/10.0}, {0, 0}]
          }
        ], {i, 1, 11}],
        {trace[[nPoints, 1]] * 0.8, 0}
      ]
    },
    Axes -> True, "Controls" -> False,
    Frame -> True, FrameLabel -> {"t (ps)", "wavenumber (1/cm)"},
    FrameTicks -> {{None, Automatic}, {Automatic, None}},
    ImageSize -> Large,
    PlotRange -> {{trace[[1, 1]], trace[[nPoints, 1]]}, {0, 1}}
  ],
  EventHandler[
    InputGroup[{
      InputRange[0, 500, 1, 102,         "Label" -> "Vertical offset"],
      InputRange[50, 3*2*250, 50, 3*250, "Label" -> "Window"],
      InputRange[0.5, 1.0, 0.1, 1.0,    "Label" -> "Window sharpness"],
      InputRange[0.01, 12.0, 0.01, 5.0,  "Label" -> "Band-pass Q"]
    }],
    Function[data,
      estimate[0, data[[4]], data[[1]], 2500, 100, data[[2]], data[[3]]]
    ]
  ]
}];

