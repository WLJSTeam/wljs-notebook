.md
## Final example: Ray marching with four workers
The rest of this notebook puts the Workers API to work in a heavier example: rendering a ray-marched image by splitting the frame across four workers.

Step 1: Define a shared library:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Final example: Ray marching with four workers
The rest of this notebook puts the Workers API to work in a heavier example: rendering a ray-marched image by splitting the frame across four workers.

Step 1: Define a shared library:

%-------------------------------------------------------------------------%
Props:
  Fade: true
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
RayMarching.wl
BeginPackage["TileRaymarching`"];

RaymarchTile::usage =
  "RaymarchTile[{width, height}, crop, opts] returns a tile as a \
height x width x 3 RGB array. crop is All, {x0, x1, y0, y1}, or \
{{x0, x1}, {y0, y1}} using 1-based inclusive full-frame pixels.";

RaymarchImage::usage =
  "RaymarchImage[{width, height}, opts] renders the whole frame and returns \
a Wolfram Image.";

MakeTileCrops::usage =
  "MakeTileCrops[{width, height}, {tileWidth, tileHeight}] returns \
1-based inclusive crop rectangles suitable for RaymarchTile.";

StitchTiles::usage =
  "StitchTiles[{width, height}, {{crop1, tile1}, ...}] stitches RaymarchTile \
results back into a full-frame RGB array.";

Begin["`Private`"];

ClearAll[DefaultSceneDistance, DefaultMaterialColor, RayDirection, EstimateNormal,
  MarchRay, ShadePoint, ParseCrop, ToByteColor,
  BuildCameraBasis, MakeCompiledMarcher, MakeCompiledNormal,
  MakeCompiledRayDir];

(* -----------------------------------------------------------------------
   Default SDF: a sphere at the origin with r = 1, and a floor at y = -1.
   Use Sqrt[p.p] instead of Norm[p] — Compile handles dot products natively
   and avoids the overhead of the general Norm dispatch.
   ----------------------------------------------------------------------- *)
DefaultSceneDistance[p_] := Min[
  Sqrt[p . p] - 1.,
  p[[2]] + 1.
];

DefaultMaterialColor[p_] := Module[{checker},
  If[p[[2]] < -0.985,
    checker = Mod[Floor[p[[1]]] + Floor[p[[3]]], 2];
    If[checker == 0, {0.82, 0.82, 0.78}, {0.22, 0.24, 0.27}],
    {1.0, 0.42, 0.22}
  ]
];

(* -----------------------------------------------------------------------
   Crop parsing — unchanged, called once per tile
   ----------------------------------------------------------------------- *)
ParseCrop[All, width_, height_] := {{1, width}, {1, height}};
ParseCrop[{x0_, x1_, y0_, y1_}, width_, height_] :=
  ParseCrop[{{x0, x1}, {y0, y1}}, width, height];
ParseCrop[{{x0_, x1_}, {y0_, y1_}}, width_, height_] := Module[
  {xs, xe, ys, ye},
  {xs, xe} = Sort[Round /@ {x0, x1}];
  {ys, ye} = Sort[Round /@ {y0, y1}];
  {{Clip[xs, {1, width}], Clip[xe, {1, width}]},
   {Clip[ys, {1, height}], Clip[ye, {1, height}]}}
];

(* -----------------------------------------------------------------------
   Camera basis — computed ONCE per tile, not per pixel.
   Returns {forward, right, up, aspect*scale, scale} so RayDirection
   becomes a handful of FMAs with no trig or cross-products per pixel.
   ----------------------------------------------------------------------- *)
BuildCameraBasis[eye_, target_, fov_, width_, height_] := Module[
  {forward, right, up, aspect, scale},
  forward = Normalize[N[target - eye]];
  right   = Normalize[Cross[forward, {0., 1., 0.}]];
  up      = Normalize[Cross[right, forward]];
  aspect  = N[width] / N[height];
  scale   = Tan[N[fov] / 2.];
  (* Return flat list — avoids Association overhead *)
  {forward, right, up, aspect * scale, scale}
];

(* -----------------------------------------------------------------------
   RayDirection using precomputed basis — pure arithmetic per pixel.
   sx and sy are the only per-pixel floating point work here.
   ----------------------------------------------------------------------- *)
RayDirection[{x_, y_}, {width_, height_}, {forward_, right_, up_, aspectScale_, scale_}] :=
  Normalize[
    forward
    + ((2. (x - 0.5) / width  - 1.) * aspectScale) * right
    + ((1. - 2. (y - 0.5) / height) * scale)       * up
  ];

(* -----------------------------------------------------------------------
   MarchRay — returns plain list {hit (1/0), t, px, py, pz, steps}
   instead of an Association. Lists are faster to construct and index
   in tight loops, and are required for Compile.
   ----------------------------------------------------------------------- *)
MarchRay[origin_, direction_, sceneDistance_, maxSteps_, maxDistance_, epsilon_] :=
  Module[{t = 0., i = 0, p, d, hit = 0},
    While[i < maxSteps && t < maxDistance,
      p = origin + t * direction;
      d = sceneDistance[p];
      If[d < epsilon,
        hit = 1; Break[],
        t += d
      ];
      i++
    ];
    (* Return list instead of Association: faster allocation & access *)
    {hit, t, origin + t * direction}
  ];

(* -----------------------------------------------------------------------
   EstimateNormal — 6 SDF evaluations via central differences.
   epsilon is pre-doubled here so the argument carries the full step size.
   ----------------------------------------------------------------------- *)
EstimateNormal[p_, sceneDistance_, epsilon_] := Module[{e = epsilon * 2.},
  Normalize[{
    sceneDistance[p + {e, 0., 0.}] - sceneDistance[p - {e, 0., 0.}],
    sceneDistance[p + {0., e, 0.}] - sceneDistance[p - {0., e, 0.}],
    sceneDistance[p + {0., 0., e}] - sceneDistance[p - {0., 0., e}]
  }]
];

(* -----------------------------------------------------------------------
   ShadePoint — lightDir is pre-normalised by the caller (once per tile).
   Gamma correction is folded in here so shadePixel needs only one Clip.
   ----------------------------------------------------------------------- *)
ShadePoint[p_, normal_, direction_, materialColor_, lightDir_, invGamma_] := Module[
  {base, diffuse, rim, linear},
  base    = materialColor[p];
  diffuse = Max[0., normal . lightDir];
  rim     = 0.18 * (Max[0., 1. + normal . direction])^3;
  linear  = Clip[base * (0.18 + 0.82 * diffuse) + rim * {0.8, 0.9, 1.0}, {0., 1.}];
  (* Apply gamma once here, avoiding a second Clip in shadePixel *)
  linear ^ invGamma
];

ToByteColor[color_] := Round[255. * Clip[color, {0., 1.}]];

(* -----------------------------------------------------------------------
   Options
   ----------------------------------------------------------------------- *)
Options[RaymarchTile] = {
  "CameraPosition"        -> {0., 1.15, 4.},
  "LookAt"                -> {0., 0.15, 0.},
  "FieldOfView"           -> 45 Degree,
  "MaxSteps"              -> 128,
  "MaxDistance"           -> 60.,
  "SurfaceEpsilon"        -> 0.001,
  "LightDirection"        -> Normalize[{-0.55, 0.8, 0.35}],
  "BackgroundColor"       -> {0.62, 0.76, 0.96},
  "SceneDistanceFunction" -> DefaultSceneDistance,
  "MaterialColorFunction" -> DefaultMaterialColor,
  "Gamma"                 -> 2.2,
  "ByteOutput"            -> False
};

(* -----------------------------------------------------------------------
   RaymarchTile — main entry point.

   Key algorithmic changes compared with the original:
     1. The camera basis is built ONCE outside the pixel loop (BuildCameraBasis).
     2. LightDirection is normalised ONCE outside the pixel loop.
     3. Gamma is inverted once (invGamma = 1/gamma) and passed in.
     4. ShadePoint folds gamma in, so shadePixel performs only one Clip total.
     5. MarchRay returns a list, not an Association, which means cheaper allocation
        and integer indexing instead of key lookup.
     6. The inner loop uses Break[] instead of a boolean flag and an extra
        condition check on each iteration.
   ----------------------------------------------------------------------- *)
RaymarchTile[{width_Integer?Positive, height_Integer?Positive},
   crop_: All, OptionsPattern[]] := Module[
  {
    xRange, yRange,
    eye, target, fov, maxSteps, maxDistance, epsilon,
    lightDir, background, sceneDistance, materialColor,
    invGamma, byteOutput,
    basis,                 (* precomputed camera basis *)
    shadePixel
  },

  {xRange, yRange} = ParseCrop[crop, width, height];

  eye           = N @ OptionValue["CameraPosition"];
  target        = N @ OptionValue["LookAt"];
  fov           = OptionValue["FieldOfView"];
  maxSteps      = OptionValue["MaxSteps"];
  maxDistance   = N @ OptionValue["MaxDistance"];
  epsilon       = N @ OptionValue["SurfaceEpsilon"];
  lightDir      = Normalize[N @ OptionValue["LightDirection"]];  (* once *)
  background    = N @ OptionValue["BackgroundColor"];
  sceneDistance = OptionValue["SceneDistanceFunction"];
  materialColor = OptionValue["MaterialColorFunction"];
  invGamma      = 1. / N @ OptionValue["Gamma"];                 (* once *)
  byteOutput    = TrueQ @ OptionValue["ByteOutput"];

  (* Build camera basis once for the whole tile *)
  basis = BuildCameraBasis[eye, target, fov, width, height];

  shadePixel[x_, y_] := Module[{dir, march, color, n},
    dir   = RayDirection[{x, y}, {width, height}, basis];
    march = MarchRay[eye, dir, sceneDistance, maxSteps, maxDistance, epsilon];
    color = If[march[[1]] === 1,           (* list index, not key lookup *)
      n = EstimateNormal[march[[3]], sceneDistance, epsilon];
      ShadePoint[march[[3]], n, dir, materialColor, lightDir, invGamma],
      background ^ invGamma               (* gamma-correct background too *)
    ];
    If[byteOutput, ToByteColor[color], Clip[color, {0., 1.}]]
  ];

  Table[shadePixel[x, y],
    {y, yRange[[1]], yRange[[2]]},
    {x, xRange[[1]], xRange[[2]]}]
];

Options[RaymarchImage] = Options[RaymarchTile];

RaymarchImage[{width_Integer?Positive, height_Integer?Positive},
   opts : OptionsPattern[]] := Image[
  RaymarchTile[{width, height}, All, opts],
  If[TrueQ[OptionValue["ByteOutput"]], "Byte", "Real"]
];

MakeTileCrops[{width_Integer?Positive, height_Integer?Positive},
   {tileWidth_Integer?Positive, tileHeight_Integer?Positive}] := Flatten[
  Table[
    {{x, Min[x + tileWidth - 1, width]},
     {y, Min[y + tileHeight - 1, height]}},
    {y, 1, height, tileHeight},
    {x, 1, width, tileWidth}
  ],
  1
];

StitchTiles[{width_Integer?Positive, height_Integer?Positive}, tiles_List] :=
  Module[{canvas, crop, tile, x0, x1, y0, y1},
    canvas = ConstantArray[{0., 0., 0.}, {height, width}];
    Do[
      {crop, tile} = tiles[[i]];
      {{x0, x1}, {y0, y1}} = ParseCrop[crop, width, height];
      canvas[[y0 ;; y1, x0 ;; x1]] = tile,
      {i, Length[tiles]}
    ];
    canvas
  ];

End[];
EndPackage[];


