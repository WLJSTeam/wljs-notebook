Type: Input
%-------------------------------------------------------------------------%
.md
Step 4: Launch and run __four workers__ (subkernels):

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Step 4: Launch and run __four workers__ (subkernels):

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
workers = Table[WorkerLaunch["worker.wl"], {4}];
time = AbsoluteTime[];
size = 2 {320, 240};
crops = TileRaymarching`MakeTileCrops[size, 2 {160,120}];
tiles = {};

EventHandler[#, Function[result,
  AppendTo[tiles, result];
]] &/@ workers;

MapThread[EventFire[#1, "SetSize", size]&, {workers}];
MapThread[EventFire[#1, "Run", #2]&, {workers, crops}];

While[Length[tiles] != 4, Pause[0.1]];
Quantity[AbsoluteTime[]-time, "Seconds"]
stitched = TileRaymarching`StitchTiles[size, tiles];
WorkerClose/@workers;

Image[ImageData[Image[stitched, "Real"], "Byte"], "Byte"]

