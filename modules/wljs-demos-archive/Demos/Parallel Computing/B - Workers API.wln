Step 3: Define a script file for the workers:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Step 3: Define a script file for the workers:

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
worker.wl
Get["RayMarching.wl"];
size = 2{320, 240};

EventHandler[Null, {
  "SetSize"->((size=#)&), "Run" -> Function[crop,
    result = TileRaymarching`RaymarchTile[size, crop, 
    "MaxSteps" -> 12,
    "SurfaceEpsilon" -> 0.02,
    "MaxDistance" -> 12.];
    EventFire[Null, {crop, result}
  ];
]}];

%-------------------------------------------------------------------------%
