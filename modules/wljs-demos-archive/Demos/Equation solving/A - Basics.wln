%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Solve a rectangular matrix equation

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
m = (*GB[*){{1(*|*),(*|*)5}(*||*),(*||*){2(*|*),(*|*)6}(*||*),(*||*){3(*|*),(*|*)7}(*||*),(*||*){4(*|*),(*|*)8}}(*||*)(*1:eJxTTMoPSmNkYGAo5gUSYZmp5S6pyflFiSX5RcFsQBHfxJKizAoAs04KOA==*)(*]GB*); b = (*GB[*){{9}(*||*),(*||*){10}(*||*),(*||*){11}(*||*),(*||*){12}}(*||*)(*1:eJxTTMoPSmNkYGAo5gUSYZmp5S6pyflFiSX5RcFsQBHfxJKizAoAs04KOA==*)(*]GB*);

LinearSolve[m,b]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
{{-1},{2}}

