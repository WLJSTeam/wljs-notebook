On the Javascript side we can take frames from a web-camera, GPU (WebGL/WebGPU) or generate using canvas:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
On the Javascript side we can take frames from a web-camera, GPU (WebGL/WebGPU) or generate using canvas:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
.js

function createCanvasPixels(width = 320, height = 240) {
  const canvas = new OffscreenCanvas(width, height);
  const context = canvas.getContext("2d");
  // Draw something
  context.fillStyle = "#18181b";
  context.fillRect(0, 0, width, height);

  context.fillStyle = "#38bdf8";
  context.beginPath();
  context.arc(width / 2, height / 2, 60, 0, Math.PI * 2);
  context.fill();
  const { data } = context.getImageData(0, 0, width, height);
  return new NumericArrayObject(data, [height, width, 4]); // Uint8ClampedArray
}

const pixels = createCanvasPixels();
server.kernel.io.fire('takeMyData', pixels);

