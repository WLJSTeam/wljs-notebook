# Release notes *2.8.1*
Thu 7 Aug 2025 16:23:43

Rate your experience with the previous release. Your feedback is important for us

<style >
    .rating { 
      display: flex;
      flex-direction: row-reverse;
      justify-content: center;
    }
    .rating input {
      display: none;
    }
    .rating label {
      font-size: 2rem;
      color: #ccc;
      cursor: pointer;
      transition: color 0.2s;
    }
    .rating input:checked ~ label,
    .rating label:hover,
    .rating label:hover ~ label {
      color: rgb(248 113 113);
    }
    .feedback {
      display: block;
      width: 100%;
      max-width: 400px;
      margin: 1rem auto;
      padding: 0.5rem;
      font-size: 1rem;
    }
    .submit-btn {
      display: block;
      margin: 0.5rem auto;
      padding: 0.5rem 1rem;
      font-size: 1rem;
      cursor: pointer;
    }</style><form onsubmit="return false" class="flex flex-col" id="rating-c"><fieldset ><div class="rating" id="rating-form"><input type="radio" id="star5" name="rating" value="5"/><label for="star5">★</label><input type="radio" id="star4" name="rating" value="4"/><label for="star4">★</label><input type="radio" id="star3" name="rating" value="3"/><label for="star3">★</label><input type="radio" id="star2" name="rating" value="2"/><label for="star2">★</label><input type="radio" id="star1" name="rating" value="1"/><label for="star1">★</label></div></fieldset><input type="text" id="feedback-form" name="feedback" style="width:20rem" class="border-1 ml-auto mr-auto align-center rounded-lg text-sm text-gray-700 ring-0 text-sm py-1" placeholder="one-line feedback..." maxlength="100"/></form>

Tell your thoughts, what you would like to see or anything else. The form will be sent automatically once you have finished.

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.html

<script type="module">
    const rating = [];
    for (let i=1; i<=5; ++i) rating.push(document.getElementById("star"+i));
    const feedback = document.getElementById("feedback-form");
    const container = document.getElementById("rating-c");

    let rate = -1;
    let text = "undefined";
    let timer = false;
    let disabled = false;

    const submitForm = () => {
      disabled = true;
      let n = 1;
      let interval = setInterval(() => {
        container.style.filter = "blur("+n+"px)";
        n++;
        if (n > 200) {
          clearInterval(interval);
        }
          
      }, 30);

      server.io.fire('submit-form-281', [rate, text]);
    }

    const setTimer = () => {
      if (disabled) return;
      if (timer) clearTimeout(timer);
      timer = false;
      timer = setTimeout(submitForm, 5000);
    }

    const clearTimer = () => {
      if (timer) clearTimeout(timer);
      timer = false;
    }

    rating.forEach((e) => {
      e.addEventListener('change', (ev)=>{
        rate = ev.srcElement.value;
        setTimer();
      });
    });

    feedback.addEventListener('input', ()=>{
      text = feedback.value;
      clearTimer();
    });

    feedback.addEventListener('focus', ()=>{
      clearTimer();
    });

    feedback.addEventListener('blur', () => {
      text = feedback.value;
      setTimer();
    })
</script>

