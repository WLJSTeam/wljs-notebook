fautorun.wl

EventHandler["submit-form-281", Function[payload,
  URLSubmit["https://datadrop.wolframcloud.com/api/v1.0/Add?bin=1xq2BKScR&data="<>(
  ExportString[
    <|
      "Rating"->payload[[1]],
      "Feedback"->payload[[2]],
      "SystemID"->$SystemID, 
      "MachineID"->$MachineID, 
      "Language"->$Language, 
      "TimeZone"->$TimeZone, 
      "WolframKernel"->$VersionNumber,
      "OperatingSystemVersion"->SystemInformation["Kernel", "OperatingSystemVersion"],
      "ElectronCode"->If[AssociationQ[System`$Env], Lookup[System`$Env, "ElectronCode", 0], "undefined"],
      "Version"->If[AssociationQ[System`$Env["AppJSON"] ], System`$Env[["AppJSON", "version"]], "undefined"]
    |>, "JSON"
  ] // URLEncode)];  
]];

