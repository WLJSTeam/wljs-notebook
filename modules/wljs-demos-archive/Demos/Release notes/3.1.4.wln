<|"Public" -> Hold[HTMLView["<div class=\"relative shrink-0 gap-y-3 pb-2 inline-flex flex-col items-center sm-controls\"><div class=\"flex flex-col items-center sm-controls\"><label class=\"block text-sm text-gray-800 \" style=\"\" for=\"n-#instanceId\"></label><input class=\"h-2 block p-2.5 text-xs text-gray-800 rounded-md border-gray-300 wljs-card \" style=\"width:4rem; \" min=\"0\" max=\"1\" step=\"1\" value=\"0\" id=\"n-#instanceId\" type=\"number\"></input></div><input min=\"0\" max=\"1\" step=\"1\" value=\"0\" class=\"sm-controls native \" style=\"writing-mode:vertical-lr; direction:rtl; height:8rem; width:1rem; \" id=\"r-#instanceId\" type=\"range\"></input></div>\n<script type=\"module\"> const num = document.getElementById('n-#instanceId');\n        const ran = document.getElementById('r-#instanceId');\n\n        let harpticQ = true;\n\n        function isNumber(value) { return typeof value === 'number'}\n\n        num.addEventListener('input', (event)=> {\n            if (isNaN(num.value)) return;\n            ran.value = num.value;\n            server.kernel.io.fire('924e522c-1b9e-4c4b-bd4b-a28a63187faa', Number(num.value), 'Default');      \n        });\n\n        ran.addEventListener('input', (event)=> {\n            if (isNaN(ran.value)) return;\n            num.value = ran.value;\n            server.kernel.io.fire('924e522c-1b9e-4c4b-bd4b-a28a63187faa', Number(ran.value), 'Default');   \n            if (harpticQ) {\n                if (!window.electronAPI) {harpticQ = false; return}\n                if (!window.electronAPI.harptic) {harpticQ = false; return}\n                window.electronAPI.harptic();\n            }               \n        });</script>", Prolog -> CoffeeLiqueur`Extensions`InputsOutputs`Tools`TemplateProcessor[Association["instanceId" -> CreateUUID[]]]]]|>

