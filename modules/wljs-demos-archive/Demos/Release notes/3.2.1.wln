Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F47b0f25c-02d8-4418-92b0-b5604cac0eac"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJm5gnGaQZmSbrGhilWOiamBha6FoaJRnoJpmaGZgkJyYbpCYmAwCQ1hXU"*)(*]VB*)

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
Graphics

