.md
Here is more complicated example, where raster graphics is combined with vector

> Show the local direction of the gradient of a function along with its level curves investigating different unconstrained optimization methods

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Here is more complicated example, where raster graphics is combined with vector

> Show the local direction of the gradient of a function along with its level curves investigating different unconstrained optimization methods

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{f, L, fplot},
 f[x_, y_] := (*SpB[*)Power[(1-x)(*|*),(*|*)2](*]SpB*) + 100 ((*SpB[*)Power[(y-Sin[\[Pi] x])(*|*),(*|*)2](*]SpB*));
 L = 1.5`;

 fplot = Show[
    LineIntegralConvolutionPlot[Evaluate[D[f[x, y], {{x, y}}]], {x, -L, L}, {y, -L, L}, ColorFunction->"Rainbow"],
    ContourPlot[f[x, y], {x, -L, L}, {y, -L, L}, ContourShading -> None, ContourStyle -> Pink]
 ];

 Manipulate[
  Module[{steps},
        steps = Reap[Quiet[FindMinimum[f[x, y], Evaluate[(*BB[*)(Transpose[{{x,y},p0}])(*,*)(*"1:eJxTTMoPSmNmYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCRYg4ZGfk5LGBOLxAomwzNRyl9Tk/KLEkvyiYE6gSEhRYl5xQX5xajBISwhEKUhjUGlOajDYhNTEFFSlaIpYgQzXstS8ErCQX2lODgB64iTl"*)(*]BB*)], Method -> method, StepMonitor :> Sow[{x, y}]]]][[2, 1]]; 
        steps = Prepend[steps, p0]; 
        Show[fplot, Graphics[{Green, Line[steps], {PointSize[0.025`], Point[Last[steps]]}}], PlotRange -> {{-L, L}, {-L, L}}]
  ], 
    {{p0, {-1, -1}}, Locator},
    {method, {Automatic, "Newton", "GaussNewton", "QuasiNewton", "PrincipalAxis"}}
 ]
]

