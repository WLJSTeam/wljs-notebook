Key: Ff6fa321f-e087-47ff-ac65-fe0a7d6f65cc
%-------------------------------------------------------------------------%
<|"Public" -> Hold[HTMLView["<div class=\"relative flex items-start sm-controls\"><div class=\"flex flex-col gap-2\"><div class=\"flex gap-3 flex-col gap-y-2\"><input class=\"\" style=\"cursor: pointer; width: 60px; height: 30px; \" id=\"color-#instanceId\" type=\"color\"></input></div></div><script type=\"module\"> function hexToRgb(hex) {\n                const result = /^#?([a-f\\d]{2})([a-f\\d]{2})([a-f\\d]{2})$/i.exec(hex);\n                return result ? {\n                    r: parseInt(result[1], 16) / 255.0,\n                    g: parseInt(result[2], 16) / 255.0,\n                    b: parseInt(result[3], 16) / 255.0\n                } : { r: 1, g: 1, b: 1 };\n            }\n\n            function rgbToHex(r, g, b) {\n                return \"#\" + [r, g, b].map(x => {\n                    const hex = Math.round(x * 255).toString(16);\n                    return hex.length === 1 ? \"0\" + hex : hex;\n                }).join('').toUpperCase();\n            }\n\n            function sendColorEvent() {\n                const colorEl = document.getElementById('color-#instanceId');\n                const rgb = hexToRgb(colorEl.value);\n                const showAlpha = 'False' === 'True';\n\n                if (showAlpha) {\n                    const alphaEl = document.getElementById('alpha-#instanceId');\n                    const alpha = parseInt(alphaEl.value) / 100.0;\n                    if (alpha < 1) {\n                        server.kernel.io.fire('9f109d64-690d-4b7b-a29a-c84212dcbbd0', [rgb.r, rgb.g, rgb.b, alpha], 'Default');\n                    } else {\n                        server.kernel.io.fire('9f109d64-690d-4b7b-a29a-c84212dcbbd0', [rgb.r, rgb.g, rgb.b], 'Default');\n                    }\n                } else {\n                    server.kernel.io.fire('9f109d64-690d-4b7b-a29a-c84212dcbbd0', [rgb.r, rgb.g, rgb.b], 'Default');\n                }\n            }\n\n            const colorEl = document.getElementById('color-#instanceId');\n            const showAlpha = 'False' === 'True';\n\n            // Set initial color from InitialColor option\n            const initialColor = '#ff8080';\n            if (initialColor && initialColor !== '') {\n                colorEl.value = initialColor;\n            }\n\n            colorEl.addEventListener('change', sendColorEvent);\n            colorEl.addEventListener('input', sendColorEvent);\n\n            if (showAlpha) {\n                const alphaEl = document.getElementById('alpha-#instanceId');\n               \n                // Parse initial color to extract alpha if provided in format \"rgba(...)\"\n                const initialAlpha = 'CoffeeLiqueur`Extensions`InputsOutputs`Private`InitialAlpha';\n                if (initialAlpha && initialAlpha !== '') {\n                    const alpha = Math.round(parseFloat(initialAlpha) * 100);\n                    alphaEl.value = alpha;\n                 \n                }\n\n                alphaEl.addEventListener('input', (event) => {\n               \n                    sendColorEvent();\n                });\n\n                alphaEl.addEventListener('change', sendColorEvent);\n            }</script></div>", Prolog -> CoffeeLiqueur`Extensions`InputsOutputs`Tools`TemplateProcessor[Association["instanceId" -> CreateUUID[]]]]]|>

