let applyXkcdFilter;
core.XkcdFilter = async (args, env) => {
  const opts = await core._getRules(args, env);
  applyXkcdFilter(env.containerSVG ||env.rootSVG.node()?.parentNode?.parentNode, opts);
}

applyXkcdFilter = (element, options = {}) => {
  if (!(element instanceof SVGElement)) {
    throw new TypeError("applyXkcdFilter expects an SVG element.");
  }

  const settings = {
    wobble: 10.6,
    roughness: 0.018,
    inkBleed: 0.35,
    paperGrain: 0.025,
    ...options,
  };

  const svg =
    element instanceof SVGSVGElement ? element : element.ownerSVGElement;

  if (!svg) {
    throw new Error("The element must belong to an <svg> document.");
  }

  const NS = "http://www.w3.org/2000/svg";
  const id = `xkcd-${crypto.randomUUID?.() ??
    Math.random().toString(36).slice(2)}`;

  let defs = svg.querySelector(":scope > defs");
  let createdDefs = false;

  if (!defs) {
    defs = document.createElementNS(NS, "defs");
    svg.prepend(defs);
    createdDefs = true;
  }

  const filter = document.createElementNS(NS, "filter");

  filter.id = id;
  filter.setAttribute("x", "-10%");
  filter.setAttribute("y", "-10%");
  filter.setAttribute("width", "120%");
  filter.setAttribute("height", "120%");
  filter.setAttribute("color-interpolation-filters", "sRGB");

  filter.innerHTML = `
    <!-- Low-frequency wobble: imperfect hand-drawn geometry -->
    <feTurbulence
      type="fractalNoise"
      baseFrequency="${settings.roughness}"
      numOctaves="2"
      seed="17"
      stitchTiles="stitch"
      result="wobbleNoise"
    />

    <feDisplacementMap
      in="SourceGraphic"
      in2="wobbleNoise"
      scale="${settings.wobble}"
      xChannelSelector="R"
      yChannelSelector="G"
      result="wobbled"
    />

    <!-- Very small blur makes digital edges less mechanically sharp -->
    <feGaussianBlur
      in="wobbled"
      stdDeviation="${settings.inkBleed}"
      result="softInk"
    />

    <!-- Restore contrast after the blur -->
    <feComponentTransfer in="softInk" result="roughInk">
      <feFuncR type="gamma" amplitude="1.08" exponent="0.9" offset="-0.025" />
      <feFuncG type="gamma" amplitude="1.08" exponent="0.9" offset="-0.025" />
      <feFuncB type="gamma" amplitude="1.08" exponent="0.9" offset="-0.025" />
      <feFuncA type="table" tableValues="0 0.08 0.92 1" />
    </feComponentTransfer>

    <!-- Fine paper/ink grain -->
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.7"
      numOctaves="3"
      seed="29"
      stitchTiles="stitch"
      result="paperNoise"
    />

    <feColorMatrix
      in="paperNoise"
      type="matrix"
      values="
        0 0 0 0 0.35
        0 0 0 0 0.35
        0 0 0 0 0.35
        0 0 0 ${settings.paperGrain} 0"
      result="faintPaperNoise"
    />

    <feBlend
      in="roughInk"
      in2="faintPaperNoise"
      mode="multiply"
    />
  `;

  defs.appendChild(filter);

  const previousFilter = element.getAttribute("filter");
  element.setAttribute("filter", `url(#${id})`);

  return function removeXkcdFilter() {
    if (previousFilter === null) {
      element.removeAttribute("filter");
    } else {
      element.setAttribute("filter", previousFilter);
    }

    filter.remove();

    if (createdDefs && defs.childElementCount === 0) {
      defs.remove();
    }
  };
}

