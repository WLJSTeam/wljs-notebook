.md
And finally to handle the incoming data we use `EventHandler` and hook it to some `Graphics` primitive:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
And finally to handle the incoming data we use `EventHandler` and hook it to some `Graphics` primitive:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{line = {}},
  EventHandler["audio", Function[data,
      line = Transpose[{Range[data//Length], data//Normal}];
  ]];

  Graphics[
      Line[line // Offload], 
      PlotRange -> {{0,512}, 0.25 {-1, 1}},
      "TransitionDuration"->30,
      Axes->True, AspectRatio->1/2
  ]
]

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Let's add fourier transform as well:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Let's add fourier transform as well:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{line = {}, fft={}},
    EventHandler["audio", Function[data, With[{ndata = Normal@data},
      line = Transpose[{Range[data//Length], ndata}];
      fft = Drop[Transpose[{Range[(Length[ndata]/2)//Floor], -(Log@Take[Fourier[ndata], (Length[ndata]/2)//Floor ]//Abs)}],4];
    ]]];
  
    {Graphics[
      {Blue, Line[line // Offload]},
      PlotRange -> {{0,512}, 0.25 {-1,1}},
      "TransitionType"->None,
      Axes->True, AspectRatio->1/2
    ],
    Graphics[
      {Red, Line[fft // Offload]},
      PlotRange -> {{1,256}, {-16,0}},
      "TransitionType"->None,
      Axes->True, AspectRatio->1/2
    ]}  // Row
]

