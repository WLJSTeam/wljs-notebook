### Gradients
Here is a complex example with radial gradients taken from __MDN Web docs__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
### Gradients
Here is a complex example with radial gradients taken from __MDN Web docs__

%-------------------------------------------------------------------------%
Props:
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
context = ctx`Canvas2D[];

radGrad1 = ctx`CreateRadialGradient[context, {45,  45, 10}, {52,  50, 30}];
ctx`AddColorStop[context, radGrad1, 0,   "#A7D30C"];
ctx`AddColorStop[context, radGrad1, 0.9, "#019F62"];
ctx`AddColorStop[context, radGrad1, 1,   "rgb(1 159 98 / 0%)"];

radGrad2 = ctx`CreateRadialGradient[context, {105, 105, 20}, {112, 120, 50}];
ctx`AddColorStop[context, radGrad2, 0,    "#FF5F98"];
ctx`AddColorStop[context, radGrad2, 0.75, "#FF0188"];
ctx`AddColorStop[context, radGrad2, 1,    "rgb(255 1 136 / 0%)"];

radGrad3 = ctx`CreateRadialGradient[context, {95,  15, 15}, {102,  20, 40}];
ctx`AddColorStop[context, radGrad3, 0,   "#00C9FF"];
ctx`AddColorStop[context, radGrad3, 0.8, "#00B5E2"];
ctx`AddColorStop[context, radGrad3, 1,   "rgb(0 201 255 / 0%)"];

radGrad4 = ctx`CreateRadialGradient[context, {0,   150, 50}, {0,   140, 90}];
ctx`AddColorStop[context, radGrad4, 0,   "#F4F201"];
ctx`AddColorStop[context, radGrad4, 0.8, "#E4C700"];
ctx`AddColorStop[context, radGrad4, 1,   "rgb(228 199 0 / 0%)"];

(* Draw filled rectangles with each gradient in turn *)
ctx`SetFillStyle[context, radGrad4];
ctx`FillRect[context, {0, 0}, {150, 150}];

ctx`SetFillStyle[context, radGrad3];
ctx`FillRect[context, {0, 0}, {150, 150}];

ctx`SetFillStyle[context, radGrad2];
ctx`FillRect[context, {0, 0}, {150, 150}];

ctx`SetFillStyle[context, radGrad1];
ctx`FillRect[context, {0, 0}, {150, 150}];

ctx`Dispatch[context];

Image[context, ImageResolution->{150,150}]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
