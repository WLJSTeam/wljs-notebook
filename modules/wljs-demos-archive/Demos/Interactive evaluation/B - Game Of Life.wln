  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
board = CellularAutomaton["GameOfLife", RandomInteger[{0,1}, {100,100}], {{1}}] // First;
Image[board // Offload, "Bit", Magnification -> 3, Antialiasing->False]

