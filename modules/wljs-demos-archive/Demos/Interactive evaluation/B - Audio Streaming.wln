  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
__Two oscillators with a decay__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
__Two oscillators with a decay__

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
samplingFunction = Function[t, With[{mod = Mod[t, Pi]},
  Sin[300.0 t ] Sin[45.0 t ] Exp[-t mod / 200.0 ]
]];

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
## Waveform screen
Let's modify our handler function to store waveform in `ilines` symbol

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Waveform screen
Let's modify our handler function to store waveform in `ilines` symbol

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
updateBuffer[_] := With[{},
  With[{c = (1.0/8000.0) (2Pi)},
    With[{sampled =  32760 Table[samplingFunction[c (i + time)], {i, 0, 512 - 1}]},
      buffer = NumericArray[sampled, "SignedInteger16", "ClipAndRound"];
      ilines = NumericArray[
        Transpose[{Range[512], sampled}]
      , "Integer16", "ClipAndRound"];
    ];
    
    time += 512;
  ];
];

