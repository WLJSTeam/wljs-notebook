sol = NDSolve[{eqns, initCond}, {\[Theta]1, \[Theta]2, \[Theta]3}, {t, 0, timeMax}] // First

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
{\[Theta]1->(*VB[*)BoxForm`temporalStorage$302004(*,*)(*"1:"*)(*]VB*),\[Theta]2->(*VB[*)BoxForm`temporalStorage$302132(*,*)(*"1:"*)(*]VB*),\[Theta]3->(*VB[*)BoxForm`temporalStorage$302260(*,*)(*"1:"*)(*]VB*)}

