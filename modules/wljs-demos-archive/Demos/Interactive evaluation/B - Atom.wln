%-------------------------------%Notebook%--------------------------------%
HaveToSaveAs: false
ObjectFields:
  - Objects
  - Symbols
  - Storage
  - ExcalidrawImages
  - RuntimeCache
  - ZIPArchive
Quick: true
%-------------------------------------------------------------------------%


%---------------------------------%Cells%---------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
# Atom model animation
*created by Kirill Belov*

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
># Atom model animation
*created by Kirill Belov*

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Precalculate paths of electrons

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Precalculate paths of electrons

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
path1 = N@Table[{5 Sin[t], 5 Cos[t], 0}, {t, 0.0, 2Pi, Pi/360.0}]; 
light1 = path1[[1]]; 

path2 = RotationTransform[(*FB[*)((2Pi)(*,*)/(*,*)(3))(*]FB*), {1, 0, 0}] /@ path1; 
light2 = path2[[1]]; 

path3 = RotationTransform[(*FB[*)((4Pi)(*,*)/(*,*)(3))(*]FB*), {1, 0, 1}] /@ path1; 
light3 = path3[[1]];

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Time variable

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Time variable

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
ClearAll[t];
t := Mod[Round[AbsoluteTime[] 100], Length[path1]] + 1

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Construct 3D graphics

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
>Construct 3D graphics

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Graphics3D[{  
  {  
    Graphics3D`Materials["Glass"],
    Directive["Roughness"->0.3, "Transmission"->0.9],
    Sphere[{0,0,0}, 1] 
  },   
  {  
    PointLight[Blue, Offload @ light1],   
    PointLight[Green, Offload @ light2],   
    PointLight[Red, Offload @ light3]  
  },   
  {  
    Directive["Roughness"->0, "Emissive"->Blue], 
    Sphere[Offload @ light1, 0.13],   
    Directive["Roughness"->0, "Emissive"->Green],
    Sphere[Offload @ light2, 0.13],  
    Directive["Roughness"->0, "Emissive"->Red],
    Sphere[Offload @ light3, 0.13],
    EventHandler[AnimationFrameListener[Offload @ light3], Function[Null,
      light1 = path1[[t]]; 
      light2 = path2[[t]]; 
      light3 = path3[[t]]; 
    ]]
  },   
  {  
    Graphics3D`Materials["Glass"],
    LightBlue, Tube[path1, 0.06],   
    LightGreen, Tube[path2, 0.06],   
    LightRed, Tube[path3, 0.06]  
  }  
},     
  PlotRange -> {{-10, 10}, {-10, 10}, {-10, 10}},   
  Lighting -> None, Background->Black, ImageSize->Medium 
] 

