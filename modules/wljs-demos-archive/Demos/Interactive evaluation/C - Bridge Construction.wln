    point[[3]] = point[[2]];
    point[[2]] = point[[1]];

    point[[1]] = 2 point[[2]] - point[[3]] - (*FB[*)((point[[1]])(*,*)/(*,*)((*SpB[*)Power[Norm[point[[1]]](*|*),(*|*)4](*]SpB*)))(*]FB*) 0.001;  
    point = point; (* to trigger an update *)
  ];

  Graphics[{
    Point[point // Offload],
    EventHandler[AnimationFrameListener[point // Offload], handler]
  },
    PlotRange->2{{-1,1}, {-1,1}}, 
    Epilog -> {Red, Disk[{0,0}, 0.1]},
    AspectRatio->1
  ]
] ]

