Module[{
  ctx = ctx`Canvas2D[]
},
  drawBonds[ctx, 5 bridge, bonds, {1,2,19,20}, {500,500}];
  ctx`Dispatch[ctx];
  Image[ctx, ImageResolution->{500,500}]
]

