## Original code
Copied from the post published on Wolfram Community

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
ClearAll[inkDrop]
inkDrop[{x_, y_},r_,n_:10] := Polygon[CirclePoints[{x, y}, r, n]] 

ClearAll[marbleDisplace]
(*Displace a single shape:*)
marbleDisplace[shape_Polygon,displacerCenter_List,displacerRadius_?NumericQ,displacementScale_:1]:=Module[{
(*The center of the drop causing displacement*)center=displacerCenter,
(*The points of the drop being displaced*)points=First[shape],	
(*The radius of the drop causing displacement*)r=displacerRadius},
Polygon[Map[center+(#-center)*Sqrt[1+(*FB[*)(((*SpB[*)Power[r(*|*),(*|*)2](*]SpB*))(*,*)/(*,*)(Norm[# - center]^2))(*]FB*)]&,points]]]

(*Displace a list of shapes:*)
marbleDisplace[shapes_List,displacerCenter_List,displacerRadius_,displacementScale_:1]:=Map[
	marbleDisplace[#,displacerCenter,displacerRadius,displacementScale]&,shapes]/;(And@@(Head[#]==Polygon&/@shapes)) 


 ClearAll[dripDrops]
Options[dripDrops]={"InkDropFunction"->inkDrop,"InkDropDetail"->250,"DisplacementEffect"->1};

(*Drip drops in a scene, with a list of positions, and a list of drop sizes:*)
dripDrops[shapes_List,dropPositions_List,dropSizes_:1,OptionsPattern[]]:=Fold[
	With[{nextDropCenter=First[#2],dropSize=Last[#2]},Append[
  marbleDisplace[#,nextDropCenter,dropSize,OptionValue["DisplacementEffect"]],
  Apply[OptionValue["InkDropFunction"],{nextDropCenter,dropSize,OptionValue["InkDropDetail"]}]]]&,
	shapes,
 Thread[{N@dropPositions,N@dropSizes}]
	]
 
(*Drip a single drop in a scene:*)
dripDrops[shapes_List,dropPosition_List?(MatchQ[#,{_?NumericQ,_?NumericQ}]&),dropSize_?NumericQ,OptionsPattern[]]:=Apply[
	dripDrops[shapes,{dropPosition},{dropSize},(*Pass options in:*)##]&, Function[Thread[Apply[Rule, {Slot[1], OptionValue[Slot[1]]}]]][Keys[Options[$CellContext`dripDrops]]]] 


ClearAll[tineLine]
tineLine[shape_Polygon,
	(*An arbitrary point on the tine line*)b_List,
	(*Unit vector in the direction of the tine line:*)m_List,
	z_:20,c_:1]:=Module[{points=First[shape],
	u=(*SpB[*)Power[((*FB[*)((1)(*,*)/(*,*)(2))(*]FB*))(*|*),(*|*)1/c](*]SpB*),
    n=RotationTransform[-Pi/2][m]},
	Polygon[#+z*u^Abs[(#-b).n]*m&/@points]
]

(*Pull a tine through a list of shapes:*)
tineLine[shapes_List,b_,m_,z_:20,c_:1]:=Map[tineLine[#,b,m,z,c]&,shapes]/;(And@@(Head[#]==Polygon&/@shapes)) 


ClearAll[combLine]
combLine[shapes_List,bs_List,ms_List,zs_:20,cs_:1]:=Fold[
	tineLine[##]&@@Join[{#1},#2]&,shapes,Thread[{bs,ms,zs,cs}]]/;
  (Equal@@Map[Length,Cases[{bs,ms,zs,cs},_List]]&&And@@Map[NumericQ,Cases[{bs,ms,zs,cs},!_List]]&&cs=!=0)

combLine[shapes_List,bs_List,ms_?(And@@Map[NumericQ,#]&&SameQ[Length[#],2]&),zs_:20,cs_:1]:=combLine[shapes,bs,Table[ms,Length[bs]],zs,cs]; 

