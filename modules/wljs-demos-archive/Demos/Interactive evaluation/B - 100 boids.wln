Type: Input
%-------------------------------------------------------------------------%
EventHandler[InputGroup[<|
  "p" -> InputRange[0, 0.1, 0.01, 0.03, "Label"->"p"], 
  "q" -> InputRange[0, 0.1, 0.01, 0.02, "Label"->"q"]
|>], Function[assoc, defaults = assoc]] 

