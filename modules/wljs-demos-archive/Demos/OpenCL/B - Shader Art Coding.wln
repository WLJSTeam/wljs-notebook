render = OpenCLFunctionLoad[File["art.cl"], 
  "render", {{"UnsignedByte[4]", _, "Output"}, _Integer, _Integer, "Float"}, 256, "ShellOutputFunction"->Print];

%-------------------------------------------------------------------------%
Display: print
Type: Output
%-------------------------------------------------------------------------%
OpenCLLink`Private`cGetProgramBuildLog[157893879,"art.cl","-DUSING_OPENCL_FUNCTION=1 -DOPENCLLINK_USING_GENERIC -Dmint=int -DReal_t=double -DUSING_DOUBLE_PRECISIONQ=1"]

