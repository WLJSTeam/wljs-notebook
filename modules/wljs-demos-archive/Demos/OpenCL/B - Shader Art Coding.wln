Animation cycle

__Run this one at the very last__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Animation cycle

__Run this one at the very last__

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Module[{buffer, t=0.0, handler},
  handler = Function[Null,
    render[image, 512, 512, t, 512 512];
    buffer = NumericArray[image // OpenCLMemoryGet, "UnsignedInteger8"];
    t += 0.1;
  ];

  handler[];

  Image[buffer // Offload, "Byte", Epilog->{
    EventHandler[AnimationFrameListener[buffer // Offload], handler]
  }]
]

