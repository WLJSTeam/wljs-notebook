%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
x Hypergeometric2F1[(*FB[*)((1)(*,*)/(*,*)(2))(*]FB*),-g,(*FB[*)((3)(*,*)/(*,*)(2))(*]FB*),(*SpB[*)Power[x(*|*),(*|*)2](*]SpB*)]

