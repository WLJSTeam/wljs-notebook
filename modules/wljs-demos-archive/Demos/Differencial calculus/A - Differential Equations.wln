 PlotPoints -> 1000, ColorFunction->"Rainbow"]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["Fa40d9565-fb87-4019-b4de-02b9bea96e0b"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJJ5oYpFiampnqpiVZmOuaGBha6iaZpKTqGhglWSalJlqapRokAQCYMRYb"*)(*]VB*)

