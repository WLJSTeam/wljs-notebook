InteractiveCrystalStructure := Module[{
  rotation = 0.01, slideId = CreateUUID[], 
  animate = CreateUUID[],
  crystal = NotebookRead[NotebookStore["spay-943"]]
}, With[{
  Widget = Graphics3D[
    {
      Translate[
        Rotate[crystal, (0.4 Sin[rotation])//Offload], 
        {-2.670070204823249`,1.6115948364312345`,5.4499976387159395`}
      ],
      AnimationFrameListener[rotation//Offload, "Event"->animate],
      HemisphereLight[White, LightBlue, 0.5],
      SpotLight[White, {6.417`,5.9913`,12.4225`}],
      SpotLight[White, {-6.417`,-5.9913`,12.4225`}]
    },

    ImageSize -> {500, 500},
    ViewPoint -> {5., 4., 2.},
    "BackgroundAlpha"->1,
    Background->Black,
    Lighting->None,
    "OrthographicCameraZoom"->0.3,
    "CameraNearPlane" -> -20,
    "CameraFarPlane" -> 0
  ]
},

 EventHandler[slideId, {
   "Destroy" | "Left" -> Function[Null,
     EventRemove[animate];
   ],

   "Slide" -> Function[Null,
     EventHandler[animate, Function[Null,
       rotation += 0.01;
     ]]; 
     EventFire[animate, True];
   ]
 }];

 <div>
    <Widget/>
    <SlideEventListener Id={slideId}/>
 </div>
] ]

