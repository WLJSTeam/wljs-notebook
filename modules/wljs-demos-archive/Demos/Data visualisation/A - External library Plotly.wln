.md
## Contour Plot

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Contour Plot

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
data = Flatten[Table[{x,y,x y}, {x,-10,10}, {y,-10,10}],1] // Transpose;

data = <|
    "x" -> data[[1]],
    "y" -> data[[2]],
	"z" -> data[[3]],
	"type" -> "contour"
|>;

Plotly[data]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(PlotlyInstance[FrontEndRef["Ff166550f-34e7-43c5-bc1f-1cca86ec798e"],WindowObj[<|"Socket" -> USocketObject[6]|>]])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJpxmamZmaGqTpGpukmuuaGCeb6iYlG6bpGiYnJ1qYpSabW1qkAgCXZBYm"*)(*]VB*)

