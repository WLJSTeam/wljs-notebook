	"z" -> Table[x y, {x,-10,10}, {y,-10,10}],
	"type" -> "heatmap"
|>;

Plotly[data]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(PlotlyInstance[FrontEndRef["Ffbeadf14-34fc-4b57-8655-2eb806c42ff5"],WindowObj[<|"Socket" -> USocketObject[6]|>]])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJpyWlJqakGZroGpukJeuaJJma61qYmZrqGqUmWRiYJZsYpaWZAgCqyBZS"*)(*]VB*)

