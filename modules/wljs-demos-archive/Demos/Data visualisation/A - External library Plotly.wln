## Scatter plots

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Scatter plots

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
trace1 = <|
	"x" -> Range[0, 2Pi, 0.1], 
	"y" -> (Sin @ Range[0, 2Pi, 0.1]),
	"mode" -> "markers", 
	"type" -> "scatter" 
|>;

Plotly[trace1]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(PlotlyInstance[FrontEndRef["F8af617e8-6c7b-495c-8451-87e996c591b9"],WindowObj[<|"Socket" -> USocketObject[6]|>]])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJWySmmRmap1romiWbJ+maWJom61qYmBrqWpinWlqaJZtaGiZZAgCXcRWG"*)(*]VB*)

