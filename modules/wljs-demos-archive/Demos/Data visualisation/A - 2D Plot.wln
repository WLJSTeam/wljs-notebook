## Parameteric plots
Generate a complex paramteric plot

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
ParametricPlot[
 With[{z = u + I v}, {Re[z + 1/z], Im[z + 1/z]}], {u, -1/2, 
  1/2}, {v, -1/2, 1/2}, PlotRange -> 5, Mesh -> Automatic]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["Fe4612f87-9061-41e8-981a-ddb545f6e717"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJp5qYGRqlWZjrWhqYGeqaGKZa6FpaGCbqpqQkmZqYppmlmhuaAwCOGBVu"*)(*]VB*)

