  PlotStyle->Red, 
  Frame->True, 
  FrameLabel->{"x-axis", "y-axis"}, 
  FrameStyle->Directive[FontSize->14], 
  FrameTicksStyle->Directive[FontSize->14],
  Epilog->{Cyan, Line[{{-10,10}, {10,10}}]}
]

