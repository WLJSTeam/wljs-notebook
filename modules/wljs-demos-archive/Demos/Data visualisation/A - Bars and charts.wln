Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Define a chart element function that stores bin width and count data using Sow

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Define a chart element function that stores bin width and count data using Sow

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
sowingBar[{{x0_, x1_}, {y0_, y1_}}, __] := (Sow[{x1 - x0, 
    100*(y1 - y0)}]; Rectangle[{x0, y0}, {x1, y1}])

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
{histogram, newdata} = 
  Reap[Histogram[data, Automatic, "Probability", 
    ChartElementFunction -> sowingBar]];

histogram 

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F76a60a35-491d-409a-814e-70042f0ac8e6"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJm5slmhkkGpvqmlgapuiaGFgm6loYmqTqmhsYmBilGSQmW6SaAQCLlRVT"*)(*]VB*)

