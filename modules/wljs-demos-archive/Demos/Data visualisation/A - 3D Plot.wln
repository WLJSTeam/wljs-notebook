  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
## Plot 3D
Generates a three-dimensional plot 

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Plot 3D
Generates a three-dimensional plot 

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Plot3D[Im[ArcSin[(x + I y)^4]], {x, -2, 2}, {y, -2, 2}, 
	Mesh -> None, 
	PlotStyle -> Directive[Yellow, Opacity[0.8]], 
	ExclusionsStyle -> {None, Red}
]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F4df8de35-6499-4776-a265-315b4697c637"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJm6SkWaSkGpvqmplYWuqamJub6SYamZnqGhuaJpmYWZonmxmbAwCSthUb"*)(*]VB*)

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
Another example

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Another example

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
NDSolve[{D[u[t, x], t] == D[u[t, x], x, x], u[0, x] == 0, u[t, 0] == Sin[t], u[t, 5] == 0}, u, {t, 0, 10}, {x, 0, 5}]; 

Plot3D[Evaluate[u[t, x] /. %], {t, 0, 10}, {x, 0, 5}, PlotRange -> All, ColorFunction -> "SunsetColors"]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F65c07236-2e89-4618-87a4-436eadf9da63"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJm5kmG5gbGZvpGqVaWOqamBla6FqYJ5romhibpSampFmmJJoZAwCIHxVt"*)(*]VB*)

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
A __list__ version is also supported

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
A __list__ version is also supporte

%-------------------------------------------------------------------------%
Props:
  Hidden: false
Type: Input
%-------------------------------------------------------------------------%
data = Table[Sin[j^2 + i], {i, 0, Pi, Pi/5}, {j, 0, Pi, Pi/5}];

ListPlot3D[data,  InterpolationOrder -> 3, 
 ColorFunction -> "SouthwestColors", BoxRatios->{1,1,0.5}]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F9b1b6495-dfa5-47ef-a159-d44d9237790e"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJWyYZJpmZWJrqpqQlmuqamKem6SYamlrqppiYpFgaGZubWxqkAgCdHhXQ"*)(*]VB*)

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Plot3D[Sin[Sqrt[x^2 + y^2]], {x, -6, 6}, {y, -6, 6}, 
 PlotRange -> All, 
 Mesh -> None, 
 ColorFunction -> "Rainbow"]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["F6a9105e9-80ad-4f37-85f2-6b4aaf6755a1"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJmyVaGhqYplrqWhgkpuiapBmb61qYphnpmiWZJCammZmbmiYaAgCVmhXB"*)(*]VB*)

