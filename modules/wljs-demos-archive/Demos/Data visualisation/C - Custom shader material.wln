Type: Input
%-------------------------------------------------------------------------%
Module[
  {cells, aSites, bSites, oSites, bonds, bPolyhedra, edges},
  cells = Tuples[Range[0, 1], 3];
  
  aSites = Tuples[Range[0, 2], 3];
  bSites = N[cells + ConstantArray[1/2, {Length[cells], 3}]];
  oSites = N@Join[
    Flatten[Table[{i + 1/2, j + 1/2, k}, {i, 0, 1}, {j, 0, 1}, {k, 0, 2}], 2],
    Flatten[Table[{i + 1/2, j, k + 1/2}, {i, 0, 1}, {j, 0, 2}, {k, 0, 1}], 2],
    Flatten[Table[{i, j + 1/2, k + 1/2}, {i, 0, 2}, {j, 0, 1}, {k, 0, 1}], 2]
  ];
  
  bonds = Flatten[
    ({Cylinder[{#, # + {1/2, 0, 0}}, .025],
       Cylinder[{#, # - {1/2, 0, 0}}, .025],
       Cylinder[{#, # + {0, 1/2, 0}}, .025],
       Cylinder[{#, # - {0, 1/2, 0}}, .025],
       Cylinder[{#, # + {0, 0, 1/2}}, .025],
       Cylinder[{#, # - {0, 0, 1/2}}, .025]} &) /@ bSites
  ];

  bPolyhedra = Flatten[
    Table[
      Polygon[site + # & /@ {{sx/2, 0, 0}, {0, sy/2, 0}, {0, 0, sz/2}}],
      {site, bSites}, {sx, {-1, 1}}, {sy, {-1, 1}}, {sz, {-1, 1}}
    ], 3
  ];
  
  edges = Line /@ {
    {{0, 0, 0}, {2, 0, 0}, {2, 2, 0}, {0, 2, 0}, {0, 0, 0}},
    {{0, 0, 2}, {2, 0, 2}, {2, 2, 2}, {0, 2, 2}, {0, 0, 2}},
    {{0, 0, 0}, {0, 0, 2}}, {{2, 0, 0}, {2, 0, 2}},
    {{2, 2, 0}, {2, 2, 2}}, {{0, 2, 0}, {0, 2, 2}}
  };
  
  Graphics3D[
    { 
      {{MeshMaterial[HandInked["Glass"]], bPolyhedra}, Lighter[Blue, 0.5]//Darker//Darker,
        Flatten[
  Table[
    With[{v = site + # & /@ {{sx/2, 0, 0}, {0, sy/2, 0}, {0, 0, sz/2}}},
      Line[Append[v, First[v]]]
    ],
    {site, bSites}, {sx, {-1, 1}}, {sy, {-1, 1}}, {sz, {-1, 1}}
  ],
  3
]
      },
      {Directive[MeshMaterial[HandInked["Gold"]], Opacity[1]], bonds},
      Opacity[1],
      {MeshMaterial[HandInked[LightBlue]], Sphere[aSites, .13]},
      {Black, MeshMaterial[HandInked["Lavender"]], Sphere[bSites, .19]},
      {MeshMaterial[HandInked["Gold"]], Sphere[oSites, .10]},
      {
        Black,
        Directive[Bold, FontSize -> 16],
        Text[Style["La/Ca", Bold], {2, 0, 2} + 2{.10, -.12, .12} + {-0.9,0.4,0.2}],
        Text[Style["Mn", Bold], {1.5, .5, 1.5} + {.18, -.12, .14} - {0,0.1,0.5}],
        Text[Style["O", Bold], {1.5, 0, 1.5} + {.18, -.10, .08}]
      }
    },
    Boxed -> False,
    ViewPoint -> {2.4, -2.8, 2.1},
    ViewVertical -> {0, 0, 1},
    PlotRange -> {{-.2, 2.2}, {-.2, 2.2}, {-.2, 2.2}},
    ImageSize -> {830, 555}/1.9
  ]
]

