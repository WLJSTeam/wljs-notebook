    subgraph GPU ["2. GPU Pipeline"]
        direction LR
        VS["<b>Vertex Shader</b><br/>Positions each vertex<br/><i>Output: gl_Position</i>"]:::shader
        Rast["<b>Rasterizer</b><br/>Turns triangles into pixels<br/>& interpolates <code>varying</code> data"]:::gpu
        FS["<b>Fragment Shader</b><br/>Colors each pixel<br/><i>Output: gl_FragColor</i>"]:::shader
        Screen["<b>Screen</b>"]:::gpu
    end

    Mat -->|"Attributes"| VS
    Mat -->|"Uniforms"| FS
    VS -->Rast
    Rast --> FS
    FS --> Screen



