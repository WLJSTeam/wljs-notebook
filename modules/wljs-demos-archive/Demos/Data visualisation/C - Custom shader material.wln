%-------------------------------------------------------------------------%
.md
Neat!

## HandInked Materials 🫟
By exploring these ideas and adding a noisy texture on top, I prepared a set of mesh materials for `Graphics3D` that render surfaces as if they were hand-inked with softly glazed pigment: a flat key/fill shading model with paper-fleck grain, a soft sheen, and darkened edges.

It includes a named palette (`Gold`, `Lavender`, `Teal`, `Coral`, etc.) plus custom colors and two special finishes: `Ice` (pearlescent, with grain adapted to atom size) and `Glass` (translucent, frosted sky-blue). To use it in your plot, copy and paste this shader code into your notebook:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Neat!

## HandInked Materials 🫟
By exploring these ideas and adding a noisy texture on top, I prepared a set of mesh materials for `Graphics3D` that render surfaces as if they were hand-inked with softly glazed pigment: a flat key/fill shading model with paper-fleck grain, a soft sheen, and darkened edges.

It includes a named palette (`Gold`, `Lavender`, `Teal`, `Coral`, etc.) plus custom colors and two special finishes: `Ice` (pearlescent, with grain adapted to atom size) and `Glass` (translucent, frosted sky-blue). To use it in your plot, copy and paste this shader code into your notebook:

%-------------------------------------------------------------------------%
Props:
  Hidden: false
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
.js
const paperPalette = {
  Gold: '#e8bd81',
  Oxygen: '#dcaa5b',
  Lavender: '#a47bd5',
  Coral: '#f04b37',
  Red: '#ed382a',
  Teal: '#239bb8',
  Cyan: '#38bedb',
  Blue: '#1652bb',
  Green: '#168c3c'
};
const paperReady = interpretate.shared.THREE.load().then(() => interpretate.shared.THREE.THREE);

// Ice-only raster material. 
function createPaperIceRasterMaterial(THREE, options = {}) {
  const roughness = Math.min(1, Math.max(0, options.roughness ?? 0.42));
  const grain = Math.min(0.1, Math.max(0, options.grain ?? 0.014));
  const opacity = Math.min(1, Math.max(0, options.opacity ?? 1));
  const outputChunk = THREE.ShaderChunk.colorspace_fragment
    ? 'colorspace_fragment' : 'encodings_fragment';
  const material = new THREE.ShaderMaterial({
    name: 'Pearl / Ice',
    uniforms: {
      baseColor: { value: new THREE.Color('#cee6ef') },
      pearlRoughness: { value: roughness },
      pearlGrain: { value: grain },
      pearlOpacity: { value: opacity },
      pearlHighlight: { value: options.highlight ?? 1.0 },
      pearlWash: { value: options.wash ?? 0.10 },
      keyDirection: { value: new THREE.Vector3(-0.65, 0.85, 1.25).normalize() },
      fillDirection: { value: new THREE.Vector3(0.8, -0.2, 0.6).normalize() }
    },
    vertexShader: `
      varying vec3 pearlNormal;
      varying vec3 pearlViewPosition;
      varying vec3 pearlLocalPosition;
      void main() {
        #include <beginnormal_vertex>
        #include <defaultnormal_vertex>
        pearlNormal = normalize(transformedNormal);
        pearlLocalPosition = position;
        #include <begin_vertex>
        #include <project_vertex>
        pearlViewPosition = -mvPosition.xyz;
      }
    `,
    fragmentShader: `
      uniform vec3 baseColor;
      uniform vec3 keyDirection;
      uniform vec3 fillDirection;
      uniform float pearlRoughness;
      uniform float pearlGrain;
      uniform float pearlOpacity;
      uniform float pearlHighlight;
      uniform float pearlWash;
      varying vec3 pearlNormal;
      varying vec3 pearlViewPosition;
      varying vec3 pearlLocalPosition;
      float grainHash(vec3 p) {
        p = fract(p * 0.1031);
        p += dot(p, p.yzx + 33.33);
        return fract((p.x + p.y) * p.z);
      }
      float grainNoise(vec3 p) {
        vec3 cell = floor(p);
        vec3 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(
          mix(mix(grainHash(cell), grainHash(cell + vec3(1,0,0)), f.x),
              mix(grainHash(cell + vec3(0,1,0)), grainHash(cell + vec3(1,1,0)), f.x), f.y),
          mix(mix(grainHash(cell + vec3(0,0,1)), grainHash(cell + vec3(1,0,1)), f.x),
              mix(grainHash(cell + vec3(0,1,1)), grainHash(cell + vec3(1,1,1)), f.x), f.y), f.z);
      }
      void main() {
        vec3 N = normalize(pearlNormal) * (gl_FrontFacing ? 1.0 : -1.0);
        vec3 V = isOrthographic ? vec3(0.0, 0.0, 1.0) : normalize(pearlViewPosition);
        vec3 H = normalize(keyDirection + V);
        float key = pow(clamp(dot(N, keyDirection) * 0.5 + 0.5, 0.0, 1.0), 1.3);
        float fill = max(dot(N, fillDirection), 0.0);
        float facing = max(dot(N, V), 0.0);
        float edge = pow(1.0 - facing, 2.0);
        float wash = grainNoise(pearlLocalPosition * 2.8 + vec3(11.7, 4.2, 8.1));
        float broad = pow(max(dot(N, H), 0.0), mix(16.0, 4.0, pearlRoughness));
        float tight = pow(max(dot(N, H), 0.0), mix(130.0, 30.0, pearlRoughness));
        vec3 pigment = baseColor *
          mix(vec3(0.93, 0.96, 1.06), vec3(1.06, 1.01, 0.96), wash) *
          (1.0 + pearlWash * (wash - 0.5));
        float shade = (0.34 + 0.66 * key + 0.07 * fill) * (1.0 - 0.18 * edge);
        vec3 rgb = pigment * shade;
        // Adapt grain to the visible size of each atom.
        float footprint = max(length(dFdx(pearlLocalPosition)), length(dFdy(pearlLocalPosition)));
        float fineWeight = 1.0 - smoothstep(0.35, 1.2, footprint * 64.0);
        float mediumWeight = 1.0 - smoothstep(0.35, 1.2, footprint * 16.0);
        float coarseWeight = 1.0 - smoothstep(0.35, 1.2, footprint * 4.0);
        float coarse = grainNoise(pearlLocalPosition * 4.0);
        float medium = grainNoise(pearlLocalPosition * 16.0);
        float fine = grainNoise(pearlLocalPosition * 64.0);
        float surfaceGrain = mix(coarse, medium, mediumWeight);
        surfaceGrain = mix(surfaceGrain, fine, fineWeight);
        rgb *= 1.0 + 3.5 * pearlGrain * coarseWeight * (2.0 * surfaceGrain - 1.0);
        float highlight = (0.40 * broad + 0.22 * tight) * pearlHighlight;
        highlight *= 1.0 + 0.20 * (wash - 0.5);
        rgb += vec3(1.0, 0.975, 0.94) * highlight;
        rgb += mix(pigment, vec3(0.7, 0.8, 0.94), 0.5) * edge * 0.075;
        gl_FragColor = vec4(max(rgb, vec3(0.0)), pearlOpacity);
        #include <${outputChunk}>
      }
    `,
    lights: false,
    toneMapped: false,
    transparent: opacity < 1,
    depthWrite: opacity >= 1,
    side: opacity < 1 ? THREE.DoubleSide : THREE.FrontSide
  });
  material.extensions.derivatives = true;
  return material;
}

core.HandInked = async (args, env) => {
  const THREE = await paperReady;
  let uni;
  let preset = 'Gold';
  if (args.length > 0) preset = await interpretate(args[0], env);
  if (preset === 'Ice') {
    const values = await Promise.all(args.slice(1).map(arg => interpretate(arg, env)));
    const [roughness = 0.42, grain = 0.014, opacity = 1, highlight = 1, wash = 0.10] = values;
    return function PaperIceFactory() {
      return createPaperIceRasterMaterial(THREE, {roughness, grain, opacity, highlight, wash});
    };
  }
  if (preset === 'Glass') {
    // Fixed-opacity sky-blue glass
    const requestedFrost = args.length > 1 ? await interpretate(args[1], env) : 0.2;
    const frostAmount = Number.isFinite(Number(requestedFrost))
      ? Math.max(0, Math.min(2.5, Number(requestedFrost))) : 0.20;
    const outputChunk = THREE.ShaderChunk.colorspace_fragment ? 'colorspace_fragment' : 'encodings_fragment';
    return function PaperGlassFactory() {
      // Alpha comes from this shader, not from surrounding Graphics3D Opacity directives.
      return new THREE.ShaderMaterial({
        name: 'Paper / Glass',
        uniforms: {
          glassTint: { value: new THREE.Color('#77c5df') },
          glassGlint: { value: new THREE.Color('#e9faff') },
          glassOpacity: { value: 0.09 },
          glassFrost: { value: frostAmount }
        },
        vertexShader: `
          varying vec3 vGlassNormal;
          varying vec3 vGlassLocal;
          void main() {
            vGlassNormal = normalize(normalMatrix * normal);
            vGlassLocal = position;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 glassTint;
          uniform vec3 glassGlint;
          uniform float glassOpacity;
          uniform float glassFrost;
          varying vec3 vGlassNormal;
          varying vec3 vGlassLocal;
          float hash31(vec3 p) {
            p = fract(p * 0.1031);
            p += dot(p, p.yzx + 33.33);
            return fract((p.x + p.y) * p.z);
          }
          float noise3(vec3 p) {
            vec3 cell = floor(p), f = fract(p);
            f = f * f * (3.0 - 2.0 * f);
            return mix(
              mix(mix(hash31(cell), hash31(cell + vec3(1,0,0)), f.x),
                  mix(hash31(cell + vec3(0,1,0)), hash31(cell + vec3(1,1,0)), f.x), f.y),
              mix(mix(hash31(cell + vec3(0,0,1)), hash31(cell + vec3(1,0,1)), f.x),
                  mix(hash31(cell + vec3(0,1,1)), hash31(cell + vec3(1,1,1)), f.x), f.y), f.z);
          }
          void main() {
            vec3 N = normalize(vGlassNormal);
            if (!gl_FrontFacing) N = -N;
            vec3 V = vec3(0.0, 0.0, 1.0);
            vec3 key = normalize(vec3(-0.45, 0.78, 0.95));
            float facing = abs(dot(N, V));
            float rim = pow(1.0 - facing, 1.65);
            float light = 0.86 + 0.15 * max(dot(N, key), 0.0);
            float glint = pow(max(dot(N, normalize(key + V)), 0.0), 22.0);
            float cloud = noise3(vGlassLocal * 8.0 + vec3(7.1, 1.3, 2.9));
            float fiber = noise3(vGlassLocal * 31.0 + vec3(2.4, 8.7, 4.2));
            float frost = 1.5 * (cloud - 0.5) + 0.5 * (fiber - 0.5);
            float speck = hash31(vec3(floor(gl_FragCoord.xy / 2.5), 1.71));
            vec3 rgb = glassTint * light * (1.0 + 0.35 * glassFrost * frost);
            rgb = mix(rgb, glassGlint, 0.14 * glint);
            rgb *= 1.0 - 0.20 * rim;
            float veil = clamp(1.0 + 2.2 * glassFrost * frost, 0.30, 2.10);
            float alpha = clamp(glassOpacity * (0.78 + 1.45 * rim + 0.16 * glint)
              * veil * (1.0 + 0.20 * glassFrost * (speck - 0.5)), 0.0, 0.52);
            gl_FragColor = vec4(max(rgb, vec3(0.0)), alpha);
            #include <${outputChunk}>
          }
        `,
        lights: false,
        toneMapped: false,
        transparent: true,
        depthWrite: false,
        side: THREE.DoubleSide
      });
    };
  }
  
  if (paperPalette[preset]) {
    const color = new THREE.Color(paperPalette[preset]);
    uni = { pigment: { value: color }, shineTint: { value: new THREE.Color(preset === 'Lavender' ? '#ffffff' : (preset === 'Teal' || preset === 'Cyan') ? '#d9faff' : '#fff5de') }, shineScale: { value: (preset === 'Red' || preset === 'Cyan') ? 0.43 : 1.0 } };
  } else {
    uni = { pigment: { value: preset }, shineTint: { value: (await interpretate(args[1], env)) || new THREE.Color('#fff5de') }, shineScale: { value: (await interpretate(args[2], env)) || 1.0 } };
    preset = interpretate.hashv2(uni);
  }
  
  const outputChunk = THREE.ShaderChunk.colorspace_fragment ? 'colorspace_fragment' : 'encodings_fragment';
  return function PaperMaterialFactory() {
    const material = new THREE.ShaderMaterial({
      name: 'Paper / ' + preset,
      uniforms: uni,
      vertexShader: `
        varying vec3 vPaperNormal;
        varying vec3 vPaperPosition;
        void main() {
          vPaperNormal = normalize(normalMatrix * normal);
          vPaperPosition = position;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform vec3 pigment;
        uniform vec3 shineTint;
        uniform float shineScale;
        varying vec3 vPaperNormal;
        varying vec3 vPaperPosition;
        float hash31(vec3 p) {
          p = fract(p * 0.1031);
          p += dot(p, p.yzx + 33.33);
          return fract((p.x + p.y) * p.z);
        }
        float noise3(vec3 p) {
          vec3 i = floor(p), f = fract(p);
          f = f*f*(3.0-2.0*f);
          return mix(
            mix(mix(hash31(i),hash31(i+vec3(1,0,0)),f.x),
                mix(hash31(i+vec3(0,1,0)),hash31(i+vec3(1,1,0)),f.x),f.y),
            mix(mix(hash31(i+vec3(0,0,1)),hash31(i+vec3(1,0,1)),f.x),
                mix(hash31(i+vec3(0,1,1)),hash31(i+vec3(1,1,1)),f.x),f.y),f.z);
        }
        void main() {
          vec3 N = normalize(vPaperNormal);
          vec3 key = normalize(vec3(-0.45, 0.78, 0.95));
          vec3 fill = normalize(vec3(0.78, 0.15, 0.5));
          vec3 V = vec3(0.0, 0.0, 1.0);
          float lit = max(dot(N,key),0.0);
          float shade = 0.41 + 0.58 * pow(lit,0.72) + 0.08 * max(dot(N,fill),0.0);
          float facing = max(dot(N,V),0.0);
          float ink = 1.0 - 0.34 * pow(1.0-facing,2.2);
          vec3 H = normalize(key+V);
          float softbox = pow(max(dot(N,H),0.0),8.0);
          float core = pow(max(dot(N,H),0.0),42.0);
          float fleck = noise3(vPaperPosition*26.0);
          float micro = noise3(vPaperPosition*55.0);
          float paper = 1.0 + 0.11*(fleck-0.5) + 0.065*(micro-0.5);
          vec3 rgb = pigment * shade * ink * paper;
          rgb += shineTint * shineScale * (0.36*softbox + 0.13*core);
          gl_FragColor = vec4(max(rgb,vec3(0.0)),1.0);
          #include <${outputChunk}>
        }
      `,
      lights: false,
      toneMapped: false
    });
    return material;
  };
};
return 'HandInked registered';

%-------------------------------------------------------------------------%
Display: js
Type: Output
%-------------------------------------------------------------------------%

const paperPalette = {
  Gold: '#e8bd81',
  Oxygen: '#dcaa5b',
  Lavender: '#a47bd5',
  Coral: '#f04b37',
  Red: '#ed382a',
  Teal: '#239bb8',
  Cyan: '#38bedb',
  Blue: '#1652bb',
  Green: '#168c3c'
};
const paperReady = interpretate.shared.THREE.load().then(() => interpretate.shared.THREE.THREE);

// Ice-only raster material. 
function createPaperIceRasterMaterial(THREE, options = {}) {
  const roughness = Math.min(1, Math.max(0, options.roughness ?? 0.42));
  const grain = Math.min(0.1, Math.max(0, options.grain ?? 0.014));
  const opacity = Math.min(1, Math.max(0, options.opacity ?? 1));
  const outputChunk = THREE.ShaderChunk.colorspace_fragment
    ? 'colorspace_fragment' : 'encodings_fragment';
  const material = new THREE.ShaderMaterial({
    name: 'Pearl / Ice',
    uniforms: {
      baseColor: { value: new THREE.Color('#cee6ef') },
      pearlRoughness: { value: roughness },
      pearlGrain: { value: grain },
      pearlOpacity: { value: opacity },
      pearlHighlight: { value: options.highlight ?? 1.0 },
      pearlWash: { value: options.wash ?? 0.10 },
      keyDirection: { value: new THREE.Vector3(-0.65, 0.85, 1.25).normalize() },
      fillDirection: { value: new THREE.Vector3(0.8, -0.2, 0.6).normalize() }
    },
    vertexShader: `
      varying vec3 pearlNormal;
      varying vec3 pearlViewPosition;
      varying vec3 pearlLocalPosition;
      void main() {
        #include <beginnormal_vertex>
        #include <defaultnormal_vertex>
        pearlNormal = normalize(transformedNormal);
        pearlLocalPosition = position;
        #include <begin_vertex>
        #include <project_vertex>
        pearlViewPosition = -mvPosition.xyz;
      }
    `,
    fragmentShader: `
      uniform vec3 baseColor;
      uniform vec3 keyDirection;
      uniform vec3 fillDirection;
      uniform float pearlRoughness;
      uniform float pearlGrain;
      uniform float pearlOpacity;
      uniform float pearlHighlight;
      uniform float pearlWash;
      varying vec3 pearlNormal;
      varying vec3 pearlViewPosition;
      varying vec3 pearlLocalPosition;
      float grainHash(vec3 p) {
        p = fract(p * 0.1031);
        p += dot(p, p.yzx + 33.33);
        return fract((p.x + p.y) * p.z);
      }
      float grainNoise(vec3 p) {
        vec3 cell = floor(p);
        vec3 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(
          mix(mix(grainHash(cell), grainHash(cell + vec3(1,0,0)), f.x),
              mix(grainHash(cell + vec3(0,1,0)), grainHash(cell + vec3(1,1,0)), f.x), f.y),
          mix(mix(grainHash(cell + vec3(0,0,1)), grainHash(cell + vec3(1,0,1)), f.x),
              mix(grainHash(cell + vec3(0,1,1)), grainHash(cell + vec3(1,1,1)), f.x), f.y), f.z);
      }
      void main() {
        vec3 N = normalize(pearlNormal) * (gl_FrontFacing ? 1.0 : -1.0);
        vec3 V = isOrthographic ? vec3(0.0, 0.0, 1.0) : normalize(pearlViewPosition);
        vec3 H = normalize(keyDirection + V);
        float key = pow(clamp(dot(N, keyDirection) * 0.5 + 0.5, 0.0, 1.0), 1.3);
        float fill = max(dot(N, fillDirection), 0.0);
        float facing = max(dot(N, V), 0.0);
        float edge = pow(1.0 - facing, 2.0);
        float wash = grainNoise(pearlLocalPosition * 2.8 + vec3(11.7, 4.2, 8.1));
        float broad = pow(max(dot(N, H), 0.0), mix(16.0, 4.0, pearlRoughness));
        float tight = pow(max(dot(N, H), 0.0), mix(130.0, 30.0, pearlRoughness));
        vec3 pigment = baseColor *
          mix(vec3(0.93, 0.96, 1.06), vec3(1.06, 1.01, 0.96), wash) *
          (1.0 + pearlWash * (wash - 0.5));
        float shade = (0.34 + 0.66 * key + 0.07 * fill) * (1.0 - 0.18 * edge);
        vec3 rgb = pigment * shade;
        // Adapt grain to the visible size of each atom.
        float footprint = max(length(dFdx(pearlLocalPosition)), length(dFdy(pearlLocalPosition)));
        float fineWeight = 1.0 - smoothstep(0.35, 1.2, footprint * 64.0);
        float mediumWeight = 1.0 - smoothstep(0.35, 1.2, footprint * 16.0);
        float coarseWeight = 1.0 - smoothstep(0.35, 1.2, footprint * 4.0);
        float coarse = grainNoise(pearlLocalPosition * 4.0);
        float medium = grainNoise(pearlLocalPosition * 16.0);
        float fine = grainNoise(pearlLocalPosition * 64.0);
        float surfaceGrain = mix(coarse, medium, mediumWeight);
        surfaceGrain = mix(surfaceGrain, fine, fineWeight);
        rgb *= 1.0 + 3.5 * pearlGrain * coarseWeight * (2.0 * surfaceGrain - 1.0);
        float highlight = (0.40 * broad + 0.22 * tight) * pearlHighlight;
        highlight *= 1.0 + 0.20 * (wash - 0.5);
        rgb += vec3(1.0, 0.975, 0.94) * highlight;
        rgb += mix(pigment, vec3(0.7, 0.8, 0.94), 0.5) * edge * 0.075;
        gl_FragColor = vec4(max(rgb, vec3(0.0)), pearlOpacity);
        #include <${outputChunk}>
      }
    `,
    lights: false,
    toneMapped: false,
    transparent: opacity < 1,
    depthWrite: opacity >= 1,
    side: opacity < 1 ? THREE.DoubleSide : THREE.FrontSide
  });
  material.extensions.derivatives = true;
  return material;
}

