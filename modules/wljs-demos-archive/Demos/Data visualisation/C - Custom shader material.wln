%-------------------------------------------------------------------------%
To modify the color and other properties, you need access to THREE.js classes and their objects. Most *heavy* libraries are shared through the `interpretate.shared` interface.

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
.js
let THREE;

core.Pearl = async (args, env) => {
  if (!THREE) {
    await interpretate.shared.THREE.load()
    THREE = interpretate.shared.THREE.THREE;
  }
  env.color = new THREE.Color('gold');
}

