.md
Here is a little demo:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Here is a little demo:

%-------------------------------------------------------------------------%
Props:
  Hidden: false
Type: Input
%-------------------------------------------------------------------------%
specs = {
  {HandInked["Gold"],              "Gold"},
  {HandInked["Lavender"],          "Lavender"},
  {HandInked["Coral"],             "Coral"},
  {HandInked["Teal"],              "Teal"},
  {HandInked["Green"],             "Green"},
  {HandInked[LightBlue, Red],      "LightBlue, Red"},
  {HandInked[Orange, White, 10.0], "Orange, White"},
  {HandInked["Glass"],             "Glass"},
  {HandInked["Ice"],               "Ice"}
};

Graphics3D[
  MapIndexed[
    With[{y = #2[[1]] - 4},
      {
        MaterialShading[#1[[1]]], 
        Sphere[{y 0.35, y, 0}, 0.4],
        Black, Directive[FontSize->14],
        Text[#1[[2]], {y 0.35 - 0.2, y + 0.2, -0.6}, {1,0}]
      }
    ] &,
    specs
  ]
]

