  PointLight[Green, 3{2,0,5}],
  MaterialShading[<|"RoughnessCoefficient"->0, "BaseColor"->Green|>], Sphere[{0,-2,0}],
  MaterialShading["Plastic"], Sphere[{0,2,0}]
}, Lighting->None]

