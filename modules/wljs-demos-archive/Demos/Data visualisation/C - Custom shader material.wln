.md
Note that `MaterialShading` expects the inner expression to return either an object with properties (see above), a preset name, or __a material factory__. Let's try the simplest one, using only a *fragment shader*:

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Note that `MaterialShading` expects the inner expression to return either an object with properties (see above), a preset name, or __a material factory__. Let's try the simplest one, using only a *fragment shader*:

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
.js
let THREE;

core.PearlMaterial1 = async (args, env) => {
  if (!THREE) {
    await interpretate.shared.THREE.load()
    THREE = interpretate.shared.THREE.THREE;
  }

  return function() {
    return new THREE.ShaderMaterial({
        name: 'PearlMaterial / Test 1',
        uniforms: {},
        fragmentShader: `
          void main() {
            gl_FragColor = vec4(1.0, 0.77, 0.34, 1.0);
          }
        `,
        lights: false,
        toneMapped: false
      });    
  }
}

