## Cage
The cosahedral cage, camera, atom sizes and bond connectivity, rendered with the pearl materials

%-------------------------------------------------------------------------%
Props:
  Hidden: false
Type: Input
%-------------------------------------------------------------------------%
PearlCageFigure = Module[
 {phi, cageSites, edgePairs, view, carbonIndices, boronIndices,
  hSites, cageBonds, terminalBonds, faces, sitePreset},
 phi = GoldenRatio;
 cageSites = N@Join[
   Flatten[Table[{0, s, t phi}, {s, {-1, 1}}, {t, {-1, 1}}], 1],
   Flatten[Table[{s, t phi, 0}, {s, {-1, 1}}, {t, {-1, 1}}], 1],
   Flatten[Table[{t phi, 0, s}, {s, {-1, 1}}, {t, {-1, 1}}], 1]];
 edgePairs = Select[Subsets[Range[Length[cageSites]], {2}],
   Abs[EuclideanDistance @@ cageSites[[#]] - 2] < 10^-6 &];
 view = Normalize[{2.4, -2.8, 2.1}];
 carbonIndices = First@MaximalBy[edgePairs, Dot[Mean[cageSites[[#]]], view] &];
 boronIndices = Complement[Range[12], carbonIndices];
 hSites = (# + .78 Normalize[#]) & /@ cageSites;
 sitePreset[i_] := If[MemberQ[carbonIndices, i], "Ice", "Lavender"];
 cageBonds = ({MeshMaterial[PearlBondMaterial["Bond",
     sitePreset[#[[1]]], sitePreset[#[[2]]], .30,  .35, 3 .012]],
     Cylinder[cageSites[[#]], .055]} &) /@ edgePairs;
 terminalBonds = Table[{
   MeshMaterial[PearlBondMaterial["GoldBond", sitePreset[i], "Gold", .25, .32, .012]],
   Cylinder[{cageSites[[i]], hSites[[i]]}, .045]}, {i, 12}];
 faces = MeshPrimitives[ConvexHullMesh[cageSites], 2];
 Graphics3D[{
   {MeshMaterial[PearlMaterial["Glass", .60, 0., .12, 0.]], faces},
   cageBonds,
   terminalBonds,
   {MeshMaterial[PearlMaterial["Lavender", .36, 2 .014]], Sphere[cageSites[[boronIndices]], .23]},
   {MeshMaterial[PearlMaterial["Ice", .34, 2 .008]], Sphere[cageSites[[carbonIndices]], .27]},
   {MeshMaterial[PearlMaterial["Gold", .32, 2 .012]], Sphere[hSites, .13]},
   {Black, Directive[FontSize -> 18],
    (Text[Style["C", Bold], # + .4 {1,0,-1}] &)@
      First@MaximalBy[cageSites[[carbonIndices]], Dot[#, view] &],
    (Text[Style["B", Bold], # + {0.4,-0.2,-1.8}] &)@
      First@MaximalBy[cageSites[[boronIndices]], Dot[#, view] &],
    (Text[Style["H", Bold], # + .45 Normalize[#]] &)@
