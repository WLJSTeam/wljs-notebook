  VertexShapeFunction -> "Diamond", VertexSize -> Medium]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(Graph[{1, 2, 3}, {DirectedEdge[1, 2], DirectedEdge[2, 3], DirectedEdge[3, 1]}, {VertexShapeFunction -> {"Diamond"}, VertexSize -> {Medium}}])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJJxuZmSUZJ5vqGqUkG+uapJgZ6lqamlvqGhsnGliYW1gYJxlaAACUKhU1"*)(*]VB*)

