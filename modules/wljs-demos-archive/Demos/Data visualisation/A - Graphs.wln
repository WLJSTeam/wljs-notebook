%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Extra styling options

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
Graph[
    {1, 2, 3, 4, 5, 6},
    {
        UndirectedEdge[1, 2],
        UndirectedEdge[1, 6],
        UndirectedEdge[2, 3],
        UndirectedEdge[3, 4],
        UndirectedEdge[4, 5],
        UndirectedEdge[5, 6]
    },
    {
        GraphLayout -> {"Dimension" -> 2, "VertexLayout" -> {"CircularEmbedding", "OptimalOrder" -> False}},
        GraphStyle -> "SmallNetwork"
    }
] // GraphPlot 

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["Fc679b94f-07d2-4322-9cf3-66186ec0187a"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgUJJ5uZWyZZmqTpGpinGOmaGBsZ6VompxnrmpkZWpilJhsYWpgnAgCSrBVp"*)(*]VB*)

