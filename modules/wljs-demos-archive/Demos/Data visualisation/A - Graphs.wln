Type: Input
%-------------------------------------------------------------------------%
Graph[Table[
  Annotation[
   v, {VertexSize -> 0.2 + 0.2 Mod[v, 5], 
    VertexStyle -> Hue[v/15, 1, 1]}], {v, 0, 14}], 
 Table[v <-> Mod[v + 1, 15], {v, 0, 14}]] 
% // GraphPlot 

