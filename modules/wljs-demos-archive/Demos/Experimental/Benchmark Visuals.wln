## Image animation
Stream raw data

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Image animation
Stream raw data

%-------------------------------------------------------------------------%
Props:
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
frames = Table[RandomImage[{0,1}, {500,500}], {30}];
buffer = ImageData[frames[[1]], "Byte"];
index = 1;

fps = 0;
fpsLabel = "0";
time = AbsoluteTime[];
fpsHistory = {};


Pause[1];

With[{}, cell = ResultCell[]; Labeled[
Image[buffer//Offload, "Byte", Epilog->{
  EventHandler[AnimationFrameListener[buffer//Offload], Function[Null,
    index++;
    If[index > Length[frames], index = 1];
    buffer = ImageData[frames[[index]], "Byte"];

    (* FPS counter *)
    fps += 1;
    With[{diff = AbsoluteTime[] - time},
      If[diff >= 1.0,
        fpsLabel = ToString[fps / (diff)];
        AppendTo[fpsHistory, fps / (diff)];
        fps = 0;
        time = AbsoluteTime[];
      ];
    ];     
  ]]
}], TextView[fpsLabel//Offload]]]

