%-------------------------------------------------------------------------%
## 3D Geometry Basic
Flying balls

%-------------------------------------------------------------------------%
Props:
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
balls = RandomReal[{-1,1}, {300,3}];
vels  = RandomReal[{-1,1}, {300,3}];

updateFunction = Function[Null,
  vels = Table[
    If[Norm[balls[[i]]] < 0.01, -1, 1] vels[[i]] - 0.08 balls[[i]]
  , {i, Length[balls]}];
  
  balls = Table[balls[[i]] + 0.08 vels[[i]], {i, Length[balls]}];
  
    (* FPS counter *)
    fps += 1;
    With[{diff = AbsoluteTime[] - time},
      If[diff >= 1.0,
        fpsLabel = ToString[fps / (diff)];
        AppendTo[fpsHistory, fps / (diff)];
        fps = 0;
        time = AbsoluteTime[];
      ];
    ]; 
  
];

fps = 0;
fpsLabel = "0";
time = AbsoluteTime[];
fpsHistory = {};

Pause[1];

With[{}, cell = ResultCell[]; Graphics3D[{
  Text[fpsLabel//Offload, {1,1,1}],
  Table[With[{i = i},
    {
      RGBColor[RandomReal[{0,1}, 3]],
      Sphere[balls[[i]] // Offload, 0.03]
    }
  ], {i, Length[balls]}], 
  EventHandler[AnimationFrameListener[balls // Offload], updateFunction]
}]]

