core.BenchmarkReceiveBinary = async (args, env) => {
  await interpretate(args[0], env);
  env.element.innerText = "Ready";
};

core.BenchmarkReceiveBinary.update = async (args, env) => {
  await interpretate(args[0], env);
  server.kernel.io.poke('BenchmarkReceiveBinary');
};

core.BenchmarkReceiveBinary.destroy = () => {};
core.BenchmarkReceiveBinary.virtual = true;

return "BenchmarkReceiveBinary registered";

