BenchmarkReceiveBinary /: MakeBoxes[s_BenchmarkReceiveBinary, StandardForm] := ViewBox[s, s];

tests`binaryPayload = {};

BenchmarkReceiveBinary[tests`binaryPayload // Offload]

tests`measureKernelToFrontendBinary[makePayload_] := Module[{sample},
  TableAsync[
    sample = tests`measureKernelToFrontendBinarySample[makePayload[size], 30] // Await;
    {size, sample}
  , {size, 10, 10000, 200}]
];

tests`measureKernelToFrontendBinarySample[expr_, maxSamples_:200] := Module[{
  timestamps = {},
  sampleCount = 0,
  sentAt,
  result = Promise[]
},
  EventHandler["BenchmarkReceiveBinary", Function[Null,
    AppendTo[timestamps, AbsoluteTime[] - sentAt];
    sampleCount++;
    If[sampleCount >= maxSamples,
      EventRemove["BenchmarkReceiveBinary"];
      EventFire[result, Resolve, 1/Around[timestamps]];
      ClearAll[timestamps, sampleCount, sentAt, result];
      Return[];
    ];

    sentAt = AbsoluteTime[];
    tests`binaryPayload = expr;
  ]];

  sentAt = AbsoluteTime[];
  tests`binaryPayload = expr;
  result
];

