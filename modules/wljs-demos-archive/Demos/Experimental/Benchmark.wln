.md
Quick check for the round-trip benchmark. This cell is useful when changing the event wiring before running the full suite.

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
Quick check for the round-trip benchmark. This cell is useful when changing the event wiring before running the full suite.

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
tests`measureRoundTripRate[maxSamples_:1000] := Module[{
  timestamps = {},
  sampleCount = 0,
  sentAt,
  result = Promise[]
},
  EventHandler["BenchmarkRoundTripPing", Function[Null,
    AppendTo[timestamps, AbsoluteTime[] - sentAt];
    sampleCount++;
    If[sampleCount >= maxSamples,
      EventRemove["BenchmarkRoundTripPing"];
      EventFire[result, Resolve, 1/Around[timestamps]];
      ClearAll[timestamps, sampleCount, sentAt, result];
      Return[];
    ];

    sentAt = AbsoluteTime[];
    FrontSubmit[BenchmarkRoundTripPing[]];
  ]];

  sentAt = AbsoluteTime[];
  FrontSubmit[BenchmarkRoundTripPing[]];
  result
];

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
tests`measureRoundTripRate[] // WaitAll

%-------------------------------------------------------------------------%
Type: Output
