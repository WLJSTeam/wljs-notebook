.md
## Integrated benchmarks
These scenarios exercise the Wolfram kernel and WLJS frontend together using small real-world animation workloads. Each benchmark returns an FPS history array after the warmup samples are dropped.

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Integrated benchmarks
These scenarios exercise the Wolfram kernel and WLJS frontend together using small real-world animation workloads. Each benchmark returns an FPS history array after the warmup samples are dropped.

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
tests`integratedBoids1[] := With[{promise = Promise[]},
  ClearAll[handler, n, r, f, s, x, p , q];

  n = 1000;
  r := RandomInteger[{1, n}];
  f := (#/(.01 + Sqrt[#.#])) & /@ (x[[#]] - x) &;
  s := With[{r1 = r}, p[[r1]] = r; q[[r1]] = r];
  x = RandomReal[{-1, 1}, {n, 2}];
  {p, q} = RandomInteger[{1, n}, {2, n}];

  fps = 0;
  fpsLabel = "0";
  time = AbsoluteTime[];
  fpsHistory = {};
  fpsHistoryClean = {};
  firstTime = True;

   handler = Function[Null,  
    fps = Round[1/(AbsoluteTime[]-time)];
    time = AbsoluteTime[];
    x = 0.995 x + 0.02 f[p] - 0.01 f[q];
    If[r < 100, s];
    AppendTo[fpsHistoryClean, Round[1/(AbsoluteTime[]-time)]];

    
    (* FPS counter *)
            
        If[RandomReal[] < 0.1, fpsLabel = ToString[fps]<>" FPS"];
        AppendTo[fpsHistory, fps];
                If[Length[fpsHistory] > 250, 
          ClearAll[handler];
          NotebookClose[window];
          EventFire[promise, Resolve, {Drop[fpsHistory, 2], Drop[fpsHistoryClean, 2]}];
        ];  
  ];

  window = CreateWindow[Graphics[{
    PointSize[0.007], Point[x // Offload],
    EventHandler[AnimationFrameListener[x // Offload], handler],
    Text[fpsLabel // Offload, {-1.8,1.8}]
  }, PlotRange -> {{-2,2}, {-2,2}}, TransitionType->None]];
  time = AbsoluteTime[];

  promise
];

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
tests`integratedBoids2[] := With[{promise = Promise[]},
  ClearAll[handler, n, r, f, s, x, p , q];

  n = 10000/4; 
  r := RandomInteger[{1, n}];
  f := (#/(.01 + Sqrt[#.#])) & /@ (x[[#]] - x) &;
  s := With[{r1 = r}, p[[r1]] = r; q[[r1]] = r];
  x = RandomReal[{-1, 1}, {n, 2}];
  ox = x;
  {p, q} = RandomInteger[{1, n}, {2, n}];

  x = 0.995 x + 0.02 f[p] - 0.01 f[q];
  colors = MapThread[(List@@(RGBColor[Hue[Norm[#1-#2] 20.0]]))&, {x,ox}];    
  ox = x;
  data = {x,colors};

  fps = 0;
  fpsLabel = "0";
  time = AbsoluteTime[];
  fpsHistory = {};
  fpsHistoryClean = {};
  firstTime = True;

  window = CreateWindow[Graphics[{
  PointSize[0.007], GraphicsComplex[
    data[[1]]//Offload, Point[Range[n]], VertexColors->Offload[data[[2]]]
  ],Red, Text[fpsLabel//Offload, {-1,-1}], 
  EventHandler[AnimationFrameListener[data // Offload], With[{},
    fps = Round[1/(AbsoluteTime[]-time)];
    time = AbsoluteTime[];
    
    x = 0.995 x + 0.02 f[p] - 0.01 f[q];
    colors = MapThread[(List@@(RGBColor[Hue[Norm[#1-#2] 20.0]]))&, {x,ox}]; 
    ox = x;
    If[r < 100, s];
    data = {x,colors};
    AppendTo[fpsHistoryClean, Round[1/(AbsoluteTime[]-time)]];
    
    (* FPS counter *)
            
        If[RandomReal[] < 0.1, fpsLabel = ToString[fps]<>" FPS"];
        AppendTo[fpsHistory, fps];
                If[Length[fpsHistory] > 250, 
          ClearAll[handler];
          NotebookClose[window];
          EventFire[promise, Resolve, {Drop[fpsHistory, 2], Drop[fpsHistoryClean, 2]}];
        ];      
  ]&]
}, 
  PlotRange -> {{-2,2}, {-2,2}}, TransitionType->None, 
  Background->Black, "Controls"->False, ImageSize->300
]];

  promise
];

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
tests`integratedImage[] := With[{promise = Promise[]},
frames = Table[RandomImage[{0,1}, {1024,1024}], {30}];
buffer = ImageData[frames[[1]], "Byte"];
index = 1;

fps = 0;
fpsLabel = "0";
time = AbsoluteTime[];
fpsHistory = {};
fpsHistoryClean = {};
firstTime = True;


  window = CreateWindow[Labeled[
Image[buffer//Offload, "Byte", Epilog->{
  EventHandler[AnimationFrameListener[buffer//Offload], Function[Null,
    fps = Round[1/(AbsoluteTime[]-time)];
    time = AbsoluteTime[];
    index++;
    If[index > Length[frames], index = 1];
    buffer = ImageData[frames[[index]], "Byte"];
    AppendTo[fpsHistoryClean, Round[1/(AbsoluteTime[]-time)]];
    
                
        If[RandomReal[]<0.3, fpsLabel = ToString[fps]];
        AppendTo[fpsHistory, fps];
       
        If[Length[fpsHistory] > 250, 
          ClearAll[handler];
          NotebookClose[window];
          EventFire[promise, Resolve, {Drop[fpsHistory, 2], Drop[fpsHistoryClean, 2]}];
        ];      
  ]]
}], TextView[fpsLabel//Offload]]];

  promise
];

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
tests`integratedBalls[] := With[{promise = Promise[]},
balls = RandomReal[{-1,1}, {300,3}];
vels  = RandomReal[{-1,1}, {300,3}];
firstTime = True;
fpsHistory = {};
fpsHistoryClean = {};

updateFunction = Function[Null,
  fps = Round[1/(AbsoluteTime[]-time)];
  time = AbsoluteTime[];
    
  vels = Table[
    If[Norm[balls[[i]]] < 0.01, -1, 1] vels[[i]] - 0.08 balls[[i]]
  , {i, Length[balls]}];
  
  balls = Table[balls[[i]] + 0.08 vels[[i]], {i, Length[balls]}];
  AppendTo[fpsHistoryClean, Round[1/(AbsoluteTime[]-time)]];
    
       (* FPS counter *)
            
        If[RandomReal[] < 0.1, fpsLabel = ToString[fps]<>" FPS"];
        AppendTo[fpsHistory, fps];
       
        If[Length[fpsHistory] > 250, 
          ClearAll[handler];
          NotebookClose[window];
          EventFire[promise, Resolve, {Drop[fpsHistory, 2], Drop[fpsHistoryClean, 2]}];
        ];  
  
];

fps = 0;
fpsLabel = "0";
time = AbsoluteTime[];
fpsHistory = {};


window = CreateWindow[Graphics3D[{
  Text[fpsLabel//Offload, {1,1,1}],
  Table[With[{i = i},
    {
      RGBColor[RandomReal[{0,1}, 3]],
      Sphere[balls[[i]] // Offload, 0.03]
    }
  ], {i, Length[balls]}], 
  EventHandler[AnimationFrameListener[balls // Offload], updateFunction]
}]];


  promise
];

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
tests`integrated3DComplex[] := With[{promise = Promise[]},
(* Grid dimensions *)
nx = 45; ny = 45;

fps = 0;
fpsLabel = "0";
time = AbsoluteTime[];
fpsHistory = {};
fpsHistoryClean = {};

(* All triangle indices *)
allIndices = Flatten[Table[
  With[{v = (i - 1) ny + j},
    {{v, v + 1, v + ny + 1}, {v, v + ny + 1, v + ny}}
  ],
  {i, nx - 1}, {j, ny - 1}
], 2];

xs = Subdivide[-2., 2., nx - 1];
ys = Subdivide[-2., 2., ny - 1];

(* Precompute centroid XY of each triangle for fast filtering *)
gridXY = Flatten[Table[{x, y}, {x, xs}, {y, ys}], 1];
triCX = (gridXY[[#[[1]], 1]] + gridXY[[#[[2]], 1]] + gridXY[[#[[3]], 1]]) / 3. & /@ allIndices;
triCY = (gridXY[[#[[1]], 2]] + gridXY[[#[[2]], 2]] + gridXY[[#[[3]], 2]]) / 3. & /@ allIndices;

generateFrame[t_] := Module[{verts, zVals, mn, mx, h1, h2, d1, d2, mask},
  verts = Flatten[Table[
    With[{r = Sqrt[x^2 + y^2]},
      {x, y,
        Sin[4 r - 2 t] Exp[-0.3 r] +
        0.3 Sin[2 x - t] Cos[2 y + 0.5 t]}
    ],
    {x, xs}, {y, ys}
  ], 1];

  zVals = verts[[All, 3]];
  {mn, mx} = MinMax[zVals];

  (* Two holes orbiting the center *)
  h1 = {1.3 Cos[0.8 t], 1.3 Sin[0.8 t]};
  h2 = {1.3 Cos[0.8 t + Pi], 1.3 Sin[0.8 t + Pi]};

  (* Vectorized distance computation *)
  d1 = Sqrt[(triCX - h1[[1]])^2 + (triCY - h1[[2]])^2];
  d2 = Sqrt[(triCX - h2[[1]])^2 + (triCY - h2[[2]])^2];

  (* Keep triangles outside both holes *)
  mask = UnitStep[d1 - 0.55] UnitStep[d2 - 0.55];

  {Pick[allIndices, mask, 1], {verts,
   Map[With[{s = Rescale[#[[3]], {mn, mx}]},
     List @@ RGBColor[s, 0.15 + 0.35 s, 1. - 0.8 s]] &, verts]}}
];

(* Initialize *)
{indices, complex} = generateFrame[0.];
firstTime = True;

window = CreateWindow[Graphics3D[{Text[fpsLabel//Offload, {-1,-1,-1}], GraphicsComplex[
  Offload[complex[[1]]],
  {Polygon[Offload[indices]]},
  VertexColors -> Offload[complex[[2]]],
  "VertexFence" -> True
], EventHandler[AnimationFrameListener[complex // Offload], Function[Null,
  fps = Round[1/(AbsoluteTime[]-time)];
  time = AbsoluteTime[];
  
  {indices, complex} = generateFrame[AbsoluteTime[]];
  AppendTo[fpsHistoryClean, Round[1/(AbsoluteTime[]-time)]];  
       (* FPS counter *)
            
        If[RandomReal[] < 0.1, fpsLabel = ToString[fps]<>" FPS"];
        AppendTo[fpsHistory, fps];
       
        If[Length[fpsHistory] > 250, 
          ClearAll[handler];
          NotebookClose[window];
          EventFire[promise, Resolve, {Drop[fpsHistory, 2], Drop[fpsHistoryClean, 2]}];
        ];    
]]}]];

promise
]

