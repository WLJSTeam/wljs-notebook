%-------------------------------------------------------------------------%
# WLJS / Wolfram Benchmarks
This notebook measures message throughput between the Wolfram kernel and the WLJS frontend.

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
## Full benchmark
This cell runs every transport and integration benchmark. It prints the transport scaling plot, the integration FPS plot, and a summary table with fixed transport samples plus `Around[...]` summaries for integration runs.

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Full benchmark
This cell runs every benchmark series, then prints the comparison plot followed by a table of concrete values. Use the plot to compare scaling behavior across payload sizes and the table to record stable Light and Medium samples for version and platform comparisons.

%-------------------------------------------------------------------------%
Props:
  Fade: true
Type: Input
%-------------------------------------------------------------------------%
Plot[x, {x,0,1}]; (* just to warm up *)
RandomImage[]; (* just to warm up *)
progress = 0;
PrintTemporary[ProgressIndicator[progress//Offload, {0,12}]];
PrintTemporary[Style["Testing I/O...", 10, Gray]];

roundTripRate = WaitAll[tests`measureRoundTripRate[1000], 999];

benchmarkSeries = <|
  "Frontend -> Kernel (JSON)" -> (progress++; WaitAll[tests`measureFrontendToKernelJSON[], 9999]),
  "Kernel -> Frontend (JSON, numeric)" -> (progress++; WaitAll[tests`measureKernelToFrontendJSON[N[Range[#]] &], 9999]),
  "Kernel -> Frontend (JSON, mixed)" -> (progress++; WaitAll[tests`measureKernelToFrontendJSON[Table[{RandomReal[], <|"key" -> ToString[u]|>}, {u, 1, #}] &], 9999]),
  "Kernel -> Frontend (binary, numeric)" -> (progress++; WaitAll[tests`measureKernelToFrontendBinary[NumericArray[N[Range[#]]] &], 9999]),
  "Kernel -> Frontend (binary, mixed)" -> (progress++; WaitAll[tests`measureKernelToFrontendBinary[Table[{RandomReal[], <|"key" -> ToString[u]|>}, {u, 1, #}] &], 9999])
|>;

PrintTemporary[Style["Testing Graphics/Image stream...", 10, Gray]];

integrationBenchmarkSeries = <|
  "Boids, points" -> (progress++; WaitAll[tests`integratedBoids1[], 9999]),
  "Boids, colored mesh" -> (progress++; WaitAll[tests`integratedBoids2[], 9999]),
  "Image stream" -> (progress++; WaitAll[tests`integratedImage[], 9999]),
  "3D balls" -> (progress++; WaitAll[tests`integratedBalls[], 9999]),
  "3D complex" -> (progress++; WaitAll[tests`integrated3DComplex[], 9999])
|>;

PrintTemporary[Style["Testing Wolfram Kernel itself...", 10, Gray]];

Needs["Benchmarking`"];
Block[{$Messages={}, $Output={}},
  wolframMark = Part[wolframMarkFull = Association@(Benchmark[][[1]]), "BenchmarkResult"];
];

progress++;



sampleIndexes = <|"Light" -> 2, "Medium" -> 30|>;
roundTripReference = Round[Normal[roundTripRate], 0.01];
integrationSampleCount = Max[Length /@ Values[integrationBenchmarkSeries][[All,1]]];

benchmarkPlot = ListLinePlot[
  Values[benchmarkSeries],
  PlotLegends -> Keys[benchmarkSeries],
  Frame -> True,
  FrameLabel -> {"Payload size", {"Messages / second", {-10,0}}},
  PlotRange -> {Automatic, {0,1400}},
  ImageSize -> Medium,
  Epilog -> {Black, Dashed, Line[{{-10, roundTripReference}, {100000, roundTripReference}}]}
];

integrationBenchmarkPlot1 = ListPlot[
  Values[integrationBenchmarkSeries][[All,1]],
  PlotLegends -> Keys[integrationBenchmarkSeries],
  Frame -> True,
  FrameLabel -> {"Sample", {"Frames / second", {-10,0}}},
  PlotRange -> {Automatic, {0,70}},
  ImageSize -> Medium,
  Epilog -> {Black, Dashed, Line[{{1, roundTripReference}, {integrationSampleCount, roundTripReference}}]}
];

integrationBenchmarkPlot2 = ListPlot[
  Values[integrationBenchmarkSeries][[All,2]],
  PlotLegends -> Keys[integrationBenchmarkSeries],
  Frame -> True,
  FrameLabel -> {"Sample", {"True frames / second", {-10,0}}},
  PlotRange -> {Automatic, {0,2200}},
  ImageSize -> Medium,
  Epilog -> {Black, Dashed, Line[{{1, roundTripReference}, {integrationSampleCount, roundTripReference}}]}
];

summaryRows = Join[
  {<|
    "Benchmark" -> "Wolfram Mark",
    "Metric" -> "Score",
    "Sample" -> "Baseline",
    "Payload size" -> "-",
    "Rate" -> wolframMark
  |>,<|
    "Benchmark" -> "Round trip baseline",
    "Metric" -> "Messages / second",
    "Sample" -> "Baseline",
    "Payload size" -> "-",
    "Rate" -> roundTripRate
  |>},
  Flatten[
    KeyValueMap[
      Function[{benchmarkName, series},
        KeyValueMap[
          Function[{sampleName, index},
            With[{point = series[[index]]},
              <|
                "Benchmark" -> benchmarkName,
                "Metric" -> "Messages / second",
                "Sample" -> sampleName,
                "Payload size" -> point[[1]],
                "Rate" -> point[[2]]
              |>
            ]
          ],
          sampleIndexes
        ]
      ],
      benchmarkSeries
    ],
    1
  ],
  KeyValueMap[
    Function[{benchmarkName, samples},
      <|
        "Benchmark" -> benchmarkName,
        "Metric" -> "Frames / second",
        "Sample" -> "Integrated",
        "Payload size" -> "-",
        "Rate" -> {Around[samples[[1]]], Around[samples[[2]]]}
      |>
    ],
    integrationBenchmarkSeries
  ]
];

Unprotect[Around]; (*there is a bug, it will be fixed in the next release *)
Around /: MakeBoxes[Around[mean_?NumberQ, std_?NumberQ], StandardForm] := With[{},
  ViewBox[Around[mean, std], ViewDecorator["Around", TextString[N@Round[mean, std/2] ], TextString @ std ] ]
];

CreateDocument[{
  TextCell["Benchmark Report", "Section"], 
  TextCell["System Information", "Subsection"], 
  TextCell[$System, "Text"],
  TextCell[$Version, "Text"],
  TextCell[Internal`Kernel`$Env["AppJSON", "version"]//ToString, "Text"],
  TextCell["Results", "Subsection"], 
  ExpressionCell[benchmarkPlot, "Input"],
  ExpressionCell[integrationBenchmarkPlot1, "Input"],
  ExpressionCell[integrationBenchmarkPlot2, "Input"],
  ExpressionCell[summaryRows // TableView],
  TextCell["Compressed", "Text"],
  ExpressionCell[Compress[<|"Summary"->summaryRows, "IntegrationBenchmarkSeries"->integrationBenchmarkSeries, "BenchmarkSeries"->benchmarkSeries, "WolframMark"->wolframMarkFull, "WLJS"->Internal`Kernel`$Env["AppJSON", "version"], "SystemID"->$System, "Version"->$Version|>], "Input"]
}];

