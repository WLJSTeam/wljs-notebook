%-------------------------------------------------------------------------%
tests`measureKernelToFrontendJSON[makePayload_] := Module[{sample},
  TableAsync[
    sample = tests`measureKernelToFrontendJSONSample[makePayload[size], 30] // Await;
    {size, sample}
  , {size, 10, 10000, 200}]
];

tests`measureKernelToFrontendJSONSample[expr_, maxSamples_:200] := Module[{
  timestamps = {},
  sampleCount = 0,
  sentAt,
  result = Promise[]
},
  EventHandler["BenchmarkReceiveJSON", Function[Null,
    AppendTo[timestamps, AbsoluteTime[] - sentAt];
    sampleCount++;
    If[sampleCount >= maxSamples,
      EventRemove["BenchmarkReceiveJSON"];
      EventFire[result, Resolve, 1/Around[timestamps]];
      ClearAll[timestamps, sampleCount, sentAt, result];
      
      Return[];
    ];

    sentAt = AbsoluteTime[];
    FrontSubmit[BenchmarkReceiveJSON[expr]];
  ]];

  sentAt = AbsoluteTime[];
  FrontSubmit[BenchmarkReceiveJSON[expr]];
  result
];

%-------------------------------------------------------------------------%
Props:
  Hidden: true
Type: Input
%-------------------------------------------------------------------------%
.md
## Frontend to kernel (JSON)
This test builds JSON-compatible arrays in JavaScript and sends them back to Wolfram. The round-trip baseline is subtracted from each sample so the reported rate focuses on payload generation, transfer, and kernel-side decoding.

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## Frontend to kernel (JSON)
This test builds JSON-compatible arrays in JavaScript and sends them back to Wolfram. The round-trip baseline is subtracted from each sample so the reported rate focuses on payload generation, transfer, and kernel-side decoding.

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
.js
core.BenchmarkSendJSON = async (args, env) => {
  const n = await interpretate(args[0], env);
  const payload = Array(n).fill().map((x, i) => i);
  server.kernel.io.fire('BenchmarkSendJSON', payload);
};

return "BenchmarkSendJSON registered";

%-------------------------------------------------------------------------%
Display: js
Type: Output
%-------------------------------------------------------------------------%
core.BenchmarkSendJSON = async (args, env) => {
  const n = await interpretate(args[0], env);
  const payload = Array(n).fill().map((x, i) => i);
  server.kernel.io.fire('BenchmarkSendJSON', payload);
};

return "BenchmarkSendJSON registered";

%-------------------------------------------------------------------------%
Props:
  InitGroup: true
Type: Input
%-------------------------------------------------------------------------%
tests`measureFrontendToKernelJSON = AsyncFunction[Null, Module[{
  sample,
  roundTripRate,
  roundTripLatency
},
  roundTripRate = tests`measureRoundTripRate[] // Await;
  roundTripLatency = Round[1/roundTripRate, 0.000001];

  TableAsync[
    sample = tests`measureFrontendToKernelJSONSample[size, roundTripLatency, 30] // Await;
    {size, sample}
  , {size, 10, 10000, 200}] // Await
]];

tests`measureFrontendToKernelJSONSample[n_, roundTripLatency_, maxSamples_:200] := Module[{
  timestamps = {},
  sampleCount = 0,
  sentAt,
  result = Promise[]
},
  EventRemove["BenchmarkSendJSON"] // Quiet;
  
  EventHandler["BenchmarkSendJSON", Function[Null,
    AppendTo[timestamps, AbsoluteTime[] - sentAt - roundTripLatency];
    sampleCount++;
    If[sampleCount >= maxSamples,
      EventRemove["BenchmarkSendJSON"];
      EventFire[result, Resolve, 1/Around[timestamps]];
      ClearAll[timestamps, sampleCount, sentAt, result];
      Return[];
    ];

    sentAt = AbsoluteTime[];
    FrontSubmit[BenchmarkSendJSON[n]];
  ]];

  sentAt = AbsoluteTime[];
  FrontSubmit[BenchmarkSendJSON[n]];
  result
];

