 RowBox[{
  RowBox[{"fouriertransf", "=", 
   RowBox[{"Fourier", "[", "mat", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", "w"}], "}"}], "=", 
   RowBox[{"Dimensions", "[", "mat", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hshift", "=", 
   RowBox[{"IntegerPart", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"h", "+", ".5"}], ")"}], "/", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wshift", "=", 
