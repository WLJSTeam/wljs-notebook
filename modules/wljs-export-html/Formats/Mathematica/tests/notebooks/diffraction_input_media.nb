 RowBox[{
  RowBox[{"obstacle", " ", "=", " ", 
   RowBox[{"ColorConvert", "[", 
    RowBox[{"%", ",", "\"\<Grayscale\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mat", " ", "=", " ", 
   RowBox[{"ImageData", "[", "obstacle", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fouriertransf", "=", 
   RowBox[{"Fourier", "[", "mat", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", "w"}], "}"}], "=", 
   RowBox[{"Dimensions", "[", "mat", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hshift", "=", 
   RowBox[{"IntegerPart", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"h", "+", ".5"}], ")"}], "/", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wshift", "=", 
   RowBox[{"IntegerPart", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"w", "+", ".5"}], ")"}], "/", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fourierimage", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"RotateLeft", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"RotateLeft", "[", 
        RowBox[{"fouriertransf", ",", "hshift"}], "]"}], "]"}], ",", 
      "wshift"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Abs", "[", "fourierimage", "]"}], " ", "//", 
  "Image"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Arg", "[", "fourierimage", "]"}], " ", "//", "Image"}]}], "Input",
