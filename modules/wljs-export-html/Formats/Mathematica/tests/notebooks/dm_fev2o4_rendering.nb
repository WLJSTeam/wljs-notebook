         RowBox[{
          RowBox[{"coords", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "+", 
          RowBox[{
           SubscriptBox["S", "i"], "/", "2"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{
          SubscriptBox["S", "0"], "/", "2"}]}], "}"}]}], "]"}]}], ";"}], " ", 
