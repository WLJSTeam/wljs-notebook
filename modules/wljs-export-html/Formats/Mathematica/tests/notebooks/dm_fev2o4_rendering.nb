Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["S", "i"], "=", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "<", "1"}], ",", "2", ",", 
        RowBox[{"3", "/", "2"}]}], "]"}], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", 
          SubscriptBox["\[Phi]", "i"], "]"}], 
         RowBox[{"Sin", "[", 
          SubscriptBox["\[Theta]", "i"], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", 
          SubscriptBox["\[Phi]", "i"], "]"}], 
         RowBox[{"Sin", "[", 
          SubscriptBox["\[Theta]", "i"], "]"}]}], ",", 
        RowBox[{"Cos", "[", 
         SubscriptBox["\[Theta]", "i"], "]"}]}], "}"}]}]}], ";", " ", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     SubscriptBox["J", "i"], "=", "j"}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     SubscriptBox["dir", "i"], " ", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"i", ">", "0"}], ",", 
       RowBox[{"{", 
