Cell["\<\
In order to verify that the solution is correct, substitute it back into the \
differential equation. \
\>", "Text",ExpressionUUID->"4cf64c72-b907-4d31-9781-35e171aa794a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"x", " ", 
     RowBox[{
      RowBox[{"f", "''"}], "[", "x", "]"}]}], "\[Equal]", 
    SuperscriptBox["x", "2"]}], ")"}], "/.", 
  RowBox[{"f", "\[Rule]", 
   RowBox[{"Function", "[", 
    RowBox[{"x", ",", 
     RowBox[{"Evaluate", "[", "sln", "]"}]}], 
    "]"}]}]}]], \
"Input",ExpressionUUID->"8ecc7cde-68d9-42ec-a323-9f4ce625835f"],

Cell[BoxData["True"], \
"Output",ExpressionUUID->"64ae3d63-eea7-42d7-8d94-936385a73937"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Finding Solutions", \
"Subsection",ExpressionUUID->"6cfd70fc-efef-4bb9-89b9-240c8d51ce50"],

Cell["Study another initial value problem: ", \
"Text",ExpressionUUID->"0b0ce4ab-6e6b-41b9-8e71-3cda6db9e8c5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "''"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"-", 
     RowBox[{"f", "(", "x", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "9c26a672-23f5-4645-aa8a-0ea6a7e86456"],
 " "
}], "Text",ExpressionUUID->"f72ab7bb-0d47-4d9a-9d2f-273dbd9bb4f1"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", "(", "0", ")"}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"04bc4885-c5dd-4cdb-b099-cf98d2b7e1a8"]], \
"Text",ExpressionUUID->"234086bb-e6e3-4bc9-a709-1e361438bb5c"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "0", ")"}]}], "=", "5"}], 
  TraditionalForm]],ExpressionUUID->"88312356-0aca-4f17-b7bb-6aa5a6b0f16b"]], \
"Text",ExpressionUUID->"75e37d02-7edf-44a6-965b-93c3aecedbe6"],

Cell["Find the solution using DSolveValue:", \
"Text",ExpressionUUID->"c328bfb6-2447-4ab6-afeb-62369912cf3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sln", "=", 
  RowBox[{"DSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "''"}], "[", "x", "]"}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{"f", "[", "x", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"f", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "'"}], "[", "0", "]"}], "\[Equal]", "5"}]}], "}"}], ",", 
    
    RowBox[{"f", "[", "x", "]"}], ",", "x"}], 
   "]"}]}]], "Input",ExpressionUUID->"e8563f41-8bc9-4a49-8732-2f207b8bc223"],

Cell[BoxData[
 RowBox[{"5", " ", 
  RowBox[{
  "Sin", "[", "x", 
   "]"}]}]], "Output",ExpressionUUID->"76e9a246-8c2d-4875-8eb7-a6929e4326df"]
}, Open  ]],

Cell["Apply Plot to the solution:", \
"Text",ExpressionUUID->"ad312ec0-2e05-4e8b-bf5d-8d10679f9696"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"sln", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"List", 
       StyleBox["\"Options\"", "IconizedCustomName", StripOnInput -> False], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["List", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["480", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    {PlotStyle -> Thickness[Large], AxesLabel -> {
       Style["x", 18], 
       Style["f(x)", 18]}},
    SelectWithContents->True,
    Selectable->False]}], 
  "]"}]], "Input",ExpressionUUID->"9101dc71-ddda-4887-ae36-b3979e72862e"],

