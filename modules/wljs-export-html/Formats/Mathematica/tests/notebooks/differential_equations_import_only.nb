Cell["\<\
To verify that the solution is correct, substitute it back into the \
differential equation. \
\>", "Text",ExpressionUUID->"836d1668-69fa-4087-9b8c-f8853a39f6ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "''"}], "[", "x", "]"}], "==", 
    RowBox[{"-", 
     RowBox[{"f", "[", "x", "]"}]}]}], ")"}], "/.", 
  RowBox[{"f", "\[Rule]", 
   RowBox[{"Function", "[", 
    RowBox[{"x", ",", 
     RowBox[{"Evaluate", "[", "sln", "]"}]}], 
    "]"}]}]}]], \
"Input",ExpressionUUID->"474832ee-8895-4a7d-a8dc-5764ac0bd814"],

Cell[BoxData["True"], \
"Output",ExpressionUUID->"00cbbe00-e499-4378-83e2-454b34792ea8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Partial Differential Equations", \
"Subsection",ExpressionUUID->"1fb1933a-4332-4f01-93f6-84e4b404f18f"],

Cell["\<\
With partial differential equations (PDEs), partial derivatives appear in the \
differential equation.\
\>", "Text",ExpressionUUID->"0cda6bfa-bd5f-48a5-8e54-c13db4484c64"],

Cell["\<\
The unknown function depends on multiple independent variables.\
\>", "Text",ExpressionUUID->"9ecd6755-cc66-4e62-a40b-d3a019af3e61"],

Cell["Examples of PDEs are: ", \
"Text",ExpressionUUID->"4d218b78-5d61-4986-a57c-fb0a58b6c3d5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"y", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{
       RowBox[{"\[PartialD]", "x"}], 
       RowBox[{"\[PartialD]", "t"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"y", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["t", "2"]}]], "+", 
     RowBox[{"sin", "(", 
      RowBox[{"x", " ", "t"}], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"f9d18ae9-e3ac-43ad-8af1-8cc91f85ada2"],
 " "
}], "Text",ExpressionUUID->"386bab12-23fb-41d1-870e-b955445ce0d8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"f", "(", 
        RowBox[{"x", ",", "y"}], ")"}]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "2"]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"f", "(", 
        RowBox[{"x", ",", "y"}], ")"}]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["y", "2"]}]], "+", "y", "+", 
     RowBox[{"x", " ", 
      RowBox[{"f", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"d31ac472-61c8-4fe9-b90b-4ac3ac32f301"],
 " "
}], "Text",ExpressionUUID->"0a5fb81c-2ad2-429d-9c8d-14daa9659d9e"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"y", "(", 
       RowBox[{"x", ",", "t"}], ")"}]}], 
     RowBox[{"\[PartialD]", "x"}]], "+", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"y", "(", 
       RowBox[{"x", ",", "t"}], ")"}]}], 
     RowBox[{"\[PartialD]", "t"}]]}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"e8fa4a69-a43e-4f56-ac13-def5a5aa667a"]], \
"Text",ExpressionUUID->"2d356947-49f0-4d95-9560-dfc450c7805e"],

Cell["\<\
DSolveValue can be used to solve many types of partial differential equations.\
\>", "Text",ExpressionUUID->"ced0bbd0-8cb0-4c5a-92a4-a6f40ab0a138"],

Cell["\<\
The theory of partial differential equations is not as well understood as \
that of ordinary differential equations and thus plays a minor role in this \
course.\
\>", "Text",ExpressionUUID->"82b5e1b7-e117-4b07-be6e-502c5cad0e3a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Partial Differential Equations", \
"Subsection",ExpressionUUID->"2b56b5a1-0dd1-48f5-b330-5f22e1d030c1"],

Cell["Observe a problem for a partial differential equation:", \
"Text",ExpressionUUID->"8106cb86-9f14-4b23-8078-0f24ac582d50"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"u", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "x"}]], "+", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"u", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "t"}]]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"7cdc3518-752a-4a70-9bfd-b8f17e871121"],
 " "
}], "Text",ExpressionUUID->"123ab579-5f21-453d-b130-7f1bb244f42b"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"u", "(", 
    RowBox[{"x", ",", "0"}], ")"}], "=", 
   RowBox[{"sin", "(", "x", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"9a32eaa3-2022-40cf-bf55-e6e85e8a304e"]], \
"Text",ExpressionUUID->"f431917e-4421-44b0-b53a-60a08afb8a06"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"u", "(", 
    RowBox[{"0", ",", "t"}], ")"}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"c81650e6-a50c-4639-a97e-275f14610f65"]], \
"Text",ExpressionUUID->"b55861cf-7db5-49f3-b7d1-7dd825d386e4"],

Cell["\<\
Begin by specifying the equation and the conditions the solution must satisfy:\
\>", "Text",ExpressionUUID->"7ea9a5a6-0dbf-4dd4-b5d9-7cc96e3e21d2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}]}], "\[Equal]", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ibc", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "==", " ", 
      RowBox[{"Sin", "[", "x", "]"}]}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sln", "=", 
  RowBox[{
   RowBox[{"DSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eqn", ",", "ibc"}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "t"}], "}"}]}], "]"}], "//", 
   "FullSimplify"}]}]}], \
"Input",ExpressionUUID->"d73c74ac-171a-46f4-86fd-afec8c7ac291"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"t", "-", "x"}], "]"}]}], ")"}], " ", 
  RowBox[{"Sin", "[", 
   RowBox[{"t", "-", "x"}], 
   "]"}]}]], "Output",ExpressionUUID->"1433e5b1-9d35-49ef-819d-9596df3283d2"]
}, Open  ]],

Cell[TextData[{
 "Use ",
 ButtonBox["Plot3D",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Plot3D.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Plot3D.html"],
 " to visualize the solution from DSolveValue:"
}], "Text",ExpressionUUID->"5a6084a7-3caa-472f-bc2f-7142eb8268b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{"sln", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"List", 
       StyleBox["\"Options\"", "IconizedCustomName", StripOnInput -> False], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["List", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["1", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["104", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    {Exclusions -> None},
    SelectWithContents->True,
    Selectable->False]}], 
  "]"}]], "Input",ExpressionUUID->"c5f64d43-bf28-4e59-871f-c5a5a6d00f9b"],

