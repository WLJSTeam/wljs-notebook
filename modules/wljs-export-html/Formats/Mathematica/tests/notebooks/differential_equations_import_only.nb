          BaseStyle->"Graphics"]}}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None,
  PlotLabel->FormBox[
   "\"Classification of Differential Equations\"", 
    TraditionalForm]]], "Output",
 GeneratedCell->False,
 CellAutoOverwrite->
  True,ExpressionUUID->"400265a4-6491-46f9-9a86-bf32caa059b0"]
}, {2}]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ordinary Differential Equations", \
"Subsection",ExpressionUUID->"fc71aa9a-2d5e-488b-8ac1-4504f4f81ea8"],

Cell["\<\
With ordinary differential equations (ODEs), only ordinary derivatives appear \
in the differential equation, and the unknown function depends on a single \
independent variable.\
\>", "Text",ExpressionUUID->"72e4d344-e5c2-4516-8893-b6393dcd4420"],

Cell["Examples include: ", \
"Text",ExpressionUUID->"2f8a2d0d-4804-43d7-a6fd-4d0b6738addb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{"y", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "886c25be-22e2-4060-8b1b-2f971473135e"],
 " "
}], "Text",ExpressionUUID->"42bbe53e-dd73-4911-828f-1311798dae94"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}], "*", "x"}], "=", 
   RowBox[{"sin", "(", "x", ")"}], " "}], 
  TraditionalForm]],ExpressionUUID->"6c81b6c3-12fb-4f54-aaa2-09bacd67501d"]], \
"Text",ExpressionUUID->"10b9556d-ed3d-4fc7-884e-100f2ace9df1"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"g", "''"}], 
     RowBox[{"(", "t", ")"}]}], "+", 
    RowBox[{
     RowBox[{"g", "'"}], 
     RowBox[{"(", "t", ")"}]}]}], "=", 
   RowBox[{"g", "(", "t", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"a7b4c79f-4bc2-49a5-8aed-293e1224e964"]], \
"Text",ExpressionUUID->"82522c3c-cd69-49db-9e9e-bd51a99f6ed3"],

Cell[TextData[{
 "In order to solve a differential equation, use the Wolfram Language \
function ",
 ButtonBox["DSolveValue",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/DSolveValue.html"], None},
  
  ButtonNote->"https://reference.wolfram.com/language/ref/DSolveValue.html"],
 ":"
}], "Text",ExpressionUUID->"0dd7e103-3dba-46ed-b5fd-4fa7425641f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolveValue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"y", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
   RowBox[{"y", "[", "t", "]"}], ",", "t"}], 
  "]"}]], "Input",ExpressionUUID->"8b0141d8-04c7-44ea-be7e-f3b639c16106"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  "t"]], "Output",ExpressionUUID->"99f788cc-5cfe-41ad-8961-48f284216e3f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Finding Solutions", \
"Subsection",ExpressionUUID->"9ee42b48-7b4f-4e83-982a-73c31d0e8f99"],

Cell["\<\
Begin with the initial value problem for an ordinary differential equation: \
\>", "Text",ExpressionUUID->"e5760177-11ed-4ba8-adc2-75106bd20dea"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"x", " ", 
    RowBox[{"f", "''"}], 
    RowBox[{"(", "x", ")"}]}], "=", 
   SuperscriptBox["x", "2"], " "}], 
  TraditionalForm]],ExpressionUUID->"82b8333e-a2f9-45c0-87c6-9e80fc1da513"]], \
"Text",ExpressionUUID->"1f0df40c-a176-4b94-9567-a5683785a1d1"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", "(", "0", ")"}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"c7a57837-3e7c-4821-b84e-b6f51f188cc1"]], \
"Text",ExpressionUUID->"56365ffe-5860-470d-b65c-970436b4bc13"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "0", ")"}]}], "=", "5"}], 
  TraditionalForm]],ExpressionUUID->"37a1f122-dc98-47bc-b797-c8e8e55c899b"]], \
"Text",ExpressionUUID->"3d22a67f-8c63-4d9f-a48b-6eab562dbdb1"],

Cell["Use DSolveValue to find a solution:", \
"Text",ExpressionUUID->"38851f14-f3b0-4f17-a5d4-bcbf49958345"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sln", "=", 
  RowBox[{"DSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{
         RowBox[{"f", "''"}], "[", "x", "]"}]}], "\[Equal]", 
       SuperscriptBox["x", "2"]}], ",", 
      RowBox[{
       RowBox[{"f", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "'"}], "[", "0", "]"}], "\[Equal]", "5"}]}], "}"}], ",", 
    
    RowBox[{"f", "[", "x", "]"}], ",", "x"}], 
   "]"}]}]], "Input",ExpressionUUID->"1c3d7e96-f884-4c5a-9182-a8eb44319bda"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "6"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"30", " ", "x"}], "+", 
    SuperscriptBox["x", "3"]}], 
   ")"}]}]], "Output",ExpressionUUID->"87a4821b-11cb-4f4a-844e-9233d472d130"]
}, Open  ]],

Cell[TextData[{
 "The solution to the differential equation is now stored in the variable ",
 Cell[BoxData[
 "sln"], "Input",ExpressionUUID->"d7100ba7-7b12-41f6-981e-28cf247a801f"],
 ", which makes it easy to apply ",
 ButtonBox["Plot",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Plot.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Plot.html"],
 " to",
 StyleBox[" ",
  FontWeight->"Bold"],
 "the solution:"
}], "Text",ExpressionUUID->"c8d23e6a-e31c-4d9a-a7d3-9c121af04017"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"sln", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"List", 
       StyleBox["\"Options\"", "IconizedCustomName", StripOnInput -> False], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["List", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["480", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    {PlotStyle -> Thickness[Large], AxesLabel -> {
       Style["x", 18], 
       Style["f(x)", 18]}},
    SelectWithContents->True,
    Selectable->False]}], 
  "]"}]], "Input",ExpressionUUID->"ef51950e-1783-4b23-94f7-57ee4da73b91"],

