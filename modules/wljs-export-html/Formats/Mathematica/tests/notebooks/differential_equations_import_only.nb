Notebook[{

Cell[CellGroupData[{
Cell["Introduction", "SectionTitle",
 CellTags->
  "SectionTitle",ExpressionUUID->"6de980a8-ea05-4e71-98f0-65095b70fb35"],

Cell[CellGroupData[{

Cell["Classification of Differential Equations", "NumberedSection",
 CounterAssignments->{{"Subsection", 0}, {"Subsubsection", 0}, {
   "Exercise", 0}, {
   "Section", 3}},ExpressionUUID->"ef768a05-b516-4702-bc84-35150cc3fa76"],

Cell[CellGroupData[{

Cell["Overview", \
"Subsection",ExpressionUUID->"c7099aa9-3682-4264-861b-db5021ebc907"],

Cell["\<\
Differential equations take many forms and can include functions of many \
variables:\
\>", "Text",ExpressionUUID->"03f5fcdd-53cd-490e-8e76-82c241e52745"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"y", "''"}], 
     RowBox[{"(", "t", ")"}]}], "+", 
    RowBox[{
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}]}], "=", 
   RowBox[{"y", "(", "t", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"5a44b998-9dd4-4df9-830c-50bc2f28c353"]], \
"Text",ExpressionUUID->"df557016-c3bd-42fb-aa81-d1d1456dd370"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"y", "(", 
       RowBox[{"x", ",", "t"}], ")"}]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "2"]}]], "+", 
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"y", "(", 
       RowBox[{"x", ",", "t"}], ")"}]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["t", "2"]}]], "+", 
    RowBox[{"sin", "(", "x", ")"}]}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"484b810d-134a-4c53-90e6-068bbacbc62d"]], \
"Text",ExpressionUUID->"74dd7aa8-bba9-4e61-b263-c956c35f4aed"],

Cell["\<\
This lesson will discuss the methods of defining, solving and plotting \
general differential equations in Wolfram Language.\
\>", "Text",ExpressionUUID->"b24287e2-5f9a-45f6-a719-b3ac23d3851a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CellPrint", "[", 
  RowBox[{"ExpressionCell", "[", 
   RowBox[{
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "5"}], ",", 
        RowBox[{"1", "\[Rule]", "3"}], ",", 
        RowBox[{"4", "\[Rule]", "7"}], ",", 
        RowBox[{"2", "\[Rule]", "4"}], ",", 
        RowBox[{"4", "\[Rule]", "6"}], ",", 
        RowBox[{"6", "\[Rule]", "8"}]}], "}"}], ",", 
      InterpretationBox[
       DynamicModuleBox[{Typeset`open = False}, 
        TemplateBox[{"List", 
          StyleBox[
          "\"Options\"", "IconizedCustomName", StripOnInput -> False], 
          GridBox[{{
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["List", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["3", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["2104", "IconizedItem"]}]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
           "Column", 
           GridBoxItemSize -> {
            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
          Dynamic[Typeset`open]},
         "IconizedObject"]],
       {VertexLabels -> {
         1 -> "Differential Equation", 2 -> "ODE", 3 -> "PDE", 4 -> "Linear", 
          5 -> "Nonlinear", 6 -> "Homogeneous", 7 -> "Nonhomogeneous", 8 -> 
          "Constant Coefficients"}, 
        VertexCoordinates -> {{0, 0.5}, {1, 1}, {2, 0.25}, {1, 0}, {2, 1}, {
          3, 0.5}, {3, 1}, {4, 1}}, PlotLabel -> 
        "Classification of Differential Equations"},
       SelectWithContents->True,
       Selectable->False]}], "]"}], ",", 
    RowBox[{"GeneratedCell", "\[Rule]", "False"}], ",", "\"\<Output\>\""}], 
   "]"}], "]"}]], \
"Input",ExpressionUUID->"393ed46a-4441-4e4d-9155-9fb9555d6fca"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 5, 3, 4, 7, 6, 
      8}, {{{1, 2}, {2, 3}, {1, 4}, {5, 6}, {2, 5}, {5, 7}, {7, 8}}, Null}, {
      PlotLabel -> "Classification of Differential Equations", 
       VertexCoordinates -> {{0, 0.5}, {1, 1}, {2, 0.25}, {1, 0}, {2, 1}, {
         3, 0.5}, {3, 1}, {4, 1}}, 
       VertexLabels -> {
        8 -> "Constant Coefficients", 2 -> "ODE", 4 -> "Linear", 1 -> 
         "Differential Equation", 5 -> "Nonlinear", 7 -> "Nonhomogeneous", 3 -> 
         "PDE", 6 -> "Homogeneous"}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.5], Opacity[0.7], Arrowheads[Medium], 
        ArrowBox[{{{0., 0.5}, {1., 1.}}, {{0., 0.5}, {1., 0.}}, {{1., 1.}, {
         2., 0.25}}, {{1., 1.}, {2., 1.}}, {{2., 1.}, {3., 0.5}}, {{2., 1.}, {
         3., 1.}}, {{3., 1.}, {4., 1.}}}, 0.03700564971751412]}, 
       {Hue[0.6, 0.2, 0.8], EdgeForm[{GrayLevel[0], Opacity[
        0.7]}], {DiskBox[{0., 0.5}, 0.03700564971751412], 
         InsetBox["\<\"Differential Equation\"\>", 
          Offset[{2, 2}, {0.03700564971751412, 0.5370056497175141}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {DiskBox[{1., 1.}, 0.03700564971751412], 
         InsetBox["\<\"ODE\"\>", 
          Offset[{2, 2}, {1.0370056497175142, 1.0370056497175142}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {DiskBox[{2., 0.25}, 0.03700564971751412], 
         InsetBox["\<\"Nonlinear\"\>", 
          Offset[{2, 2}, {2.037005649717514, 0.28700564971751413}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {DiskBox[{1., 0.}, 0.03700564971751412], 
         InsetBox["\<\"PDE\"\>", 
          Offset[{2, 2}, {1.0370056497175142, 0.03700564971751412}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {DiskBox[{2., 1.}, 0.03700564971751412], 
         InsetBox["\<\"Linear\"\>", 
          Offset[{2, 2}, {2.037005649717514, 1.0370056497175142}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {DiskBox[{3., 0.5}, 0.03700564971751412], 
         InsetBox["\<\"Nonhomogeneous\"\>", 
          Offset[{2, 2}, {3.037005649717514, 0.5370056497175141}], 
