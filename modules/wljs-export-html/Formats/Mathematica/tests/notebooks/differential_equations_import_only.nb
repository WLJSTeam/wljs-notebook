Cell[CellGroupData[{

Cell["Order", \
"Subsection",ExpressionUUID->"50b9bb35-1dbf-498b-acb2-3fd25ada6698"],

Cell[TextData[{
 "The ",
 StyleBox["order",
  FontWeight->"Bold"],
 " of a differential equation is the order of the highest derivative that \
appears in the equation."
}], "Text",ExpressionUUID->"1edc7c99-dd33-499f-9469-2ffbf10f0fee"],

Cell["\<\
For example, the following is a second-order ordinary differential equation: \
\
\>", "Text",ExpressionUUID->"ad7e0e57-916a-4820-bec2-6932fe9c48b1"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"y", "''"}], 
     RowBox[{"(", "t", ")"}]}], "+", 
    RowBox[{"5", " ", 
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}], "+", 
    RowBox[{"y", "(", "t", ")"}]}], "=", 
   RowBox[{"sin", "(", "t", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"2efb30b4-7445-4d7c-8839-4a1a2d0efb5c"]], \
"Text",ExpressionUUID->"74cfe29a-d9fd-4799-909b-d738ef48a459"],

Cell["This can be written in Wolfram Language as:", \
"Text",ExpressionUUID->"88b0fdd0-e572-4d09-9601-a199d05d5e41"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"y", "''"}], "[", "t", "]"}], "+", 
    RowBox[{"5", 
     RowBox[{
      RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
    RowBox[{"y", "[", "t", "]"}]}], "\[Equal]", 
   RowBox[{"Sin", "[", "t", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"b7d9630a-c9a1-4516-8ddd-f8ba6244dee3"],

Cell["\<\
The next differential equation is a fifth-order differential equation: \
\>", "Text",ExpressionUUID->"44a20122-bf0a-48de-bcf9-441604ba44a4"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["y", 
      RowBox[{"(", "5", ")"}]], "(", "t", ")"}], " ", 
    RowBox[{
     SuperscriptBox["y", 
      RowBox[{"(", "2", ")"}]], "(", "t", ")"}]}], "=", 
   SuperscriptBox["e", 
    SuperscriptBox["t", "2"]]}], TraditionalForm]], "Input",
 FontWeight->
  "Plain",ExpressionUUID->"f050022b-ca5c-4630-9d61-e6e53d57db74"]], \
"Text",ExpressionUUID->"415213d8-a51f-4860-8b13-d1cacda7e326"],

Cell["This can be written in Wolfram Language as:", \
"Text",ExpressionUUID->"66a1012c-14fd-4678-afdd-c2cf6f596f32"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "5"}], "}"}]}], "]"}], " ", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}], "\[Equal]", 
  RowBox[{"Exp", "[", 
   SuperscriptBox["t", "2"], 
   "]"}]}]], "Input",ExpressionUUID->"cb07e8ee-7c14-4b46-82cb-ee312ca3b00e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SuperscriptBox["y", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "t", "]"}], " ", 
   RowBox[{
    SuperscriptBox["y", 
     TagBox[
      RowBox[{"(", "5", ")"}],
      Derivative],
     MultilineFunction->None], "[", "t", "]"}]}], "\[Equal]", 
  SuperscriptBox["\[ExponentialE]", 
   SuperscriptBox["t", 
    "2"]]}]], \
"Output",ExpressionUUID->"211f671b-bbc1-49d5-843a-0441dbc36650"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linear and Nonlinear Equations", \
"Subsection",ExpressionUUID->"3d593e71-387c-4e90-b6e1-dcd8805795db"],

Cell[TextData[{
 "An ordinary differential equation is said to be ",
 StyleBox["linear",
  FontWeight->"Bold"],
 " if it can be written in the form: "
}], "Text",ExpressionUUID->"18b258f9-90f0-4cf9-bbfe-ac10491903f9"],

Cell[TextData[Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["a", "n"], "(", "t", ")"}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[DifferentialD]", "n"], 
          RowBox[{"y", "(", "t", ")"}]}], 
         RowBox[{"\[DifferentialD]", 
          SuperscriptBox["t", "n"]}]]}], "+"}], "..."}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "1"], "(", "t", ")"}], 
      FractionBox[
       RowBox[{"\[DifferentialD]", 
        RowBox[{"y", "(", "t", ")"}]}], 
       RowBox[{"\[DifferentialD]", "t"}]]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "0"], "(", "t", ")"}], 
      RowBox[{"y", "(", "t", ")"}]}]}], "=", 
    RowBox[{"g", "(", "t", ")"}]}],
   FontColor->GrayLevel[0]], TraditionalForm]], "Input",
 FontWeight->
  "Plain",ExpressionUUID->"df7e8595-5160-454f-8f8f-608afa9c27eb"]], \
"Text",ExpressionUUID->"bf731ed9-a623-4571-b741-f4d55c6555af"],

Cell[TextData[{
 StyleBox["where the ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], "(", "t", ")"}], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "662ca8e2-30bc-4002-a11e-3dd859167d8f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "cb1c6143-9953-442c-922c-4abd552515ed"],
 StyleBox[" are arbitrary differentiable functions that do not need to be \
linear.",
  FontColor->GrayLevel[0]]
}], "Text",ExpressionUUID->"0c148064-724a-4be2-b17a-78868bd936c3"],

Cell["\<\
Mathematical theory and methods for solving linear equations are highly \
developed and will be the main focus of the course.\
\>", "Text",ExpressionUUID->"94ae785e-519e-42b4-b936-498aa14c0227"],

Cell[TextData[{
 "An ordinary differential equation is said to be ",
 StyleBox["nonlinear ",
  FontWeight->"Bold"],
 "if it cannot be written in a linear form."
}], "Text",ExpressionUUID->"914391c3-bd3d-4a7e-9807-42c97fef96a6"],

Cell["\<\
For example, the following are examples of linear differential equations:\
\>", "Text",ExpressionUUID->"b10aa59b-468a-41d3-b228-927847384f70"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"y", "'"}], 
    RowBox[{"(", "t", ")"}]}], "=", 
   RowBox[{"5", 
    RowBox[{"y", "(", "t", ")"}]}]}], 
  TraditionalForm]],ExpressionUUID->"a9a7a531-4837-4135-98e8-1613a9b511c0"]], \
"Text",ExpressionUUID->"a03556b5-fd10-49cf-9ecc-ad1b956738a8"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "''"}], 
     RowBox[{"(", "x", ")"}]}], "+", 
    RowBox[{"3", 
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}], "x"}]}], "=", 
   RowBox[{"sin", "(", "x", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"ae2e7fab-b5b2-46fa-b7d7-74036c98e8e6"]], \
"Text",ExpressionUUID->"99652e80-25ae-45b2-9d90-9b5008cf145d"],

Cell[TextData[{
 "While these equations are nonlinear due to the product of the derivative \
terms, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "e3015fba-0d11-404d-8c2f-7fcfb247bea9"],
 " being squared, and the ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}]], TraditionalForm]],ExpressionUUID->
  "b84aef46-b572-4d85-8cb6-192c67d83e10"],
 " term:"
}], "Text",ExpressionUUID->"2c4ff99c-8a57-494c-b33a-a98af6b57b33"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"y", "''"}], 
     RowBox[{"(", "t", ")"}], 
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}], "+", 
    SuperscriptBox[
     RowBox[{"y", "(", "t", ")"}], "2"]}], "=", "1"}], 
  TraditionalForm]],ExpressionUUID->"11c4df18-6e35-4685-b62b-5de08ace47e0"]], \
"Text",ExpressionUUID->"f2984bf4-104c-4d63-a24a-fb49cdae973f"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"y", "''"}], 
     RowBox[{"(", "t", ")"}]}], "+", 
    SqrtBox[
     RowBox[{
      RowBox[{"y", "'"}], 
      RowBox[{"(", "t", ")"}]}]], "+", 
    RowBox[{"y", "(", "t", ")"}]}], "=", "1"}], 
  TraditionalForm]],ExpressionUUID->"3316643a-41c5-47cd-b7b6-2f06aa7ec384"]], \
"Text",ExpressionUUID->"8df942ae-4930-4f61-9cc5-280b26868710"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Classifications of Linear Equations", \
"Subsection",ExpressionUUID->"79a83867-79b9-44f7-973f-25cfec082ef1"],

Cell[TextData[{
 "As stated, an ordinary differential equation is said to be ",
 StyleBox["linear",
  FontWeight->"Plain"],
 " if it can be written in the form",
 StyleBox[": ",
  FontWeight->"Plain"]
}], "Text",ExpressionUUID->"0115d03b-dc24-4d90-8d05-ab413ddf9a09"],

Cell[TextData[Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["a", "n"], "(", "t", ")"}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[DifferentialD]", "n"], 
          RowBox[{"y", "(", "t", ")"}]}], 
         RowBox[{"\[DifferentialD]", 
          SuperscriptBox["t", "n"]}]]}], "+"}], "..."}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "1"], "(", "t", ")"}], 
      FractionBox[
       RowBox[{"\[DifferentialD]", 
        RowBox[{"y", "(", "t", ")"}]}], 
       RowBox[{"\[DifferentialD]", "t"}]]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "0"], "(", "t", ")"}], 
      RowBox[{"y", "(", "t", ")"}]}]}], "=", 
    RowBox[{"g", "(", "t", ")"}]}],
   FontColor->GrayLevel[0]], TraditionalForm]], "Input",
 FontWeight->
  "Plain",ExpressionUUID->"2376e261-88ca-42e0-9ef2-eadf4e1b0e46"]], \
"Text",ExpressionUUID->"ea696672-1f88-4796-9694-0c58b4fc4891"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "t", ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"b852e89e-82fb-40bd-a871-c53f5efc1433"],
 ", the equation is said to be ",
 StyleBox["homogeneous",
  FontWeight->"Bold"],
 ":"
}], "Text",ExpressionUUID->"4243999e-7426-45bc-9c7d-0750c71537a3"],

Cell[TextData[Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["a", "n"], "(", "t", ")"}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[DifferentialD]", "n"], 
          RowBox[{"y", "(", "t", ")"}]}], 
         RowBox[{"\[DifferentialD]", 
          SuperscriptBox["t", "n"]}]]}], "+"}], "..."}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "1"], "(", "t", ")"}], 
      FractionBox[
       RowBox[{"\[DifferentialD]", 
        RowBox[{"y", "(", "t", ")"}]}], 
       RowBox[{"\[DifferentialD]", "t"}]]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "0"], "(", "t", ")"}], 
      RowBox[{"y", "(", "t", ")"}]}]}], "=", "0"}],
   FontColor->GrayLevel[0]], TraditionalForm]], "Input",
 FontWeight->
  "Plain",ExpressionUUID->"eef9064a-0fe6-4c4a-84d9-2f9e0dc1ef04"]], \
"Text",ExpressionUUID->"36fe9631-276b-48e5-a520-291c138db18e"],

Cell[TextData[{
 "When each ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "32951a1f-1d8a-426f-b77e-c9ba8cd87187"],
 " is a constant scalar, the equation is said to have ",
 StyleBox["constant coefficients",
  FontWeight->"Plain"],
 ":"
}], "Text",ExpressionUUID->"16f43b24-a706-404d-b65d-93fa2b400c58"],

Cell[TextData[Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["a", "n"], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[DifferentialD]", "n"], 
          RowBox[{"y", "(", "t", ")"}]}], 
         RowBox[{"\[DifferentialD]", 
          SuperscriptBox["t", "n"]}]]}], "+"}], "..."}], "+", 
     RowBox[{
      SubscriptBox["a", "1"], 
      FractionBox[
       RowBox[{"\[DifferentialD]", 
        RowBox[{"y", "(", "t", ")"}]}], 
       RowBox[{"\[DifferentialD]", "t"}]]}], "+", 
     RowBox[{
      SubscriptBox["a", "0"], 
      RowBox[{"y", "(", "t", ")"}]}]}], "=", 
    RowBox[{"g", "(", "t", ")"}]}],
   FontWeight->"Plain",
   FontColor->GrayLevel[0]], 
  TraditionalForm]], \
"Input",ExpressionUUID->"c645a020-90d1-4e9b-8d69-8089fc47f553"]], \
"Text",ExpressionUUID->"4b8eac9e-d84a-4177-940f-0a877cdb7662"],

Cell[TextData[StyleBox["The class of differential equations that are most \
understood is linear homogeneous equations with constant coefficients. ",
 FontColor->GrayLevel[
  0]]], "Text",ExpressionUUID->"ac80b8b1-0e87-4bb6-a43d-c11aaf953452"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples of Classifications", \
"Subsection",ExpressionUUID->"7cfdd3e0-1509-4957-8981-f819fec2dcd6"],

Cell["\<\
This is a first-order homogeneous linear equation with constant coefficients:\
\
\>", "Text",ExpressionUUID->"26f1b62e-afe5-4319-9c60-3dbb64b6b82f"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"y", "'"}], 
    RowBox[{"(", "t", ")"}]}], "=", 
   RowBox[{"y", "(", "t", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"fe5b963d-b6ed-44ff-a632-78cef6808e53"]], \
"Text",ExpressionUUID->"ece8310f-90af-43ff-9874-1711fffa95b1"],

Cell[TextData[{
 "Use ",
 ButtonBox["WolframAlpha",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/WolframAlpha.html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/WolframAlpha.html"],
 " to verify this classification:"
}], "Text",ExpressionUUID->"cafd881f-6682-45eb-93f4-e9e421f60c2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"WolframAlpha", "[", 
  RowBox[{"\"\<y'[t]\[Equal]y[t]\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<ODEClassification\>\"", ",", "1"}], "}"}], 
     ",", "\"\<Plaintext\>\""}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"cb266b19-aafe-4cee-92df-e86d18fe102f"],

Cell[BoxData["\<\"first-order linear ordinary differential equation\"\>"], \
"Output",ExpressionUUID->"6b64af99-bba7-47c7-901a-171acfd83bda"]
}, Open  ]],

Cell["This is a second-order nonhomogeneous equation:", \
"Text",ExpressionUUID->"1a06e254-0a19-4c75-aa2d-e4c63180eee3"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "''"}], 
     RowBox[{"(", "x", ")"}]}], "+", 
    RowBox[{"3", 
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}], "*", "x"}]}], "=", 
   RowBox[{"sin", "(", "x", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"3da714c4-262f-499a-9f9a-80b8ae2e73b8"]], \
"Text",ExpressionUUID->"07e8d079-0452-47db-a4a7-1224848392c9"],

Cell["Verify the classification:", \
"Text",ExpressionUUID->"4c927eaf-d7a5-46ba-984c-e76d6181a164"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"WolframAlpha", "[", 
  RowBox[{"\"\<f''(x)+3*x*f'(x)=sin(x)\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<ODEClassification\>\"", ",", "1"}], "}"}], 
     ",", "\"\<Plaintext\>\""}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"62552d22-bea7-4715-9769-b3db67b7fe0a"],

Cell[BoxData["\<\"second-order linear ordinary differential equation\"\>"], \
"Output",ExpressionUUID->"312a018f-d35c-4e01-a40d-757adcc384f5"]
}, Open  ]],

Cell["This differential equation is nonlinear:", \
"Text",ExpressionUUID->"0fa483d8-9270-437e-8b98-8736c097ba75"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"y", "''"}], 
     RowBox[{"(", "t", ")"}], 
     RowBox[{"y", "(", "t", ")"}]}], "+", 
    RowBox[{
     RowBox[{"y", "'"}], 
     RowBox[{"(", "t", ")"}]}]}], "=", "1"}], 
  TraditionalForm]],ExpressionUUID->"89063d95-c603-4dc6-842c-68d953c8e527"]], \
"Text",ExpressionUUID->"87fb6846-b1d5-465d-bfe3-7378634f6905"],

Cell["Confirm the nonlinearity with WolframAlpha:", \
"Text",ExpressionUUID->"0a48e94d-d723-4c74-b945-3f53583ca271"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"WolframAlpha", "[", 
  RowBox[{"\"\<y'(t)+y(t)y''(t)=1\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<ODEClassification\>\"", ",", "1"}], "}"}], 
     ",", "\"\<Plaintext\>\""}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"67eb7813-606d-47db-bfca-423f9dd0bfb1"],

Cell[BoxData["\<\"second-order nonlinear ordinary differential \
equation\"\>"], \
"Output",ExpressionUUID->"d4b9a6d8-6532-41c0-8e5a-3498bfa0d2db"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples of Classifications", \
"Subsection",ExpressionUUID->"3aa113e2-226b-407b-9d57-6177c883a8ad"],

Cell[TextData[{
 "This is a second-order nonhomogeneous equation when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "(", "t", ")"}], "\[NotEqual]", "0"}], TraditionalForm]],
  ExpressionUUID->"b4586258-5921-47d9-b020-2ca289785eaf"],
 ":"
}], "Text",ExpressionUUID->"ad3194aa-5edf-463b-a2ac-2f8887df124e"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"L", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[DifferentialD]", "2"], 
       RowBox[{"Q", "(", "t", ")"}]}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["t", "2"]}]]}], "+", 
    RowBox[{"R", 
     FractionBox[
      RowBox[{"\[DifferentialD]", 
       RowBox[{"Q", "(", "t", ")"}]}], 
      RowBox[{"\[DifferentialD]", "t"}]]}], "+", 
    RowBox[{
     FractionBox["1", "C"], 
     RowBox[{"Q", "(", "t", ")"}]}]}], "=", 
   RowBox[{"E", "(", "t", ")"}]}], 
  TraditionalForm]],ExpressionUUID->"289e8c90-0642-4bf8-9e9f-0332009f57e9"]], \
"Text",ExpressionUUID->"74f76f47-ecd3-4204-a5e0-d693c6339909"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"WolframAlpha", "[", 
  RowBox[{"\"\<L*Q''(t)+R*Q'(t)+Q(t)/c=E(t)\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<ODEClassification\>\"", ",", "1"}], "}"}], 
     ",", "\"\<Plaintext\>\""}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"2c091d16-e304-41e6-a368-afb8a8cae009"],

Cell[BoxData["\<\"second-order linear ordinary differential equation\"\>"], \
"Output",ExpressionUUID->"6b0cab13-aed2-4201-b4b4-21f5e90a439c"]
}, Open  ]],

Cell["This is a second-order nonlinear equation:", \
"Text",ExpressionUUID->"76107a3a-9efd-43a9-83eb-6471735c993d"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"2", "x", " ", 
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], "=", 
   RowBox[{
    RowBox[{"f", "''"}], 
    SuperscriptBox[
     RowBox[{"(", "x", ")"}], "5"]}]}], 
  TraditionalForm]],ExpressionUUID->"d7ef6e95-7822-4209-aa02-802fdbcda5f5"]], \
"Text",ExpressionUUID->"1a1ffeba-475c-45c1-8b85-0868be05ee10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"WolframAlpha", "[", 
  RowBox[{"\"\<2*x*f'(x)=f''(x)^5\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<ODEClassification\>\"", ",", "1"}], "}"}], 
     ",", "\"\<Plaintext\>\""}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"fad1788a-e83d-4209-8c26-9b6a38ce4da7"],

Cell[BoxData["\<\"second-order nonlinear ordinary differential \
equation\"\>"], \
"Output",ExpressionUUID->"839f31bd-1fda-405d-8ed5-2e3961303e6d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary", \
"Subsection",ExpressionUUID->"f47934a3-a03e-4be0-bd59-b989f2f66cb0"],

Cell[TextData[StyleBox["In an ordinary differential equation, the unknown \
function depends on a single independent variable, and only ordinary \
derivatives appear in the equation.",
 FontWeight->
  "Plain"]], "Text",ExpressionUUID->"82da916c-c70c-41b8-968f-a44801331bf0"],

Cell[TextData[StyleBox["The order of a differential equation is the order of \
the highest derivative that appears in the differential equation.",
 FontWeight->
  "Plain"]], "Text",ExpressionUUID->"d11e6a30-1d1f-43a1-a33b-aaef324ed112"],

Cell[TextData[StyleBox["An ordinary differential equation is said to be \
linear if it can be written in the form:",
 FontWeight->
  "Plain"]], "Text",ExpressionUUID->"9318015d-c9f0-4789-87b9-6ba5fb22bfbd"],

Cell[TextData[Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["a", "n"], "(", "t", ")"}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[DifferentialD]", "n"], 
          RowBox[{"y", "(", "t", ")"}]}], 
         RowBox[{"\[DifferentialD]", 
          SuperscriptBox["t", "n"]}]]}], "+"}], "..."}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "1"], "(", "t", ")"}], 
      FractionBox[
       RowBox[{"\[DifferentialD]", 
        RowBox[{"y", "(", "t", ")"}]}], 
       RowBox[{"\[DifferentialD]", "t"}]]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "0"], "(", "t", ")"}], 
      RowBox[{"y", "(", "t", ")"}]}]}], "=", 
    RowBox[{"g", "(", "t", ")"}]}],
   FontColor->GrayLevel[0]], TraditionalForm]], "Input",
 FontWeight->
  "Plain",ExpressionUUID->"17382e50-1642-4a3b-ba99-686ecb62acb3"]], \
"Text",ExpressionUUID->"a4eaeae1-b43f-441c-87fe-d972d182e8d2"],

Cell[TextData[{
 "Ordinary differential equations that ",
 StyleBox["are homogeneous, linear and have constant coefficients ",
  FontColor->GrayLevel[0]],
 "are the most understood class of equations. "
}], "Text",ExpressionUUID->"8d5406a9-6845-42a0-a1c3-b154d1616dc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CellPrint", "[", 
  RowBox[{"ExpressionCell", "[", 
   RowBox[{
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "\[Rule]", "2"}], ",", 
        RowBox[{"2", "\[Rule]", "5"}], ",", 
        RowBox[{"1", "\[Rule]", "3"}], ",", 
        RowBox[{"4", "\[Rule]", "7"}], ",", 
        RowBox[{"2", "\[Rule]", "4"}], ",", 
        RowBox[{"4", "\[Rule]", "6"}], ",", 
        RowBox[{"6", "\[Rule]", "8"}]}], "}"}], ",", 
      InterpretationBox[
       DynamicModuleBox[{Typeset`open = False}, 
        TemplateBox[{"List", 
          StyleBox[
          "\"Options\"", "IconizedCustomName", StripOnInput -> False], 
          GridBox[{{
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["List", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["3", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["2104", "IconizedItem"]}]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
           "Column", 
           GridBoxItemSize -> {
            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
          Dynamic[Typeset`open]},
         "IconizedObject"]],
       {VertexLabels -> {
         1 -> "Differential Equation", 2 -> "ODE", 3 -> "PDE", 4 -> "Linear", 
          5 -> "Nonlinear", 6 -> "Homogeneous", 7 -> "Nonhomogeneous", 8 -> 
          "Constant Coefficients"}, 
        VertexCoordinates -> {{0, 0.5}, {1, 1}, {2, 0.25}, {1, 0}, {2, 1}, {
          3, 0.5}, {3, 1}, {4, 1}}, PlotLabel -> 
        "Classification of Differential Equations"},
       SelectWithContents->True,
       Selectable->False]}], "]"}], ",", 
