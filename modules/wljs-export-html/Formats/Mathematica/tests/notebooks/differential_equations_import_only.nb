          BaseStyle->"Graphics"]}, {DiskBox[{3., 1.}, 0.03700564971751412], 
         InsetBox["\<\"Homogeneous\"\>", 
          Offset[{2, 2}, {3.037005649717514, 1.0370056497175142}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {DiskBox[{4., 1.}, 0.03700564971751412], 
