Cell[BoxData[""], "Input",ExpressionUUID->"1003df9d-b179-4148-98cc-5880828a2d86"],

Cell[TextData[{
 "convertor crustallographics coordinates ",
 Cell[BoxData[
  FormBox["->", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b1cb4de5-9dce-4ab9-a6be-fa43d3958eb6"],
 " fraction coordinates"
}], "Text",ExpressionUUID->"0f0bb298-39db-4831-9865-7ced1f7df718"],

Cell[BoxData[
 RowBox[{
  RowBox[{"toFraction", ":=", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{
          FractionBox[
           RowBox[{"(", 
            RowBox[{"b", "+", 
             RowBox[{"0.5", " ", "a"}]}], ")"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"b", "+", 
              RowBox[{"0.5", " ", "a"}]}], ")"}], ".", 
            RowBox[{"(", 
             RowBox[{"b", "+", 
              RowBox[{"0.5", " ", "a"}]}], ")"}]}]], ".", "#"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"B", "=", 
         RowBox[{
          FractionBox["a", 
           RowBox[{"a", ".", "a"}]], ".", "#"}]}], ",", " ", 
        RowBox[{"CC", "=", 
         FractionBox[
          RowBox[{"c", ".", "#"}], 
          RowBox[{"c", ".", "c"}]]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"0.5", " ", "A"}], "+", "B"}], ")"}], ",", "A", ",", "CC"}],
        "}"}]}], "\[IndentingNewLine]", "]"}], "&"}]}], ";"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"f6350d03-e381-422c-8493-ddfe097c7696"],

Cell["cut 1x1x1 piece from the middle", "Text",ExpressionUUID->"5e3d667a-12e6-4506-acf7-56897035ce9d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ExpandCrystal", "[", 
  RowBox[{"\"\<Fe2Mo3O8\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"$CrystalData", "[", "\"\<Fe2Mo3O8_3x3x3\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"data", "[", 
      RowBox[{"\"\<LatticeParameters\>\"", ",", "\"\<a\>\""}], "]"}], 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{"Quantity", ":>", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", "x"}], "]"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"\"\<LatticeParameters\>\"", ",", "\"\<b\>\""}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{"Quantity", ":>", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], ",", "x"}], "]"}]}], "}"}]}], 
     ")"}], 
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{
       RowBox[{"120", "\[Degree]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ".", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"\"\<LatticeParameters\>\"", ",", "\"\<c\>\""}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{"Quantity", ":>", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], ",", "x"}], "]"}]}], "}"}]}], 
     ")"}], 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"count", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"flag", "=", "False"}], ";", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"res", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"ArrayQ", "[", "#", "]"}], ",", "\[IndentingNewLine]", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"cryst", "=", 
                   RowBox[{
                    RowBox[{"#", ".", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "-", "a", "-",
                     "b", "-", "c"}]}], "}"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"RegionMember", "[", 
                    RowBox[{
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"r", "=", 
                    RowBox[{"Parallelepiped", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}]}], 
                    "}"}], ",", 
                    RowBox[{"Translate", "[", 
                    RowBox[{
                    RowBox[{"Scale", "[", 
                    RowBox[{
                    RowBox[{"Translate", "[", 
                    RowBox[{"r", ",", 
                    RowBox[{"-", 
                    RowBox[{"RegionCentroid", "@", "r"}]}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1.2", ",", "1.2", ",", "1.4"}], "}"}]}], "]"}], 
                    ",", 
                    RowBox[{"RegionCentroid", "@", "r"}]}], "]"}]}], "]"}], 
