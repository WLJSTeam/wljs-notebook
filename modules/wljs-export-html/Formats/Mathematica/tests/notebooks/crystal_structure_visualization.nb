Cell[BoxData[{
 RowBox[{
  RowBox[{"polyhedra", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"x", ",", 
         RowBox[{"Translate", "[", 
          RowBox[{
           RowBox[{"GraphicsComplex", "[", 
            RowBox[{
             RowBox[{"MeshCoordinates", "[", "x", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Red", ",", 
               RowBox[{"MeshCells", "[", 
                RowBox[{"x", ",", "0"}], "]"}], ",", "Thick", ",", 
               RowBox[{"Darker", "@", "Gray"}], ",", 
               RowBox[{"MeshCells", "[", 
                RowBox[{"x", ",", "1"}], "]"}], ",", 
               TemplateBox[<|"color" -> RGBColor[0., 0.56, 0.8]|>,
                "RGBColorSwatchTemplate"], ",", 
               RowBox[{"MeshCells", "[", 
                RowBox[{"x", ",", "2"}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"#", "[", "\"\<pos\>\"", "]"}]}], "]"}]}], "]"}], "@", 
       RowBox[{"ConvexHullMesh", "@", 
        RowBox[{"#", "[", "\"\<ligands\>\"", "]"}]}]}], "&"}], ")"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{"ligands", ",", 
      RowBox[{"Function", "[", 
       RowBox[{"ion", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"ion", "[", "\"\<pos\>\"", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ">", "3"}], "&&", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "<", "7"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"colors", "@", 
        RowBox[{"#", "@", "\"\<Element\>\""}]}], ",", 
       RowBox[{"Sphere", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<FractionalCoordinates\>\"", "]"}], ".", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], ",", 
         RowBox[{"radius", "@", 
          RowBox[{"#", "@", "\"\<Element\>\""}]}]}], "]"}]}], "}"}], "&"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{"mashup", ",", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"ion", ",", " ", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
