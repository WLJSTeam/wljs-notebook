Cell["Find All Fe ions and corresponding ligands", "Text",ExpressionUUID->"dc807dd3-68e2-43f9-9e83-3fa10733a061"],

Cell[BoxData[""], "Input",ExpressionUUID->"c8990922-e0a8-45d1-a99a-53784496e54f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mashup", "=", 
    RowBox[{"$CrystalData", "[", 
     RowBox[{"\"\<Fe2Mo3O8_3x3x3\>\"", ",", "\"\<AtomData\>\""}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ligands", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pos", " ", "=", " ", 
         RowBox[{
          RowBox[{"#", "[", "\"\<FractionalCoordinates\>\"", "]"}], ".", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c"}], "}"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ligs", "=", 
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", "\"\<FractionalCoordinates\>\"", "]"}], 
                  ".", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "-", "pos"}], 
                ")"}], "&"}], "/@", 
              RowBox[{"Select", "[", 
               RowBox[{"mashup", ",", 
                RowBox[{"Function", "[", 
                 RowBox[{"x", ",", 
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "[", "\"\<FractionalCoordinates\>\"", "]"}], 
                    ".", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "-", "pos"}], 
                    ")"}], "]"}], "<", "3"}]}], "]"}]}], 
               "\[IndentingNewLine]", "]"}]}], ",", "1"}], "]"}]}], "}"}], 
         ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<pos\>\"", "->", "pos"}], ",", 
           RowBox[{"\"\<ligands\>\"", "->", "ligs"}], ",", " ", 
           RowBox[{"\"\<n\>\"", "->", 
            RowBox[{"Length", "@", "ligs"}]}]}], "|>"}]}], 
        "\[IndentingNewLine]", "]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{"mashup", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "\"\<Element\>\"", "]"}], "===", "\"\<Fe2+\>\""}], 
       "&"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.887777988226872*^9, {3.887778172255636*^9, 3.887778172529291*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"f690b25a-8095-4d8a-b462-54da0fc8c8e9"],

Cell["Calculate spherical tensors", "Text",ExpressionUUID->"23a4f9ee-dfc7-4795-a309-ce8c625adaf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalTensor", "[", 
   RowBox[{"k_", ",", "q_", ",", "t_", ",", "p_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox[
     RowBox[{"4", "\[Pi]"}], 
     RowBox[{
      RowBox[{"2", "k"}], "+", "1"}]]], 
