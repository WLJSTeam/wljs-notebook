

Component[OptionsPattern[]] := With[{EventChannel = CreateUUID[], decode = OptionValue["Decoder"], Color = If[StringQ[#], #, "{Color}"]& @ (OptionValue["Parameters"]["AccentColor"]), Path = OptionValue["Path"], Messager = OptionValue["Messanger"], Controls = OptionValue["Controls"], iframeQ = OptionValue["IframeQ"]},  
  EventHandler[EventChannel, Function[Null,
    With[{client = $CurrentWebSocket(*`*)},
    Echo[client, "[wljs-export-html/Loader] client: "];
   
    
    With[{p = decode[Path, "Messager"->Messager, "Query" -> OptionValue["Query"], "Client"->client]},
            Echo[p, "[wljs-export-html/Loader] p: "];
            Then[p, Function[result,
              Pause[1];
              Echo["[wljs-export-html/Loader] Loader configuration:"];
              Echo[result, "[wljs-export-html/Loader] operation result: "];
              (*/*EventFire[spinner["Promise"], Resolve, True];*/*)
              Which[
                StringQ[result],
                  If[iframeQ, 
                    Echo[WebUILocation[ StringJoin["/iframe/", URLEncode[ result ] ], client ], "[wljs-export-html/Loader] Embedded-notebook navigation result: "];
                  ,
                    Echo[WebUILocation[ StringJoin["/", URLEncode[ result ] ], client ], "[wljs-export-html/Loader] Notebook navigation result: "];
                  ]
                ,

                ListQ[result],
                  Echo[WebUILocation[ StringJoin[result[[1]], URLEncode[ result[[2]] ] ], client ], "[wljs-export-html/Loader] Custom navigation result: "];
                ,

                AssociationQ[result],
                  Switch[result["Type"],
                    "MultipleWindows",
                      Echo[result["Paths"], "[wljs-export-html/Loader] Multiple-window export paths: "];
                      If[iframeQ, 
                        
                        Do[
                          Echo[WebUILocation[ StringJoin["/iframe/", URLEncode[ i ] ], client, "Target"->_, "Features"->"left=100,top=100" ], "[wljs-export-html/Loader] Embedded-window navigation result: "];
                        , {i, Drop[result["Paths"], 1] // Reverse }];

                           WebUILocation[ StringJoin["/iframe/", URLEncode[ result["Paths"][[1]] ] ], client ]
                      ,
                        
                        Do[
                          Echo[StringJoin["[wljs-export-html/Loader] Navigating to embedded notebook URL: /", URLEncode[i]]];
                          Echo[WebUILocation[ StringJoin["/", URLEncode[ i ] ], client, "Target"->_, "Features"->"left=100,top=100" ], "[wljs-export-html/Loader] Window navigation result: "];
                        , {i, Drop[result["Paths"], 1] // Reverse }];

                        Echo[WebUILocation[ StringJoin["/", URLEncode[ result["Paths"][[1]] ] ], client ], "[wljs-export-html/Loader] Primary-window navigation result: "];
                        
                         
                      ];
                    ,

                    True,
                      Echo["[wljs-export-html/Loader] Unknown loader message"];
                      WebUISubmit[Alert[ToString[result]], client];
                  ];
              ];

            ]];

        ];
    ];
  ]];

  With[{Class = StringTemplate["inline-flex items-center rounded-md bg-``-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-``-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-``-600"][Color, Color, Color]},

    <div class="text-center my-auto mx-auto max-w-lg">
        <WebUIOnLoad Event={EventChannel}/>
    </div>
  ]
]

Options[Component] = {"Parameters"-><|"AccentColor" -> "teal"|>, "Query" -> <||>, "Event" -> Null, "Messager" -> Null, "Path" -> "", "IframeQ"->False, "Controls" -> "", "Client"->Null};

Component
