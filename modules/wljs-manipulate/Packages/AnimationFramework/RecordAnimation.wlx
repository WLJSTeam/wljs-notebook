Component[JSHandler_, s_, epilog_] := With[{
      Scripts = 
        <script type="module">
          let delayTime = 100;

          function delay(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
          }
          
          core['<JSHandler/>'] = async (args, env) => {
            const type = await interpretate(args[0], env);
            console.log('type:', type);
            return await core['<JSHandler/>'][type](args.slice(1), env);
          }
          
          core['<JSHandler/>'].Export =  async (args, env) => {
            const payload = await interpretate(args[0], env);
            const promise = new Deferred();
            console.log('export');

            electronAPI.binaryBlobWrite(payload, (res) => {
              promise.resolve(res);
            });

            return promise.promise;            
          }
          
          core['<JSHandler/>'].Capture =  async (args, env) => {
            const rect = env.element.getBoundingClientRect();
            const promise = new Deferred();
            console.log('capture');

            await delay(delayTime);

            electronAPI.requestScreenshot({x:rect.x, y:rect.y, width:rect.width, height:rect.height, toBlob:true}, (res) => {
              promise.resolve(res);
              console.log(res);
            });

            return promise.promise;            
          }


        </script>
    },


      With[{GraphicsCanvas = Graphics[{
        s["GlobalDirectives"], s["Ref"]
      }, "TransitionType"->None, "Controls"->False, "GUI"->False, Epilog->epilog, Sequence @@ Normal[KeyDrop[s["Options"], {"Epilog"}]]]
    },
        <div class="w-full h-full">
            <GraphicsCanvas/>
            <Scripts/>
        </div>
      ]
 ];

Component