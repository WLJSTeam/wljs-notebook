makeScript[_, _, _] := ""
makeScript[_, _, _, _] := ""
makeScript[_, Event_String, Topic_String, True] := (
    <script type="module">
        const el = document.getElementById('#instanceId');
        el.addEventListener('input', () => {
            server.kernel.emitt('<Event/>', 'URLDecode["'+encodeURIComponent(el.value)+'"]', '<Topic/>')
        })
    </script>
)

makeScript[_, Event_String, {TopicChange_String, _}, True] := (
    <script type="module">
        const el = document.getElementById('#instanceId');
        el.addEventListener('input', () => {
            server.kernel.emitt('<Event/>', 'URLDecode["'+encodeURIComponent(el.value)+'"]', '<TopicChange/>')
        })
    </script>    
)

makeScript[_, Event_String, {_, TopicBlur_String}, True] := (
    <script type="module">
        const el = document.getElementById('#instanceId');
        el.addEventListener('blur', () => {
            server.kernel.emitt('<Event/>', 'URLDecode["'+encodeURIComponent(el.value)+'"]', '<TopicBlur/>')
        })
    </script>    
)

makeScript[_, Event_String, {TopicChange_String, TopicBlur_String}, True] := (
    <script type="module">
        const el = document.getElementById('#instanceId');
        el.addEventListener('blur', () => {
            server.kernel.emitt('<Event/>', 'URLDecode["'+encodeURIComponent(el.value)+'"]', '<TopicBlur/>')
        })        
        el.addEventListener('blur', () => {
            server.kernel.emitt('<Event/>', 'URLDecode["'+encodeURIComponent(el.value)+'"]', '<TopicBlur/>')
        })
    </script>    
)

Component[value_:"", OptionsPattern[]] := With[{
    event = OptionValue["Event"], size = OptionValue[ImageSize], Label = OptionValue["Label"], Descp = OptionValue["Description"], Placeholder = OptionValue["Placeholder"], topic = OptionValue["Topic"],
    EditableQ = OptionValue["Editable"]
},{
    ClassName = With[{c=If[OptionValue[Appearance] === Automatic, 
        "relative cursor-default rounded-md pl-3 pr-2 text-left text-gray-900 slbl text-xs py-1 bg-white wljs-card",
        "relative cursor-default slbl rounded-md text-left border-0 text-xs"
    ]}, If[EditableQ === True, StringJoin[c," h-6 wljs-card "], c]],
    CSSStyle = StringJoin[OptionValue["CSS"], " ", OptionValue["Style"]],
    LabelClass = OptionValue["LabelClass"],
    LabelStyle = OptionValue["LabelStyle"]
},
{
FinalCSS = StringJoin[If[ListQ[size], StringTemplate["width: ``px;height: ``px;overflow:auto;"][Round[size[[1]]], Round[size[[2]]]], StringTemplate["width: ``px;overflow:auto;"][Round[size]]], If[EditableQ, "border:1px solid #e1e1e1;", ""] , CSSStyle]
},
{
    InitialValue = ToString[value]
},
  {
    If[EditableQ === True,
        <div class="sm-controls">
            <label for="#instanceId" class="block text-sm  leading-6 text-gray-900 {LabelClass}" style="{LabelStyle}"><Label/></label>
            <div class="mt-1">
              <input id="#instanceId" style="{FinalCSS}" data-type="text-string" value="{value}" type="text" class="focus:ring-2 {ClassName}" placeholder="{Placeholder}"/>
            </div>
            <p class="mt-1 text-sm text-gray-500"><Descp/></p>
        </div>
    ,
        <div class="sm-controls">
            <label for="#instanceId" class="block text-sm  leading-6 text-gray-900 {LabelClass}" style="{LabelStyle}"><Label/></label>
            <div class="mt-1">
              <div id="#instanceId" style="{FinalCSS}" data-type="text-string" class="{ClassName}">...</div>
            </div>
            <p class="mt-1 text-sm text-gray-500"><Descp/></p>
        </div>
    ]
  ,
    makeScript[_, event, topic, EditableQ]
  }
]

Options[Component] = {"CSS"->"", "Style"->"", "Placeholder"->"Type here...", Appearance->Automatic, ImageSize->Automatic, "Label"->"", "Description"->"", "UId":>CreateUUID[], "Event"->Null, "Topic"->"Default", "LabelClass"->"", "LabelStyle"->"", "Editable"->True}

Component