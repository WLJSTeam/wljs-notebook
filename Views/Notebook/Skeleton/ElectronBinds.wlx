Component[OptionsPattern[]] := With[{
    Event    = OptionValue["Event"],
    Controls = OptionValue["Controls"]
},

<script type="module">
    const api = window.electronAPI || window.iframeAPI;
    if (api) {
        api.listener('abort', () => {
            server.io.fire('<Controls/>', true, 'Abort');
        });
        api.listener('changekernel', () => {
            server.io.fire('<Controls/>', true, 'ChangeKernel');
        });

        api.listener('save', () => {
            server.io.fire('<Controls/>', true, 'Save');
        });

        api.listener('saveas', (ev, path) => {
            server.io.fire('<Controls/>', String(path), 'SaveAs');
        });

        api.listener('reopenasquick', (ev) => {
            server.io.fire('<Controls/>', true, 'ReopenAsQuickNote');
        });
        

        api.listener('unhideallcells', () => {
            server.io.fire('<Controls/>', true, 'UnhideAllCells');
        });

        api.listener('clearoutputs', () => {
            server.io.fire('<Controls/>', true, 'ClearOutputs');
        });

        api.listener('togglecell', () => {
            server.io.fire('<Controls/>', true, 'ToggleFocusedCell');
        });

        api.listener('deletecell', () => {
            server.io.fire('<Controls/>', true, 'DeleteFocusedCell');
        });

        api.listener('untrashcell', () => {
            server.io.fire('<Controls/>', true, 'UntrashCell');
        });
    
        api.listener('evaluateinit', () => {
            server.io.fire('<Controls/>', true, 'EvaluateInitCells');
        });

        api.listener('evaluateall', () => {
            server.io.fire('<Controls/>', true, 'EvaluateAllCells');
        });
        
    } else {
        window.addEventListener("keydown", function (e) {
            if (e.ctrlKey && e.key == "s" || e.metaKey && e.key == "s") {
                server.io.fire('<Controls/>', true, 'Save');
                e.preventDefault();
                return false;
            }
            if (e.altKey && e.key == "." || e.metaKey && e.key == ".") {
                server.io.fire('<Controls/>', true, 'Abort');
                e.preventDefault();
                return false;
            }           
            
            if (e.altKey && e.key == "2" || e.metaKey && e.key == "2") {
                server.io.fire('<Controls/>', true, 'ToggleFocusedCell');
                e.preventDefault();
                return false;
            }
        });
    }
</script>
];

Options[Component] = {"Controls"->"", "Event"->""};

Component