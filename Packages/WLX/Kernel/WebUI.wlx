(* /* WLX Lazy loader */ *)
(* /* holds expressions inside and loads by a signal via WebSockets */ *)

WebUIServerReference = If[TrueQ[Internal`Kernel`WLJSQ], "kernel", "self"];

UILazyLoad; (* Private *)
(* System`WebUIContainerChild;  removed from system *)
(* System`WebUILazyLoadDataProvided; removed from system *)

WebUILazyLoad[content_, OptionsPattern[]] := With[{event = EventClone[OptionValue["Event"]], uid = CreateUUID[], tag = OptionValue["Tag"], class = OptionValue["Class"]},
    EventHandler[event, {
        
    "Load" -> Function[data,
      Block[{WebUILazyLoadDataProvided = data},
        If[AssociationQ[data],
            If[KeyExistsQ[data, "Downvalues"],
                With[{data = content @@ (data["Downvalues"])},
                    WLJSTransportSend[UILazyLoad["Load", uid, ToString[data] ], data["Client"]];
                ]
            ,
                WLJSTransportSend[UILazyLoad["Load", uid, ToString[content] ], data["Client"]];
            ]
        ,
            WLJSTransportSend[UILazyLoad["Load", uid, ToString[content] ], $CurrentWebSocket];
        ]
      ]
    ],

    "Remove" -> Function[data,
        WLJSTransportSend[UILazyLoad["Remove", uid], data["Client"]];
    ],

    "Hide" -> Function[data,
        WLJSTransportSend[UILazyLoad["Hide", uid], data["Client"]];
    ],

    "Show" -> Function[data,
        WLJSTransportSend[UILazyLoad["Show", uid], data["Client"]];
    ]

    }];

    StringJoin["<", tag, " id=\"", uid, "\" class=\"", class, "\">", "<", "/", tag, ">"]
];

Options[WebUILazyLoad] = {"Event" -> "", "Tag" -> "div", "Class" -> ""};

SetAttributes[WebUILazyLoad, HoldFirst];

UILocation; (* Private *)
UILocationBlank; (* Private *)

WebUISubmit = WLJSTransportSend;

WebUILocation[loc_String, client_:$CurrentWebSocket , OptionsPattern[]] := With[{},
    If[OptionValue["Target"] === _,
        WebUISubmit[UILocationBlank[loc, "Features"->OptionValue["Features"]], client]
    ,
        WebUISubmit[UILocation[loc], client]
    ]
]

Options[WebUILocation] = {"Target" -> "Same", "Features"->False}

UIClose; (* Private *)

WebUIClose[cli_:$CurrentWebSocket ] := WebUISubmit[UIClose[], cli]
WebUIClose[cli_:$CurrentWebSocket , "Reload"] := WebUISubmit[UIClose["Reload"], cli]


(* /* WLX Refresher */ *)
(* /* holds expressions inside and loads by a signal via WebSockets */ *)

WebUIRefresh[Content__, OptionsPattern[]] := With[{event = OptionValue["Event"], uid = OptionValue["UId"], style = OptionValue["Style"], Class = OptionValue["Class"], Str = StringRiffle[{Content} // Flatten]},
    EventHandler[event, {
        
    "Refresh" -> Function[data,
        If[KeyExistsQ[data, "Downvalues"],
            With[{data = Content @@ (data["Downvalues"])},
                WLJSTransportSend[UILazyLoad["Load", uid, ToString[data] ], data["Client"]];
            ]
        ,
            WLJSTransportSend[UILazyLoad["Load", uid, ToString[StringRiffle[{Content}]] ], data["Client"] ];
        ];
    ],

    "Clear" -> Function[data,
        WLJSTransportSend[UILazyLoad["Load", uid, "" ], data["Client"]];
    ],

    "Hide" -> Function[data,
        WLJSTransportSend[UILazyLoad["Hide", uid], data["Client"]];
    ],
    
    "Show" -> Function[data,
        WLJSTransportSend[UILazyLoad["Show", uid], data["Client"]];
    ]    

    }];


    <div id="{uid}" class="{Class}" style="{style}">
        <Str/>
    </div>
];

Options[WebUIRefresh] = {"Event" -> "", "Class"->"", "Style"->"", "UId" :> CreateUUID[]};

SetAttributes[WebUIRefresh, HoldAll];

(* /* WebUIContainer */ *)

UILazyContainer; (* Private *)

WebUIContainerChild; (* Package symbol  *)

WebUIContainer[arg_, OptionsPattern[]] := With[{Uid = CreateUUID[], Event = OptionValue["Event"], after = OptionValue["ApplyAfter"]},
    EventHandler[EventClone[Event], {
        "Append" -> Function[data,
            If[AssociationQ[data["Data"]],
                WLJSTransportSend[UILazyContainer["AppendAfterParent", Uid,  data["Data"]["HTML"], If[KeyExistsQ[data, "ApplyAfter"], data["ApplyAfter"], after] ], data["Client"]];
                WLJSTransportSend[UILazyContainer["AppendScript", data["Data"]["Script"]] , data["Client"]];
            ,
                WLJSTransportSend[UILazyContainer["AppendAfterParent", Uid,  data["Data"], If[KeyExistsQ[data, "ApplyAfter"], data["ApplyAfter"], after] ], data["Client"]];
            ]
        ],

        "Prepend" -> Function[data,
            If[AssociationQ[data["Data"]],
                WLJSTransportSend[UILazyContainer["AppendBeforeParent", Uid,  data["Data"]["HTML"], If[KeyExistsQ[data, "ApplyAfter"], data["ApplyAfter"], after]], data["Client"] ];
                WLJSTransportSend[UILazyContainer["AppendScript", data["Data"]["Script"]], data["Client"] ];
            ,
                WLJSTransportSend[UILazyContainer["AppendBeforeParent", Uid,  data["Data"], If[KeyExistsQ[data, "ApplyAfter"], data["ApplyAfter"], after] ], data["Client"]];
            ]
        ]        
    }];

    Block[{WebUIContainerChild = <div id="{Uid}"></div>},
        With[{result = arg},
            result
        ]
    ]
]

SetAttributes[WebUIContainer, HoldFirst];
Options[WebUIContainer] = {"Event" -> Null, "ApplyAfter" -> Identity};

(* /* WLX JS Binder */ *)
(* /* connects arbitary JS scripts with WL Event system */ *)

UILazyEventDispatch; (* Private *)

WebUIJSBind[Script__String, OptionsPattern[]] := With[{Event = OptionValue["Event"], Uid = CreateUUID[], Str = StringJoin[Script]},
    EventHandler[EventClone[Event], {any_String :> Function[data,
        If[!AssociationQ[data], Return[]];
        WLJSTransportSend[UILazyEventDispatch[Uid, any, data], data["Client"]];
    ]}];

    If[!OptionValue["ScriptTag"],
        <Dummy>
            new UIJSScript({target: async function() {<Str/>}, uid: '<Uid/>'})
        </Dummy>
    ,
        <script type="module">
            new UIJSScript({target: async function() {<Str/>}, uid: '<Uid/>'})
        </script>
    ]
]

Options[WebUIJSBind] = {"Event" -> "", "ScriptTag"->True};

WebUIOnLoad[OptionsPattern[]] := With[{Event = OptionValue["Event"], Type = OptionValue["Pattern"]},
    <script type="module">
        server.<WebUIServerReference/>.io.fire('<Event/>', 'True', '<Type/>');
    </script>
]


Options[WebUIOnLoad] = {"Event" -> "xyz", "Pattern"->"Default"};

(* /* WLX Event listener */ *)
(* /* adds an event listener to an DOM element and sends generated data to Kernel via WebSockets */ *)


WebUIEventListener[OptionsPattern[]] := With[{Pattern = OptionValue["Pattern"], Property = OptionValue["Property"], Event = OptionValue["Event"], Type = OptionValue["Type"], Id = OptionValue["Id"]},
    <script type="module">
        const el = document.getElementById('<Id/>');
        el.addEventListener('<Type/>', function (e) {
            server.<WebUIServerReference/>.io.fire('<Event/>', String(el.<Property/>), '<Pattern/>');
        });
    </script>
];

Options[WebUIEventListener] = {"Event"->"", "Type"->"click", "Id"->"", "Pattern"->"Button", "Property"->"value"};

WebUIKeyListener[OptionsPattern[]] := With[{Pattern = OptionValue["Pattern"], Event = OptionValue["Event"], InternalEvent = CreateUUID[]},
    EventHandler[Event, {"Start" -> Function[data, WebUISubmit[UILazyEventDispatch[InternalEvent, "Start", True], data["Client"]]], "Stop" -> Function[pdata, WebUISubmit[UILazyEventDispatch[InternalEvent, "Stop", True], pdata["Client"]]]}];

    <script type="module">
        const keyListener = (e) => {
            console.log(['<Event/>', e.keyCode, '<Pattern/>']);
            server.<WebUIServerReference/>.io.fire('<Event/>', e.keyCode, '<Pattern/>');
        }
        core['CoffeeLiqueur`WLX`WebUI`Private`UILazyEventDispatch']['<InternalEvent/>'] = function (type, data, env) {
            console.log(type);
            switch (type) {
                case 'Start':
                    document.addEventListener('keydown', keyListener);
                break;
                case 'Stop':
                    document.removeEventListener('keydown', keyListener);
                break;
            }
        };
    </script>
];

Options[WebUIKeyListener] = {"Event"->"", "Pattern"->"Pressed"};

UIAsk; (* Private *)

WebUIFetch[expr_, client_:$CurrentWebSocket, OptionsPattern[]] := With[{event = CreateUUID[], promise = Promise[]},
    EventHandler[event, Function[payload,
        EventRemove[event];
        If[FailureQ[result],
            EventFire[promise, Reject, result]
        ,
            EventFire[promise, Resolve, result]
        ]
    ]];

    If[FailureQ[WebUISubmit[UIAsk[expr, event], client]],
        EventFire[promise, Reject, $Failed];
    ];

    promise
]

(* /* PUT IT TO THE HEADER */ *)
WebUIInitializationScript = With[{},
    <script type="module">
        core['CoffeeLiqueur`WLX`WebUI`Private`UIAsk'] = async (args, env) => {
            const result = await interpretate(args[0]);
            const uid = await interpretate(args[1]);
            console.warn("A request from server");
            server.<WebUIServerReference/>.io.fire(uid, result);
        }
        
        let unload = false;
        core['CoffeeLiqueur`WLX`WebUI`Private`UIClose'] = async (args, env) => {
            console.warn('close');
            if (unload) return;
            if (args.length > 0) {window.location.reload(); return;}
            window.close();
        }

        window.addEventListener('beforeunload', function (e) {
            console.warn('unload');
            //prevent closing the window if a user reloaded the current one
            unload = true;
        });

        core['CoffeeLiqueur`WLX`WebUI`Private`UILocation'] = async (args, env) => {
            const url = await interpretate(args[0], env);
            server.socket.close();
            window.location = url;
        }

        core['CoffeeLiqueur`WLX`WebUI`Private`UILocationBlank'] = async (args, env) => {
            const opts = await core._getRules(args, env);
            const url = await interpretate(args[0], env);

            if (opts.Features) {
                console.warn('Custom window open');
                window.open(url, 'Window', opts.Features);
            } else {
                const fake = document.createElement('a');
                fake.target = "_blank";
                fake.href = url;
                fake.click();
            }
        }        

        const uilc = async (args, env) => {
            const type = await interpretate(args[0], env);
            await uilc[type](args.slice(1), env);
        }

        uilc.AppendAfterParent = async (args, env) => {
            const uid = await interpretate(args[0], env);
            const data = await interpretate(args[1], env);

            const after = args[2];

            const element = document.getElementById(uid).parentNode;
            let length = element.childNodes.length;

            element.insertAdjacentHTML("afterbegin", data);
            length = element.childNodes.length - length;

            for (let i=0; i<length; ++i) {
                interpretate(after, {...env, element: element.childNodes[i]});
            }
            //execute scripts
            const scriptList = element.firstChild;
            console.log(scriptList);
            if (scriptList.nodeType === 1) Array.from(scriptList.querySelectorAll("script")).forEach( oldScriptEl => {
              const newScriptEl = document.createElement("script");
              
              Array.from(oldScriptEl.attributes).forEach( attr => {
                newScriptEl.setAttribute(attr.name, attr.value) 
              });
              
              const scriptText = document.createTextNode(oldScriptEl.innerHTML);
              newScriptEl.appendChild(scriptText);
              
              oldScriptEl.parentNode.replaceChild(newScriptEl, oldScriptEl);
          });
        }

        uilc.AppendBeforeParent = async (args, env) => {
            const uid = await interpretate(args[0], env);
            const data = await interpretate(args[1], env);

            const after = args[2];

            const element = document.getElementById(uid).parentNode;
            let length = element.childNodes.length;

            element.insertAdjacentHTML("beforeend", data);

            length = element.childNodes.length - length;
            for (let i=0; i < length; ++i) {
                interpretate(after, {...env, element: element.childNodes[element.childNodes.length - i - 1]});
            }
     
            //execute scripts
            const scriptList = element.lastChild;
            console.log(scriptList);
            if (scriptList.nodeType === 1) Array.from(scriptList.querySelectorAll("script")).forEach( oldScriptEl => {
              const newScriptEl = document.createElement("script");
              
              Array.from(oldScriptEl.attributes).forEach( attr => {
                newScriptEl.setAttribute(attr.name, attr.value) 
              });
              
              const scriptText = document.createTextNode(oldScriptEl.innerHTML);
              newScriptEl.appendChild(scriptText);
              
              oldScriptEl.parentNode.replaceChild(newScriptEl, oldScriptEl);
            });
        }   
   
        

        uilc.AppendScript = async (args, env) => {
            const data = await interpretate(args[0], env);
            const script = document.createElement('script');
            script.textContent = data;
            document.body.appendChild(script);
        }

        core['CoffeeLiqueur`WLX`WebUI`Private`UILazyContainer'] = uilc;

        const uill = async (args, env) => {
            const type = await interpretate(args[0], env);
            await uill[type](args.slice(1), env);
        }

        uill.Load = async (args, env) => {
            const uid = await interpretate(args[0], env);
            const data = await interpretate(args[1], env);
            setInnerHTML(document.getElementById(uid), data);
        }

        uill.Hide = async (args, env) => {
            const uid = await interpretate(args[0], env);
            document.getElementById(uid).classList.add("hidden");
        } 

        uill.Remove = async (args, env) => {
            const uid = await interpretate(args[0], env);
            document.getElementById(uid).innerHTML = "";
            document.getElementById(uid).classList.remove("hidden");
        }         

        uill.Show = async (args, env) => {
            const uid = await interpretate(args[0], env);
            document.getElementById(uid).classList.remove("hidden");
        }     

        core['CoffeeLiqueur`WLX`WebUI`Private`UILazyLoad'] = uill;

        const uiled = async (args, env) => {
            const uid = await interpretate(args[0], env);
            const type = await interpretate(args[1], env);
            
            if (!uiled[uid]) {
                console.warn(`Event listener ${uid} does not exist`);
                return;
            }
            uiled[uid](type, args[2], env);
        }  

        window.UIJSScript = class {
            event = undefined;
            listeners = {};
            constructor(opts) {
                this.event = opts.uid
                const self = this;
                uiled[this.event] = function (type, data, env) {
                    if (type in self.listeners) {
                        self.listeners[type](data, env);
                    } else {
                        console.warn(`Pattern ${type} does not exist. Ignoring...`);
                    }
                };

                const scoped = opts.target.bind(self);
                scoped();
            }

            on(type, handler) {
                this.listeners[type] = handler;
            }
        }  
    
        core['CoffeeLiqueur`WLX`WebUI`Private`UILazyEventDispatch'] = uiled;

    </script>
];

{
    WebUILazyLoad, 
    WebUISubmit, 
    WebUILocation, 
    WebUIClose, 
    WebUIRefresh, 
    WebUIContainer, 
    WebUIJSBind, 
    WebUIOnLoad, 
    WebUIEventListener, 
    WebUIKeyListener, 
    WebUIFetch, 
    WebUIInitializationScript
}
